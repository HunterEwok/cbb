#
# A published release reaches the mirror within the hour; a run with
# nothing new downloads only keys.json and stable.json.

[Unit]
Description=Mirror the cbb releases every hour

[Timer]
OnCalendar=hourly
Persistent=true
RandomizedDelaySec=10min

[Install]
WantedBy=timers.target
