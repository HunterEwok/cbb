#
# stable.json lives 14 days; renewed twice a week, so it has at least 10
# days left between runs, and a missed run still leaves time before the
# channel workflow's reminder and the monitor's alarm at 5 days.

[Unit]
Description=Renew the cbb release channel twice a week

[Timer]
OnCalendar=Mon,Thu *-*-* 05:00:00 UTC
Persistent=true
RandomizedDelaySec=1h

[Install]
WantedBy=timers.target
