[Desktop Entry]
Type=Application
Name=Clipboard Bridge
Comment=The Clipboard Bridge tray item, which opens its window
Exec=/usr/local/bin/cbb-desktop
Icon=/usr/local/share/clipboardbridge/clipboardbridge.png
NoDisplay=true
X-GNOME-Autostart-enabled=true
