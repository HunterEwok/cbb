# cbb-push, the project's push service on cbb.tools (format section 20.4): it passes
# sealed bodies from the members of a group to a phone's platform (APNs, FCM, UnifiedPush),
# to wake an app that is closed. It holds no group's keys and keeps on disk only its
# own TLS key and its state (push.state and push.state.log: the tokens' bindings to
# their send keys, under keyed hashes, no token and no address); the platforms' keys
# are given to it read-only, and no log names a token, a group or an address. On the
# very first start add -new-state to CBB_PUSH_FLAGS, and take it out again: without
# it a missing state file stops the start, so a lost file is never a silent reset.
[Unit]
Description=CBB push service
Documentation=https://github.com/HunterEwok/cbb/blob/main/docs/admin/self-hosting.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# The platforms' keys: /etc/cbb/push/apns.p8, apns-sandbox.p8 and fcm.json (the Firebase
# project's service account; root:root 0600,
# given to the service by systemd's credentials, never readable by its user
# otherwise), and in /etc/cbb/push.env
# CBB_PUSH_FLAGS="-apns-team TEAM -apns-key-id KEYID -apns-sandbox-key-id KEYID".
Environment=CBB_PUSH_FLAGS=
EnvironmentFile=-/etc/cbb/push.env
LoadCredential=apns.p8:/etc/cbb/push/apns.p8
LoadCredential=apns-sandbox.p8:/etc/cbb/push/apns-sandbox.p8
LoadCredential=fcm.json:/etc/cbb/push/fcm.json
ExecStart=/usr/local/bin/cbb-push -apns-key ${CREDENTIALS_DIRECTORY}/apns.p8 -apns-sandbox-key ${CREDENTIALS_DIRECTORY}/apns-sandbox.p8 -fcm-account ${CREDENTIALS_DIRECTORY}/fcm.json $CBB_PUSH_FLAGS
DynamicUser=yes
StateDirectory=cbb-push
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=2s

# It needs no privileges: it listens on port 8767.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
DevicePolicy=closed
PrivateUsers=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RemoveIPC=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM
MemorySwapMax=0
# No accounting of the addresses it talks to.
IPAccounting=no

[Install]
WantedBy=multi-user.target
