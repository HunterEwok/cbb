# Before apk removes the package (feed.sh): the service stops, and with it
# its firewall rules. The keys in /etc/cbb and the user stay;
# rm -r /etc/cbb removes the keys.
if [ -x /etc/init.d/cbb ]; then
	/etc/init.d/cbb stop >/dev/null 2>&1
	/etc/init.d/cbb disable >/dev/null 2>&1
	/etc/init.d/firewall reload >/dev/null 2>&1
fi
rm -rf /etc/cbb-update /tmp/cbb-update
exit 0
