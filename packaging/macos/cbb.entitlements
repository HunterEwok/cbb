<!-- What cbb asks of the hardened runtime (sign.sh). The group's rules come
     from the Rust core, which wazero compiles to machine code at run time: it
     maps memory writable, writes the code and makes it executable, without
     MAP_JIT. Under the hardened runtime that takes
     allow-unsigned-executable-memory; without it macOS kills cbb (SIGKILL)
     the first time it loads the core. Nothing else is granted. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
</dict>
</plist>
