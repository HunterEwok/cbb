---- MODULE P_settlerCut ----
\* Generated by gen_ps.py: settlerKeepsWhatChangeCutsTest, first 8 steps, then every history of 3 free steps.
EXTENDS RecordsCore

QSIGNERS == {"R", "A", "C", "C2", "W", "NA", "NK", "X"}
QROOT_KEYS == {"R", "NA", "NK"}
QTHIEVES == {"A", "C", "C2", "W", "X"}
QHOLDER == [k \in {"R", "A", "NA", "X", "C", "C2", "W", "K", "NK", "NB"} |->
    CASE k = "R" -> "r" [] k \in {"A", "NA", "X"} -> "a" [] k \in {"C", "C2", "W"} -> "c" [] k \in {"K", "NK", "NB"} -> "k"]
QMEMBERS == {"r", "a", "c", "k", "m"}
QDEV == [k \in {"A", "C", "C2", "W", "X", "NA"} |->
    CASE k = "A" -> "dA" [] k \in {"C", "C2"} -> "dC" [] k = "W" -> "dW" [] k = "X" -> "dX" [] k = "NA" -> "dN"]
QSTART == [i \in 1..3 |-> Rec(i, "R", [j \in 1..i |-> j], "admin", <<"A", "C", "W">>[i], <<"phone", "computer", "watch">>[i],
                              0, EmptyFn, EmptyFn, {}, 1)]

BENT == FALSE

FOPS == {
    <<"R", "device", "D", "", 1>>, <<"R", "revoke", "D", "", 1>>, <<"R", "revoke", "A", "", 1>>,
    <<"R", "copies", "", "", 1>>, <<"R", "checkpoint", "", "", 2>>,
    <<"A", "device", "D", "", 1>>, <<"A", "revoke", "D", "", 1>>, <<"A", "copies", "", "", 1>>,
    <<"NA", "device", "D", "", 1>>, <<"NA", "revoke", "D", "", 1>>, <<"NA", "copies", "", "", 1>>,
    <<"NA", "checkpoint", "", "", 2>>,
    <<"NK", "device", "D", "", 1>>, <<"NK", "revoke", "D", "", 1>>, <<"NK", "copies", "", "", 1>>,
    <<"NK", "checkpoint", "", "", 2>>}
Free ==
    \/ \E o \in FOPS : Sign(o[1], o[2], o[3], o[4], 0, FALSE, FALSE, o[5])
    \/ SignFull("R", "copies", "", "", 0, FALSE, TRUE, 1, TRUE, {})
    \/ \E t \in {"NA", "NK"} : SignChangeG(t, "honest")
    \/ \E m \in MEMBERS, i \in DOMAIN db : Deliver(m, i)
    \/ \E m \in MEMBERS : views[m].checkpoint # st[m].checkpoint /\ CompactAt(m)
    \/ \E m \in MEMBERS : Restart(m)
    \/ \E m \in MEMBERS : RestartSaved(m)

VARIABLE pc
PInit == Init /\ pc = 1
PNext ==
    \/ (pc = 1 /\ OfferEveryone(1) /\ pc' = 2)
    \/ (pc = 2 /\ RecoverAs("K", "NK") /\ pc' = 3)
    \/ (pc = 3 /\ SyncRound /\ pc' = 4)
    \/ (pc = 4 /\ SignCheckpointKeep("NK", {4}, "A", 1) /\ pc' = 5)
    \/ (pc = 5 /\ SyncRound /\ pc' = 6)
    \/ (pc = 6 /\ RecoverAs("K", "NA") /\ pc' = 7)
    \/ (pc = 7 /\ Restart("r") /\ pc' = 8)
    \/ (pc = 8 /\ GiveOnly("a", 7) /\ pc' = 9)
    \/ (pc = 9 /\ TLCGet("level") < 12 /\ Free /\ UNCHANGED pc)
Started == pc = 9
BoundK == TLCGet("level") <= 12
Inv == Started => (PromisesFast /\ RootPairHalts /\ RecoveryLive /\ SavedStable /\ FuncOfHeld /\ Confluent)
P_PromisesCheap == Started => PFParts.PromisesCheap
P_oneState == Started => PFParts.oneState
P_converges == Started => PFParts.converges
P_convergesHonest == Started => PFParts.convergesHonest
P_removedStayOut == Started => PFParts.removedStayOut
P_oneChainOneState == Started => PFParts.oneChainOneState
P_fairRoom == Started => PFParts.fairRoom
P_compactedAgree == Started => PFParts.compactedAgree
P_honestNeverDropped == Started => PFParts.honestNeverDropped
P_honestNoMarks == Started => PFParts.honestNoMarks
P_deviceStays == Started => PFParts.deviceStays
P_LReissueW == Started => PFParts.LReissueW
P_LNoOldRevive == Started => PFParts.LNoOldRevive
P_removedStayOutAdm == Started => PFParts.removedStayOutAdm
P_SpareFresh == Started => PFParts.SpareFresh
P_LReissuePrice == Started => PFParts.LReissuePrice
P_noLiveOld == Started => PFParts.noLiveOld
J1 == Started => RootPairHalts
J2 == Started => RecoveryLive
J3 == Started => SavedStable
J4 == Started => FuncOfHeld
J5 == Started => Confluent
PathGrowsP == [][\A m \in MEMBERS : IsPrefix(views[m].path, views'[m].path) \/ ChainState(st'[m], db').stop]_<<vars, pc>>
