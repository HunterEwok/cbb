[Desktop Entry]
Type=Application
X-Nemo-Application-Type=silica-qt5
Icon=harbour-cbb
Exec=harbour-cbb
Name=CBB
X-Share-Methods=text;files

[X-Sailjail]
Permissions=Internet;Camera;UserDirs
OrganizationName=tools.cbb
ApplicationName=cbb

[X-Share Method text]
Description=Send to the group
Capabilities=text/plain
SupportsMultipleFiles=no

[X-Share Method files]
Description=Send to the group
Capabilities=image/*;video/*;audio/*;application/*;text/*
SupportsMultipleFiles=yes
