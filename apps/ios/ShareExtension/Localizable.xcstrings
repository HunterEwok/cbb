{
  "sourceLanguage": "en",
  "strings": {
    "CBB sends it to your devices the next time you open it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيرسله CBB إلى أجهزتك في المرة القادمة التي تفتحه فيها."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "CBB lo enviará a tus dispositivos la próxima vez que lo abras."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "CBB ישלח את זה למכשירים שלכם בפעם הבאה שתפתחו אותו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अगली बार जब आप CBB खोलेंगे, यह इसे आपके डिवाइसों पर भेज देगा।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "CBB отправит это на ваши устройства, когда вы в следующий раз его откроете."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "CBB itakituma kwenye vifaa vyako utakapoifungua tena."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下次打开 CBB 时，它会把这些内容发送到你的设备。"
          }
        }
      }
    },
    "Done": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hecho"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סיום"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हो गया"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Готово"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Imekamilika"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完成"
          }
        }
      }
    },
    "Sending failed.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فشل الإرسال."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo enviar."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השליחה נכשלה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "भेजना विफल रहा।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправить не удалось."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kutuma kumeshindwa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发送失败。"
          }
        }
      }
    },
    "There is no text to send.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد نص للإرسال."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay texto que enviar."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין טקסט לשליחה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "भेजने के लिए कोई टेक्स्ट नहीं है।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нечего отправлять: нет текста."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hakuna maandishi ya kutuma."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有要发送的文本。"
          }
        }
      }
    },
    "This phone is in no group yet: open CBB to make one or join one.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الهاتف ليس في أي مجموعة بعد: افتح CBB لإنشاء مجموعة أو الانضمام إليها."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este teléfono aún no está en ningún grupo: abre CBB para crear uno o unirte a uno."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הטלפון הזה עדיין לא בשום קבוצה: פתחו את CBB כדי ליצור קבוצה או להצטרף לאחת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह फ़ोन अभी किसी समूह में नहीं है: समूह बनाने या उससे जुड़ने के लिए CBB खोलें।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот телефон ещё не в группе: откройте CBB, чтобы создать группу или вступить в неё."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Simu hii bado haiko kwenye kikundi chochote: fungua CBB ili kuunda au kujiunga na kikundi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这部手机还不在任何群组中：打开 CBB 创建或加入群组。"
          }
        }
      }
    },
    "What you shared is larger than 50 MB, more than Share can carry. Send less at a time.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما شاركته أكبر من 50 ميغابايت، أكثر مما تستطيع المشاركة حمله. أرسل أقل في كل مرة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que compartiste ocupa más de 50 MB, más de lo que Compartir puede llevar. Envía menos cada vez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מה ששיתפתם גדול מ-50MB, יותר ממה ששיתוף יכול לשאת. שלחו פחות בכל פעם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपने जो साझा किया वह 50 MB से बड़ा है, साझा करें जितना ले जा सकता है उससे ज़्यादा। एक बार में कम भेजें।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это больше 50 МБ, столько «Поделиться» не унесёт. Отправьте меньше за раз."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ulichoshiriki ni kikubwa kuliko MB 50, zaidi ya kile Shiriki inachoweza kubeba. Tuma kidogo kwa wakati mmoja."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你分享的内容超过 50 MB，超出了“分享”能携带的大小。请每次少发送一些。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
