<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyLists-1.0.dtd">
<!-- SPDX-License-Identifier: AGPL-3.0-only -->
<!-- The app and its share extension share the group's file (the app group) and this phone's
     member key (the first keychain access group, where new keys go); the push keys go to the
     second, which the notification extension shares and nothing else (App/PushSetup.swift);
     push comes through APNs; NFC reads a YubiKey (App/YubiKeyNfc.swift). Release builds only:
     they need the Apple developer account; debug builds signed ad hoc go without. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.tools.cbb</string>
	</array>
	<key>aps-environment</key>
	<string>production</string>
	<key>com.apple.developer.nfc.readersession.formats</key>
	<array>
		<string>TAG</string>
	</array>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)tools.cbb.shared</string>
		<string>$(AppIdentifierPrefix)tools.cbb.push</string>
	</array>
</dict>
</plist>
