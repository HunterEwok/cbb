<!-- NFC alone, for a debug build on a device: device.sh with CBB_NFC=1, for a team whose
     profile may carry it. -->
<plist version="1.0">
<dict>
	<key>com.apple.developer.nfc.readersession.formats</key>
	<array>
		<string>TAG</string>
	</array>
</dict>
</plist>
