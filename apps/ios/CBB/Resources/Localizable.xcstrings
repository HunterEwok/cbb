            "value": "מחוץ לבית: דרך הרכזת שלכם"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "घर से बाहर: आपके हब से होकर"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вне дома: через ваш хаб"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Mbali na nyumbani: kupitia kitovu chako"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "离家：经由你的中心节点"
          }
        }
      }
