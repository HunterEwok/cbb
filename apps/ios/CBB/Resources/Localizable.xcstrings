            "state": "translated",
            "value": "Bandika kwenye %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 %@ 上粘贴"
          }
        }
      }
    },
    "Paste on a device": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لصق على جهاز"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pegar en un dispositivo"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הדבקה במכשיר"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी डिवाइस पर पेस्ट करें"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вставить на устройстве"
          }
        },
        "sw": {
          "stringUnit": {
