    "Save a forwarder above first: away from home, the devices reach the new hub through it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احفظ مُعيد توجيه أعلاه أولًا: بعيدًا عن المنزل، تصل الأجهزة إلى المحور الجديد عبره."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero guarda un reenviador arriba: fuera de casa, los dispositivos llegan al hub nuevo a través de él."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שמרו קודם מעביר למעלה: מחוץ לבית, המכשירים מגיעים דרכו לרכזת החדשה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहले ऊपर एक फ़ॉरवर्डर सहेजें: घर से दूर, डिवाइस उसके ज़रिए नए हब तक पहुँचते हैं।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала сохраните форвардер выше: вне дома устройства находят новый хаб через него."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hifadhi kisambazaji hapo juu kwanza: ukiwa mbali na nyumbani, vifaa hufikia kitovu kipya kupitia kisambazaji hicho."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先在上方保存一个转发器：离家时，设备通过它连接到新的中心节点。"
          }
        }
      }
    },
