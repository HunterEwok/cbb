    "No phone scanned the code in five minutes. Try again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يمسح أي هاتف الرمز خلال خمس دقائق. حاول مرة أخرى."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ningún teléfono escaneó el código en cinco minutos. Vuelve a intentarlo."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אף טלפון לא סרק את הקוד בתוך חמש דקות. נסו שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पाँच मिनट में किसी फ़ोन ने कोड स्कैन नहीं किया। दोबारा कोशिश करें।"
          }
        },
        "ru": {
          "stringUnit": {
