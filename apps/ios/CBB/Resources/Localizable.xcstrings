    "Waiting for the app: the hub works while the app is open.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في انتظار التطبيق: يعمل المحور ما دام التطبيق مفتوحًا."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esperando a la app: el hub funciona mientras la app está abierta."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ממתין ליישום: הרכזת עובדת כל עוד היישום פתוח."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐप का इंतज़ार: ऐप खुला रहने तक हब काम करता है।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ждём приложение: хаб работает, пока приложение открыто."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Inasubiri programu: kitovu hufanya kazi wakati programu iko wazi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "等待应用：应用打开时中心节点才工作。"
          }
        }
      }
    },
    "Waiting for the app: the relay works while the app is open.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في انتظار التطبيق: يعمل المُرحِّل ما دام التطبيق مفتوحًا."
          }
        },
        "es": {
          "stringUnit": {
