            "state": "translated",
            "value": "कॉपी"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Копии"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Nakala"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "副本"
          }
        }
      }
    },
    "Copy lifetime": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مدة بقاء النسخة"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Duración de una copia"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "משך חיי העתקה"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कॉपी की अवधि"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Время жизни копии"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Muda wa nakala"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "副本保留时长"
          }
        }
      }
    },
    "Copy something, open CBB, and it goes to your other devices. In Settings, CBB, set Paste from Other Apps to Allow, so that iOS does not ask each time.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انسخ شيئًا وافتح CBB فيذهب إلى أجهزتك الأخرى. في الإعدادات، CBB، اضبط «اللصق من التطبيقات الأخرى» على «سماح» حتى لا يسأل iOS في كل مرة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia algo, abre CBB y llegará a tus otros dispositivos. En Ajustes, CBB, pon Pegar desde otras apps en Permitir, para que iOS no pregunte cada vez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "העתיקו משהו, פתחו את CBB, והוא יעבור למכשירים האחרים שלכם. בהגדרות, CBB, הגדירו את ״הדבקה מיישומים אחרים״ ל״אפשר״, כדי ש-iOS לא ישאל בכל פעם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुछ कॉपी करें, CBB खोलें, और वह आपके दूसरे डिवाइसों पर पहुँच जाएगा। सेटिंग्स, CBB में, दूसरे ऐप्स से पेस्ट को अनुमति दें पर सेट करें, ताकि iOS हर बार न पूछे।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скопируйте что-нибудь, откройте CBB — и оно уйдёт на другие устройства. В Настройках → CBB выберите «Вставка из других приложений: Разрешить», чтобы iOS не спрашивала каждый раз."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Nakili kitu, fungua CBB, nacho kitaenda kwenye vifaa vyako vingine. Katika Mipangilio, CBB, weka Bandika kutoka Programu Nyingine kuwa Ruhusu, ili iOS isiulize kila mara."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "复制内容后打开 CBB，它就会发到你的其他设备。在“设置”>“CBB”中把“从其他 App 粘贴”设为“允许”，这样 iOS 就不会每次询问。"
          }
        }
      }
    },
    "Could not get the image from the computers. Copy it there again, then try again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر جلب الصورة من الحواسيب. انسخها هناك مجددًا، ثم حاول مرة أخرى."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo obtener la imagen de los ordenadores. Cópiala allí de nuevo y vuelve a intentarlo."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן היה לקבל את התמונה מהמחשבים. העתיקו אותה שם שוב ונסו שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कंप्यूटरों से चित्र नहीं मिल सका। उसे वहाँ फिर से कॉपी करें, फिर दोबारा कोशिश करें।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось получить картинку с компьютеров. Скопируйте её там ещё раз и повторите."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Haikuweza kupata picha kutoka kwa kompyuta. Inakili huko tena, kisha ujaribu tena."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法从电脑获取图片。请在那边重新复制，然后重试。"
          }
        }
      }
    },
    "Could not make the PDF.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر إنشاء ملف PDF."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo crear el PDF."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן היה ליצור את קובץ ה-PDF."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF नहीं बन सका।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось сделать PDF."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Haikuweza kutengeneza PDF."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法生成 PDF。"
          }
        }
      }
    },
    "Could not reach the computer. Is it on the same network as this phone, and does its firewall let CBB in?": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر الوصول إلى الحاسوب. هل هو على الشبكة نفسها التي عليها هذا الهاتف، وهل يسمح جداره الناري لـCBB؟"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo llegar al ordenador. ¿Está en la misma red que este teléfono y su cortafuegos deja pasar a CBB?"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן היה להגיע למחשב. האם הוא באותה רשת כמו הטלפון הזה, והאם חומת האש שלו מאפשרת ל-CBB להיכנס?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कंप्यूटर तक नहीं पहुँच सका। क्या वह इस फ़ोन वाले नेटवर्क पर है, और क्या उसका फ़ायरवॉल CBB को आने देता है?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось связаться с компьютером. Он в той же сети, что и телефон, и пропускает ли его файрвол CBB?"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Haikuweza kufikia kompyuta. Je, iko kwenye mtandao mmoja na simu hii, na ngome yake inaruhusu CBB?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法连接到电脑。它是否与这部手机在同一网络，防火墙是否允许 CBB？"
          }
        }
      }
    },
    "Could not read the clipboard, so it was left as it is. Allow pasting for CBB, or copy the text again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّرت قراءة الحافظة، فتُركت كما هي. اسمح لـCBB باللصق، أو انسخ النص مجددًا."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer el portapapeles, así que se dejó como estaba. Permite pegar a CBB o vuelve a copiar el texto."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן היה לקרוא את הלוח, ולכן הוא נשאר כפי שהיה. אפשרו הדבקה ל-CBB, או העתיקו את הטקסט שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्लिपबोर्ड पढ़ा नहीं जा सका, इसलिए उसे वैसा ही छोड़ दिया गया। CBB को पेस्ट करने दें, या टेक्स्ट फिर से कॉपी करें।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось прочитать буфер обмена, поэтому он оставлен как есть. Разрешите CBB вставку или скопируйте текст ещё раз."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Haikuweza kusoma ubao wa kunakili, kwa hivyo uliachwa kama ulivyo. Ruhusu CBB kubandika, au nakili maandishi tena."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取剪贴板，所以保持原样。请允许 CBB 粘贴，或重新复制文本。"
          }
        }
      }
    },
    "Create a group": {
