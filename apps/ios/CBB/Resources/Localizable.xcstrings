            "state": "translated",
            "value": "Uwashe Kila mahali?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启“随处”？"
          }
        }
      }
    },
    "Turn all off": {
      "localizations": {
