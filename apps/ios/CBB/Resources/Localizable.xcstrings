    },
    "For networks that block VPNs or let only the web through; the second needs a connection server that takes VLESS.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "للشبكات التي تحجب VPN أو لا تسمح إلا بالويب؛ والثانية تحتاج إلى خادم اتصال يقبل VLESS."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para redes que bloquean las VPN o solo dejan pasar la web; lo segundo necesita un servidor de conexión que acepte VLESS."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לרשתות שחוסמות VPN או מעבירות רק תעבורת אינטרנט; האפשרות השנייה דורשת שרת חיבור שמקבל VLESS."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN रोकने वाले या केवल वेब चलने देने वाले नेटवर्क के लिए; दूसरे के लिए VLESS लेने वाला कनेक्शन सर्वर चाहिए।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для сетей, которые блокируют VPN или пропускают только веб; для второго нужен сервер связи, который принимает VLESS."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kwa mitandao inayozuia VPN au inayoruhusu wavuti pekee; la pili linahitaji seva ya muunganisho inayokubali VLESS."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于屏蔽 VPN 或只允许网页通行的网络；后者需要支持 VLESS 的连接服务器。"
          }
        }
      }
    },
    "Forwarder address, such as 198.51.100.9:8764": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عنوان مُعيد التوجيه، مثل 198.51.100.9:8764"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dirección del reenviador, como 198.51.100.9:8764"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כתובת המעביר, כמו 198.51.100.9:8764"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ॉरवर्डर का पता, जैसे 198.51.100.9:8764"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Адрес форвардера, например 198.51.100.9:8764"
          }
        },
        "sw": {
