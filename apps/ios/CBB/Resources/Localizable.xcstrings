    "Copies": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "النسخ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copias"
          }
        },
        "he": {
