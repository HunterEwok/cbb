    "Hold the YubiKey": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قرّب YubiKey"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acerca la YubiKey"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הצמידו את ה-YubiKey"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "YubiKey लगाएँ"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложить YubiKey"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Shikilia YubiKey"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "贴近 YubiKey"
          }
        }
      }
    },
    "Hold the YubiKey again to sign the claim.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قرّب YubiKey مرة أخرى لتوقيع المطالبة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acerca de nuevo la YubiKey para firmar la reclamación."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הצמידו שוב את ה-YubiKey כדי לחתום על התביעה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दावे पर हस्ताक्षर के लिए YubiKey फिर लगाएँ।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложите YubiKey ещё раз, чтобы подписать заявку."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Shikilia YubiKey tena ili kutia sahihi dai."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "再次贴近 YubiKey 以签署声明。"
          }
        }
      }
    },
    "Hold the YubiKey to the top of the phone.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قرّب YubiKey من أعلى الهاتف."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acerca la YubiKey a la parte superior del teléfono."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הצמידו את ה-YubiKey לחלק העליון של הטלפון."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "YubiKey को फ़ोन के ऊपरी हिस्से से लगाएँ।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложите YubiKey к верхней части телефона."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Shikilia YubiKey juu ya simu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将 YubiKey 贴近手机顶部。"
          }
        }
      }
    },
    "Hold the YubiKey with the recovery key to the top of the phone.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قرّب YubiKey الذي يحمل مفتاح الاسترداد من أعلى الهاتف."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acerca la YubiKey con la clave de recuperación a la parte superior del teléfono."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הצמידו את ה-YubiKey עם מפתח השחזור לחלק העליון של הטלפון."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिकवरी कुंजी वाली YubiKey को फ़ोन के ऊपरी हिस्से से लगाएँ।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложите YubiKey с ключом восстановления к верхней части телефона."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Shikilia YubiKey yenye ufunguo wa urejeshaji juu ya simu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将带有恢复密钥的 YubiKey 贴近手机顶部。"
          }
        }
      }
    },
    "How long a copy from another device goes into the clipboard after it arrives.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المدة التي تدخل فيها نسخة من جهاز آخر إلى الحافظة بعد وصولها."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuánto tiempo una copia de otro dispositivo entra en el portapapeles después de llegar."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כמה זמן העתקה ממכשיר אחר נכנסת ללוח אחרי שהיא מגיעה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दूसरे डिवाइस की कॉपी पहुँचने के बाद कितनी देर तक क्लिपबोर्ड में जाती है।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сколько времени копия с другого устройства попадает в буфер после прихода."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Muda ambao nakala kutoka kifaa kingine huingia kwenye ubao wa kunakili baada ya kufika."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "来自其他设备的副本到达后，在多长时间内写入剪贴板。"
          }
        }
      }
    },
    "How long a copy from another device goes into the clipboard after it arrives. After that each device keeps what it copied itself, however old.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المدة التي تدخل فيها نسخة من جهاز آخر إلى الحافظة بعد وصولها. بعد ذلك يحتفظ كل جهاز بما نسخه بنفسه، مهما كان قديمًا."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuánto tiempo una copia de otro dispositivo entra en el portapapeles después de llegar. Después, cada dispositivo conserva lo que copió él mismo, por antiguo que sea."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כמה זמן העתקה ממכשיר אחר נכנסת ללוח אחרי שהיא מגיעה. אחרי זה כל מכשיר שומר את מה שהוא עצמו העתיק, ישן ככל שיהיה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दूसरे डिवाइस की कॉपी पहुँचने के बाद कितनी देर तक क्लिपबोर्ड में जाती है। उसके बाद हर डिवाइस वही रखता है जो उसने खुद कॉपी किया, चाहे कितना भी पुराना हो।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сколько времени после прихода копия с другого устройства попадает в буфер. Потом каждое устройство оставляет то, что скопировало само, как бы давно это ни было."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Muda ambao nakala kutoka kifaa kingine huingia kwenye ubao wa kunakili baada ya kufika. Baada ya hapo kila kifaa huhifadhi kile kilichojinakilia, hata kiwe cha zamani kiasi gani."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "来自其他设备的副本到达后，在多长时间内写入剪贴板。之后每台设备保留它自己复制的内容，无论多旧。"
          }
        }
      }
    },
