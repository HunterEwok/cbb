    "Renamed. The other devices show the new name as soon as they hear of it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تمت إعادة التسمية. تعرض الأجهزة الأخرى الاسم الجديد بمجرد علمها به."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Renombrado. Los demás dispositivos muestran el nombre nuevo en cuanto se enteran."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השם שונה. המכשירים האחרים מציגים את השם החדש ברגע שהם שומעים עליו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नाम बदला गया। बाकी डिवाइस पता चलते ही नया नाम दिखाते हैं।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переименовано. Остальные устройства покажут новое имя, как только узнают о нём."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Jina limebadilishwa. Vifaa vingine vinaonyesha jina jipya mara tu vinapolisikia."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已重命名。其他设备一得知就会显示新名称。"
          }
        }
      }
    },
