    "Reached from afar through the project's forwarder at cbb.tools. To use your own, enter its address and key.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن الوصول إليه من بعيد عبر مُعيد التوجيه الخاص بالمشروع على cbb.tools. لاستخدام مُعيد توجيهك، أدخل عنوانه ومفتاحه."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Accesible desde lejos a través del reenviador del proyecto en cbb.tools. Para usar el tuyo, introduce su dirección y su clave."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נגיש מרחוק דרך המעביר של הפרויקט ב-cbb.tools. כדי להשתמש במעביר משלכם, הזינו את הכתובת והמפתח שלו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "cbb.tools पर प्रोजेक्ट के फ़ॉरवर्डर के ज़रिए दूर से पहुँचा जाता है। अपना इस्तेमाल करने के लिए, उसका पता और कुंजी डालें।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Издалека хаб доступен через форвардер проекта на cbb.tools. Чтобы использовать свой, введите его адрес и ключ."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hufikiwa kutoka mbali kupitia kisambazaji cha mradi kwenye cbb.tools. Ili kutumia chako, weka anwani na ufunguo wake."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过项目在 cbb.tools 的转发器从远方访问。要使用你自己的转发器，请输入它的地址和密钥。"
          }
        }
      }
    },
