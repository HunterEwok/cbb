          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आर्ट डेको"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ар-деко"
          }
        },
        "sw": {
          "stringUnit": {
