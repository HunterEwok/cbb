    "Removed. The other devices refuse it from now on.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أُزيل. ترفضه الأجهزة الأخرى من الآن فصاعدًا."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quitado. Los demás dispositivos lo rechazan a partir de ahora."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הוסר. המכשירים האחרים דוחים אותו מעכשיו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हटाया गया। अब से बाकी डिवाइस इसे ठुकराते हैं।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалено. Остальные устройства больше его не принимают."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimeondolewa. Vifaa vingine vinakikataa kuanzia sasa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已移除。从现在起其他设备会拒绝它。"
          }
        }
      }
    },
