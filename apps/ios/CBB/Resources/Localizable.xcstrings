    "Leave the group on this device, then join again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "غادر المجموعة على هذا الجهاز ثم انضم مجددًا."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sal del grupo en este dispositivo y vuelve a unirte."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "צאו מהקבוצה במכשיר הזה והצטרפו שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस डिवाइस पर समूह छोड़ें, फिर दोबारा शामिल हों।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выйдите из группы на этом устройстве и вступите снова."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ondoka kwenye kikundi kwenye kifaa hiki, kisha ujiunge tena."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在此设备上退出群组，然后重新加入。"
          }
        }
      }
    },
