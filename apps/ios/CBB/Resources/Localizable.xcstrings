    "Invite a device from afar": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "دعوة جهاز بعيد"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Invitar a un dispositivo lejano"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הזמנת מכשיר מרחוק"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दूर के डिवाइस को आमंत्रित करें"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
