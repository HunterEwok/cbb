            "value": "装饰艺术"
          }
        }
      }
    },
    "Ask the group's owner to restore its rights.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اطلب من مالك المجموعة إعادة صلاحياته."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pide al propietario del grupo que le devuelva sus derechos."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בקשו מהבעלים של הקבוצה להחזיר לו את ההרשאות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समूह के स्वामी से इसके अधिकार लौटाने को कहें।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Попросите владельца группы вернуть ему права."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Omba mmiliki wa kikundi arejeshe haki zake."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请群组的所有者恢复它的权限。"
          }
        }
      }
    },
    "At home: syncing directly.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في المنزل: مزامنة مباشرة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En casa: sincronizando directamente."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בבית: מסנכרן ישירות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "घर पर: सीधे सिंक हो रहा है।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дома: синхронизация напрямую."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyumbani: inasawazisha moja kwa moja."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在家：直接同步。"
          }
        }
      }
    },
    "At the relay with %lld devices of the group.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند المُرحِّل مع %lld من أجهزة المجموعة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En el relé con %lld dispositivos del grupo."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בממסר עם %lld מכשירים של הקבוצה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिले पर समूह के %lld डिवाइसों के साथ।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На релее, устройств группы там: %lld."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kwenye relei pamoja na vifaa %lld vya kikundi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在中继处，与群组的 %lld 台设备在一起。"
          }
        }
      }
    },
    "At the relay: no other device of the group is there now.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند المُرحِّل: لا يوجد جهاز آخر من المجموعة هناك الآن."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En el relé: ahora no hay ningún otro dispositivo del grupo."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בממסר: אין שם עכשיו מכשיר אחר של הקבוצה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिले पर: अभी समूह का कोई दूसरा डिवाइस वहाँ नहीं है।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На релее: других устройств группы там сейчас нет."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kwenye relei: hakuna kifaa kingine cha kikundi hapo sasa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在中继处：现在没有群组的其他设备。"
          }
        }
      }
    },
    "Away from home": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خارج المنزل"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fuera de casa"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מחוץ לבית"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "घर से बाहर"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вне дома"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Mbali na nyumbani"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "离家"
          }
        }
      }
    },
    "Away from home: hub": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خارج المنزل: محور"
          }
        },
        "es": {
