    "Change a computer's sync mode": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغيير وضع مزامنة حاسوب"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambiar el modo de sincronización de un ordenador"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שינוי מצב הסנכרון של מחשב"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी कंप्यूटर का सिंक मोड बदलें"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изменить режим синхронизации компьютера"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Badilisha hali ya usawazishaji ya kompyuta"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更改电脑的同步模式"
          }
        }
      }
    },
    "Change how long a copy from another device lasts": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغيير مدة بقاء النسخة من جهاز آخر"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambiar cuánto dura una copia de otro dispositivo"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שינוי משך החיים של העתקה ממכשיר אחר"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बदलें कि दूसरे डिवाइस की कॉपी कितनी देर रहे"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изменить, сколько живёт копия с другого устройства"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Badilisha muda ambao nakala kutoka kifaa kingine hudumu"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更改来自其他设备的副本保留多久"
          }
        }
      }
    },
    "Change how the hub's tunnel hides?": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغيير طريقة إخفاء نفق المحور؟"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Cambiar cómo se oculta el túnel del hub?"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לשנות את האופן שבו מנהרת הרכזת מוסתרת?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हब की सुरंग के छिपने का तरीका बदलें?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изменить маскировку туннеля хаба?"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kubadilisha jinsi handaki la kitovu linavyojificha?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更改中心节点隧道的隐藏方式？"
          }
        }
      }
    },
    "Change which keys may be admins": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغيير المفاتيح التي يمكن أن تكون مشرفة"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambiar qué claves pueden ser administradoras"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
