          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接管群组"
          }
        }
      }
    },
    "Take the group over from the lost phone": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تولّي المجموعة من الهاتف المفقود"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tomar el grupo del teléfono perdido"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השתלטות על הקבוצה מהטלפון שאבד"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खोए फ़ोन से समूह अपने हाथ में लें"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Забрать группу у потерянного телефона"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Chukua kikundi kutoka kwa simu iliyopotea"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从丢失的手机接管群组"
          }
        }
      }
    },
    "Take the group the computer handed to this phone": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تولّي المجموعة التي سلّمها الحاسوب إلى هذا الهاتف"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tomar el grupo que el ordenador entregó a este teléfono"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קבלת הקבוצה שהמחשב העביר לטלפון הזה"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वह समूह लें जो कंप्यूटर ने इस फ़ोन को सौंपा"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Взять группу, которую компьютер передал этому телефону"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Chukua kikundi ambacho kompyuta iliikabidhi simu hii"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接管电脑交给这部手机的群组"
          }
        }
      }
    },
    "Taking copies from the group": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتلقى النسخ من المجموعة"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recibe copias del grupo"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מקבל העתקות מהקבוצה"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समूह से कॉपी ले रहा है"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Копии группы принимаются"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Inapokea nakala kutoka kwa kikundi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在接收群组的副本"
          }
        }
      }
    },
    "Tap to take no copies from the group, or to take them again; touch and hold for a time": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط لعدم تلقي نسخ من المجموعة، أو لتلقيها مرة أخرى؛ اضغط مطولًا لمدة محددة"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca para no recibir copias del grupo, o para volver a recibirlas; mantén pulsado para un tiempo"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקישו כדי לא לקבל העתקות מהקבוצה, או כדי לקבל אותן שוב; געו והחזיקו כדי לבחור משך זמן"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समूह से कॉपी न लेने, या फिर से लेने के लिए टैप करें; किसी समय के लिए छूकर दबाए रखें"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите, чтобы не принимать копии группы или снова принимать их; удерживайте, чтобы выбрать время"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Gusa ili usipokee nakala kutoka kwa kikundi, au uzipokee tena; gusa na ushikilie kwa muda fulani"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点可停止接收群组的副本，或重新接收；按住可设置时长"
          }
        }
      }
    },
    "Tap to turn sync off or on; touch and hold for a time": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط لإيقاف المزامنة أو تشغيلها؛ اضغط مطولًا لمدة محددة"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca para desactivar o activar la sincronización; mantén pulsado para un tiempo"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקישו כדי לכבות או להפעיל את הסנכרון; געו והחזיקו כדי לבחור משך זמן"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिंक बंद या चालू करने के लिए टैप करें; किसी समय के लिए छूकर दबाए रखें"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите, чтобы выключить или включить синхронизацию; удерживайте, чтобы выбрать время"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Gusa ili kuzima au kuwasha usawazishaji; gusa na ushikilie kwa muda fulani"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点可关闭或开启同步；按住可设置时长"
          }
        }
      }
    },
