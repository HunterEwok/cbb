          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כוונו את המצלמה לקוד ה-QR של ההזמנה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैमरे को निमंत्रण के QR कोड की ओर करें।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Наведите камеру на QR-код приглашения."
          }
        },
        "sw": {
