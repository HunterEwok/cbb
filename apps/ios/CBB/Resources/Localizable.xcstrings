            "value": "在设备上粘贴"
          }
        }
      }
    },
    "Paste on it…": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لصق عليه…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pegar en él…"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הדבקה בו…"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उस पर पेस्ट करें…"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вставить на нём…"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Bandika kwake…"
          }
        },
        "zh-Hans": {
