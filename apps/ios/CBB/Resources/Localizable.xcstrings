          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השתלטות על הקבוצה"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समूह अपने हाथ में लें"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Взять группу"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
