    "Deletes this phone's keys and the group's data here; the settings stay.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحذف مفاتيح هذا الهاتف وبيانات المجموعة هنا؛ وتبقى الإعدادات."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Borra aquí las claves de este teléfono y los datos del grupo; los ajustes se mantienen."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מוחק כאן את המפתחות של הטלפון הזה ואת נתוני הקבוצה; ההגדרות נשארות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यहाँ इस फ़ोन की कुंजियाँ और समूह का डेटा मिटाता है; सेटिंग्स बनी रहती हैं।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удаляет ключи этого телефона и данные группы на нём, настройки остаются."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hufuta funguo za simu hii na data ya kikundi hapa; mipangilio inabaki."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除这里的本机密钥和群组数据；设置会保留。"
          }
        }
      }
    },
    "Device": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الجهاز"
          }
        },
        "es": {
