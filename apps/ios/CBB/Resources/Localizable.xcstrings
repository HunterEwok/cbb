    "Connect a new device": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "توصيل جهاز جديد"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectar un dispositivo nuevo"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חיבור מכשיר חדש"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नया डिवाइस जोड़ें"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключить новое устройство"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Unganisha kifaa kipya"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接新设备"
          }
        }
      }
    },
    "Connect it at home to a trusted device of the group before then.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قبل ذلك، صِله في المنزل بجهاز موثوق في المجموعة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes de esa fecha, conéctalo en casa a un dispositivo de confianza del grupo."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לפני כן, חברו אותו בבית למכשיר מהימן של הקבוצה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उससे पहले इसे घर पर समूह के किसी भरोसेमंद डिवाइस से जोड़ें।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "До этого подключите его дома к доверенному устройству группы."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kabla ya hapo, kiunganishe nyumbani na kifaa kinachoaminika cha kikundi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在此之前，请在家中将它连接到群组的受信任设备。"
          }
        }
      }
    },
    "Connect this phone to your home Wi-Fi, then try again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صِل هذا الهاتف بشبكة Wi-Fi المنزلية، ثم حاول مجددًا."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecta este teléfono al Wi-Fi de casa y vuelve a intentarlo."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חברו את הטלפון הזה ל-Wi-Fi של הבית ונסו שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस फ़ोन को अपने घर के Wi-Fi से जोड़ें, फिर दोबारा कोशिश करें।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключите телефон к домашнему Wi-Fi и попробуйте снова."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Unganisha simu hii na Wi-Fi ya nyumbani, kisha ujaribu tena."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把这部手机连到家里的 Wi-Fi，然后重试。"
          }
        }
      }
    },
    "Connected to the hub %@ through the tunnel.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "متصل بالمحور %@ عبر النفق."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectado al hub %@ por el túnel."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מחובר לרכזת %@ דרך המנהרה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टनल के ज़रिए हब %@ से जुड़ा।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключено к хабу %@ через туннель."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Imeunganishwa na kitovu %@ kupitia handaki."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已通过隧道连接到中心节点 %@。"
          }
        }
      }
    },
    "Connected to the hub through the tunnel.": {
      "localizations": {
        "ar": {
