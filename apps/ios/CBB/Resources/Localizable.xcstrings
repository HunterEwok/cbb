          }
        }
      }
    },
    "Off": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "متوقف"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivado"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כבוי"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बंद"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выключено"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimezimwa"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关"
          }
        }
      }
    },
    "Off: the globe on Home turns it on.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "متوقف: الكرة الأرضية في الرئيسية تشغّله."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivado: el globo de Inicio lo activa."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כבוי: הגלובוס במסך הבית מפעיל אותו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बंद: होम पर ग्लोब इसे चालू करता है।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выключено: включается глобусом на главном экране."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimezimwa: dunia iliyo Mwanzo hukiwasha."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭：点主页上的地球图标即可开启。"
          }
        }
      }
    },
    "Off: this phone is no hub.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "متوقف: هذا الهاتف ليس محورًا."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivado: este teléfono no es un hub."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כבוי: הטלפון הזה אינו רכזת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बंद: यह फ़ोन हब नहीं है।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выключено: этот телефон не хаб."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimezimwa: simu hii si kitovu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭：这部手机不是中心节点。"
          }
        }
      }
    },
    "Off: this phone meets nobody at a relay.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "متوقف: لا يلتقي هذا الهاتف بأحد عند مُرحِّل."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivado: este teléfono no se encuentra con nadie en un relé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כבוי: הטלפון הזה לא נפגש עם אף אחד בממסר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बंद: यह फ़ोन किसी रिले पर किसी से नहीं मिलता।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выключено: этот телефон ни с кем не встречается на релее."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimezimwa: simu hii haikutani na yeyote kwenye kipitishi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭：这部手机不在中继处与任何设备相遇。"
          }
        }
      }
    },
    "Offline: %@.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "غير متصل: %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin conexión: %@."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא מחוברים: %@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऑफ़लाइन: %@।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не в сети: %@."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Nje ya mtandao: %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "离线：%@。"
          }
        }
      }
    },
    "On a computer, run cbb pair and scan the code it shows.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "على حاسوب، شغّل cbb pair وامسح الرمز الذي يعرضه."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En un ordenador, ejecuta cbb pair y escanea el código que muestra."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "במחשב, הריצו cbb pair וסרקו את הקוד שהוא מציג."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी कंप्यूटर पर cbb pair चलाएँ और वह जो कोड दिखाए उसे स्कैन करें।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На компьютере запустите cbb pair и отсканируйте код, который он покажет."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kwenye kompyuta, endesha cbb pair na uchanganue msimbo inaoonyesha."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在电脑上运行 cbb pair，并扫描它显示的代码。"
          }
        }
      }
    },
    "On a home network: devices here connect to this phone.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "على شبكة منزلية: تتصل الأجهزة هنا بهذا الهاتف."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En una red de casa: los dispositivos de aquí se conectan a este teléfono."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ברשת ביתית: המכשירים כאן מתחברים לטלפון הזה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "घर के नेटवर्क पर: यहाँ के डिवाइस इस फ़ोन से जुड़ते हैं।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Домашняя сеть: устройства здесь подключаются к этому телефону."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kwenye mtandao wa nyumbani: vifaa vilivyo hapa huunganishwa na simu hii."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在家庭网络中：这里的设备连接到这部手机。"
          }
        }
      }
    },
    "On a new phone, open CBB, tap Join with an invitation and scan the code. On a computer, run cbb pair -invite with the file. It works once, for an hour, while this app is open; the group needs a hub.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "على هاتف جديد، افتح CBB واضغط «الانضمام بدعوة» وامسح الرمز. على حاسوب، شغّل cbb pair -invite مع الملف. تعمل مرة واحدة، لمدة ساعة، ما دام هذا التطبيق مفتوحًا؛ وتحتاج المجموعة إلى محور."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En un teléfono nuevo, abre CBB, toca Unirse con una invitación y escanea el código. En un ordenador, ejecuta cbb pair -invite con el archivo. Sirve una vez, durante una hora, mientras esta app está abierta; el grupo necesita un hub."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בטלפון חדש, פתחו את CBB, הקישו על הצטרפות בהזמנה וסרקו את הקוד. במחשב, הריצו cbb pair -invite עם הקובץ. היא פועלת פעם אחת, למשך שעה, כל עוד האפליקציה פתוחה; הקבוצה צריכה רכזת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नए फ़ोन पर CBB खोलें, निमंत्रण से जुड़ें पर टैप करें और कोड स्कैन करें। कंप्यूटर पर फ़ाइल के साथ cbb pair -invite चलाएँ। यह एक बार, एक घंटे के लिए, ऐप खुला रहने तक काम करता है; समूह को एक हब चाहिए।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На новом телефоне откройте CBB, нажмите «Вступить по приглашению» и отсканируйте код. На компьютере выполните cbb pair -invite с файлом. Приглашение работает один раз, в течение часа, пока приложение открыто; группе нужен хаб."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kwenye simu mpya, fungua CBB, gusa Jiunge kwa mwaliko na uchanganue msimbo. Kwenye kompyuta, endesha cbb pair -invite ukitumia faili. Unafanya kazi mara moja, kwa saa moja, programu hii ikiwa wazi; kikundi kinahitaji kitovu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在新手机上打开 CBB，点按“通过邀请加入”并扫描二维码。在电脑上用该文件运行 cbb pair -invite。只能使用一次，有效期一小时，且需此应用保持打开；群组需要一个中心节点。"
          }
        }
      }
    },
    "On a phone of the group, tap + and scan this code. On a computer of the group, tap + and type the numbers. Keep this screen open.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "على هاتف من المجموعة، اضغط + وامسح هذا الرمز. على حاسوب من المجموعة، اضغط + واكتب الأرقام. أبقِ هذه الشاشة مفتوحة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En un teléfono del grupo, toca + y escanea este código. En un ordenador del grupo, toca + y escribe los números. Mantén esta pantalla abierta."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בטלפון של הקבוצה, הקישו על + וסרקו את הקוד הזה. במחשב של הקבוצה, הקישו על + והקלידו את המספרים. השאירו את המסך הזה פתוח."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समूह के किसी फ़ोन पर, + टैप करें और यह कोड स्कैन करें। समूह के किसी कंप्यूटर पर, + टैप करें और अंक लिखें। यह स्क्रीन खुली रखें।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На телефоне группы нажмите + и отсканируйте этот код. На компьютере группы нажмите + и введите цифры. Не закрывайте этот экран."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kwenye simu ya kikundi, gusa + na uchanganue msimbo huu. Kwenye kompyuta ya kikundi, gusa + na uandike nambari. Acha skrini hii wazi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在群组的手机上，点按 + 并扫描此代码。在群组的电脑上，点按 + 并输入这些数字。请保持此屏幕打开。"
          }
        }
      }
    },
    "On the computer that created the group, run cbb pair -admin, then type the six-digit code it shows. Keep this phone on the same network.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "على الحاسوب الذي أنشأ المجموعة، شغّل cbb pair -admin، ثم اكتب الرمز المكوّن من ستة أرقام الذي يعرضه. أبقِ هذا الهاتف على الشبكة نفسها."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En el ordenador que creó el grupo, ejecuta cbb pair -admin y escribe el código de seis dígitos que muestra. Mantén este teléfono en la misma red."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "במחשב שיצר את הקבוצה, הריצו cbb pair -admin, ואז הקלידו את הקוד בן שש הספרות שהוא מציג. השאירו את הטלפון הזה באותה רשת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जिस कंप्यूटर ने समूह बनाया उस पर cbb pair -admin चलाएँ, फिर वह जो छह अंकों का कोड दिखाए उसे लिखें। इस फ़ोन को उसी नेटवर्क पर रखें।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На компьютере, который создал группу, выполните cbb pair -admin и введите шестизначный код, который он покажет. Телефон должен быть в той же сети."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kwenye kompyuta iliyounda kikundi, endesha cbb pair -admin, kisha uandike msimbo wa tarakimu sita inaoonyesha. Weka simu hii kwenye mtandao huo huo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在创建群组的电脑上运行 cbb pair -admin，然后输入它显示的六位数代码。让这部手机保持在同一网络中。"
          }
        }
      }
    },
    "On the group's hub, run cbb invite and send the file it makes through a channel you trust. On the new device, run cbb pair -invite with that file.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "على محور المجموعة، شغّل cbb invite وأرسل الملف الذي ينشئه عبر قناة تثق بها. على الجهاز الجديد، شغّل cbb pair -invite مع ذلك الملف."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En el hub del grupo, ejecuta cbb invite y envía el archivo que crea por un canal de confianza. En el dispositivo nuevo, ejecuta cbb pair -invite con ese archivo."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ברכזת של הקבוצה, הריצו cbb invite ושלחו את הקובץ שהיא יוצרת בערוץ שאתם סומכים עליו. במכשיר החדש, הריצו cbb pair -invite עם הקובץ הזה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समूह के हब पर cbb invite चलाएँ और वह जो फ़ाइल बनाए उसे किसी भरोसेमंद माध्यम से भेजें। नए डिवाइस पर उस फ़ाइल के साथ cbb pair -invite चलाएँ।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На хабе группы выполните cbb invite и отправьте получившийся файл по надёжному каналу. На новом устройстве выполните cbb pair -invite с этим файлом."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kwenye kitovu cha kikundi, endesha cbb invite na utume faili inalounda kupitia njia unayoiamini. Kwenye kifaa kipya, endesha cbb pair -invite pamoja na faili hilo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在群组的中心节点上运行 cbb invite，并通过你信任的渠道发送它生成的文件。在新设备上用该文件运行 cbb pair -invite。"
          }
        }
      }
    },
    "On the group's root phone, tap + and scan this code: only the root adds a phone as an admin. Keep this screen open.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "على الهاتف الجذر للمجموعة، اضغط + وامسح هذا الرمز: الجذر وحده يضيف هاتفًا كمشرف. أبقِ هذه الشاشة مفتوحة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En el teléfono raíz del grupo, toca + y escanea este código: solo la raíz añade un teléfono como administrador. Mantén esta pantalla abierta."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בטלפון השורש של הקבוצה, הקישו על + וסרקו את הקוד הזה: רק השורש מוסיף טלפון כמנהל. השאירו את המסך הזה פתוח."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समूह के रूट फ़ोन पर + दबाएँ और यह कोड स्कैन करें: केवल रूट ही किसी फ़ोन को एडमिन के रूप में जोड़ता है। यह स्क्रीन खुली रखें।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На корневом телефоне группы нажмите + и отсканируйте этот код: добавить телефон админом может только корень. Не закрывайте этот экран."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kwenye simu ya mzizi ya kikundi, gusa + na uchanganue msimbo huu: mzizi pekee ndio huongeza simu kama msimamizi. Acha skrini hii wazi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在群组的根手机上轻点 + 并扫描此代码：只有根能将手机添加为管理员。请保持此屏幕打开。"
          }
        }
      }
    },
    "One clipboard for this phone and your computers.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حافظة واحدة لهذا الهاتف وحواسيبك."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un solo portapapeles para este teléfono y tus ordenadores."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לוח אחד לטלפון הזה ולמחשבים שלכם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस फ़ोन और आपके कंप्यूटरों के लिए एक ही क्लिपबोर्ड।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Один буфер обмена для этого телефона и ваших компьютеров."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ubao mmoja wa kunakili kwa simu hii na kompyuta zako."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这部手机和你的电脑共用一个剪贴板。"
          }
        }
      }
    },
    "Online": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "متصل"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En línea"
