    "Turn on Everywhere to sync away from home.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شغّل «في كل مكان» للمزامنة خارج المنزل."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa En todas partes para sincronizar fuera de casa."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפעילו את ״בכל מקום״ כדי לסנכרן מחוץ לבית."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "घर से बाहर सिंक करने के लिए हर जगह चालू करें।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите «Везде», чтобы синхронизироваться вне дома."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Washa Kila mahali ili kusawazisha ukiwa mbali na nyumbani."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开“随处”，以便在家以外同步。"
          }
        }
      }
    },
    "Turn on another device of the group.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شغّل جهازًا آخر من المجموعة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enciende otro dispositivo del grupo."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפעילו מכשיר אחר של הקבוצה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समूह का कोई दूसरा डिवाइस चालू करें।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите другое устройство группы."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Washa kifaa kingine cha kikundi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开群组中的另一台设备。"
          }
        }
      }
    },
    "Turn sync on.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شغّل المزامنة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa la sincronización."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפעילו את הסנכרון."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिंक चालू करें।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите синхронизацию."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Washa usawazishaji."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开同步。"
          }
        }
      }
    },
    "Two claims to take the group over: %@.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مطالبتان بتولّي المجموعة: %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dos reclamaciones para tomar el grupo: %@."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שתי תביעות להשתלט על הקבוצה: %@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समूह अपने हाथ में लेने के दो दावे: %@।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Две заявки на передачу группы: %@."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Madai mawili ya kuchukua kikundi: %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有两个接管群组的声明：%@。"
          }
        }
      }
    },
    "Two computers are waiting for a device at once. Close cbb pair on one of them, then try again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حاسوبان ينتظران جهازًا في الوقت نفسه. أغلق cbb pair على أحدهما، ثم حاول مرة أخرى."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dos ordenadores esperan un dispositivo a la vez. Cierra cbb pair en uno de ellos y vuelve a intentarlo."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שני מחשבים ממתינים למכשיר בו-זמנית. סגרו את cbb pair באחד מהם ונסו שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दो कंप्यूटर एक साथ किसी डिवाइस का इंतज़ार कर रहे हैं। उनमें से एक पर cbb pair बंद करें, फिर दोबारा कोशिश करें।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сразу два компьютера ждут устройство. Закройте cbb pair на одном из них и попробуйте снова."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kompyuta mbili zinasubiri kifaa kwa wakati mmoja. Funga cbb pair kwenye moja yao, kisha ujaribu tena."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有两台电脑同时在等待设备。请在其中一台上关闭 cbb pair，然后重试。"
          }
        }
      }
    },
    "Type": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "النوع"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tipo"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סוג"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रकार"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тип"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Aina"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "类型"
          }
        }
      }
    },
    "Type it key by key": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كتابته مفتاحًا مفتاحًا"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribirlo tecla a tecla"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקלדה מקש אחר מקש"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसे एक-एक कुंजी से टाइप करें"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Набрать по клавишам"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Iandike kitufe kwa kitufe"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "逐键输入"
          }
        }
      }
    },
    "Type the YubiKey's PIN, then hold the YubiKey to the top of the phone: once for this phone's certificate and, once a computer of the group answered, again for the claim. Keep this phone on the network of a computer of the group.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اكتب الرقم السري لـ YubiKey، ثم قرّبه من أعلى الهاتف: مرة لشهادة هذا الهاتف، ثم مرة أخرى للمطالبة بعد أن يُجيب حاسوب من المجموعة. أبقِ هذا الهاتف على شبكة حاسوب من المجموعة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe el PIN de la YubiKey y acércala a la parte superior del teléfono: una vez para el certificado de este teléfono y, cuando responda un ordenador del grupo, otra para la reclamación. Mantén este teléfono en la red de un ordenador del grupo."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקלידו את ה-PIN של ה-YubiKey, ואז הצמידו את ה-YubiKey לחלק העליון של הטלפון: פעם אחת לאישור של הטלפון הזה, ואחרי שמחשב של הקבוצה ענה, שוב לתביעה. השאירו את הטלפון הזה ברשת של מחשב מהקבוצה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "YubiKey का PIN लिखें, फिर YubiKey को फ़ोन के ऊपरी हिस्से से लगाएँ: एक बार इस फ़ोन के प्रमाणपत्र के लिए और, समूह के किसी कंप्यूटर के जवाब देने पर, फिर दावे के लिए। इस फ़ोन को समूह के किसी कंप्यूटर के नेटवर्क पर रखें।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите PIN YubiKey, затем приложите YubiKey к верхней части телефона: один раз для сертификата этого телефона и, когда ответит компьютер группы, ещё раз для заявки. Держите телефон в сети компьютера группы."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Andika PIN ya YubiKey, kisha ushikilie YubiKey juu ya simu: mara moja kwa cheti cha simu hii na, kompyuta ya kikundi ikishajibu, tena kwa dai. Weka simu hii kwenye mtandao wa kompyuta ya kikundi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入 YubiKey 的 PIN，然后将 YubiKey 贴近手机顶部：一次用于这部手机的证书，等群组的电脑响应后再一次用于声明。让这部手机连接到群组中某台电脑所在的网络。"
          }
        }
      }
    },
    "Unfreeze": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إلغاء التجميد"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descongelar"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפשרה"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अनफ़्रीज़ करें"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разморозить"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Fungua ugandishaji"
          }
        },
        "zh-Hans": {
