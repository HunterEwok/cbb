    "Registered with the forwarder: devices away from home reach this phone.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مسجّل لدى مُعيد التوجيه: تصل الأجهزة البعيدة عن المنزل إلى هذا الهاتف."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registrado en el reenviador: los dispositivos fuera de casa llegan a este teléfono."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "רשום אצל המעביר: מכשירים מחוץ לבית מגיעים לטלפון הזה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ॉरवर्डर पर पंजीकृत: घर से दूर के डिवाइस इस फ़ोन तक पहुँचते हैं।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Зарегистрирован на форвардере: устройства вне дома видят этот телефон."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Imesajiliwa na kisambazaji: vifaa vilivyo mbali na nyumbani hufikia simu hii."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已在转发器注册：离家的设备可以连接到这部手机。"
          }
        }
      }
    },
