          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הדביקו את הטקסט של קוד ה-QR בדף השחזור."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिकवरी शीट के QR कोड का टेक्स्ट पेस्ट करें।"
          }
        },
        "ru": {
          "stringUnit": {
