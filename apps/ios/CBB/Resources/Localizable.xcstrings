          }
        }
      }
    },
    "Devices at home cannot connect to this one: %@.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تستطيع الأجهزة في المنزل الاتصال بهذا الجهاز: %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los dispositivos de casa no pueden conectarse a este: %@."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מכשירים בבית לא מצליחים להתחבר למכשיר הזה: %@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "घर के डिवाइस इससे नहीं जुड़ पा रहे: %@।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Устройства дома не могут подключиться к этому: %@."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Vifaa vya nyumbani haviwezi kuunganishwa na hiki: %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "家中的设备无法连接到此设备：%@。"
          }
        }
      }
    },
    "Devices away from home may not reach it; CBB tries again by itself.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قد لا تصل إليه الأجهزة خارج المنزل؛ يعيد CBB المحاولة تلقائيًا."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los dispositivos fuera de casa podrían no alcanzarlo; CBB lo intenta de nuevo solo."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ייתכן שמכשירים מחוץ לבית לא יגיעו אליה; CBB ינסה שוב בעצמו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "घर से बाहर के डिवाइस शायद इस तक न पहुँचें; CBB खुद फिर कोशिश करता है।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Устройства вне дома могут до него не дойти; CBB попробует снова сам."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Vifaa vilivyo mbali na nyumbani huenda visikifikie; CBB hujaribu tena yenyewe."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在家以外的设备可能无法连接到它；CBB 会自动重试。"
          }
        }
      }
    },
    "Did you keep the sheet?": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل احتفظت بالورقة؟"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Guardaste la hoja?"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שמרתם את הדף?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्या आपने शीट रख ली?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы сохранили лист?"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Je, uliihifadhi karatasi?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你保存好那张纸了吗？"
          }
        }
      }
    },
    "Done": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hecho"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
