          }
        }
      }
    },
    "I have the group's recovery sheet": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لديّ ورقة استرداد المجموعة"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tengo la hoja de recuperación del grupo"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לי דף השחזור של הקבוצה"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मेरे पास समूह की रिकवरी शीट है"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У меня есть лист восстановления группы"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Nina karatasi ya urejeshaji ya kikundi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我有群组的恢复单"
          }
        }
      }
    },
    "I kept it": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احتفظت بها"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La guardé"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שמרתי אותו"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मैंने रख ली"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранил"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Niliihifadhi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我已保存"
          }
        }
      }
    },
    "If this device was not lost, remove %@ from the group.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إن لم يكن هذا الجهاز مفقودًا، فأزل %@ من المجموعة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si este dispositivo no se perdió, quita %@ del grupo."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אם המכשיר לא אבד, הסירו את %@ מהקבוצה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अगर यह डिवाइस खोया नहीं था, तो %@ को समूह से हटाएँ।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если устройство не терялось, удалите %@ из группы."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikiwa kifaa hiki hakikupotea, ondoa %@ kwenye kikundi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果此设备并未丢失，请将 %@ 移出群组。"
          }
        }
      }
    },
    "If this is your home network, mark it as home.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إن كانت هذه شبكة منزلك، فاجعلها شبكة المنزل."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si es tu red de casa, márcala como la de casa."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אם זו הרשת הביתית שלכם, סמנו אותה כרשת הבית."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अगर यह आपका घरेलू नेटवर्क है, तो इसे घरेलू के रूप में चिह्नित करें।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если это ваша домашняя сеть, отметьте её как домашнюю."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikiwa huu ni mtandao wa nyumbani kwako, uweke kama wa nyumbani."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果这是你的家庭网络，请将它标记为家庭网络。"
          }
        }
      }
    },
