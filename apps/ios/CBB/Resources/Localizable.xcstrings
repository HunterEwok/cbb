    "Only an admin makes an invitation: an admin phone here, or cbb invite on an admin computer.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا ينشئ الدعوة إلا مشرف: هاتف مشرف هنا، أو cbb invite على حاسوب مشرف."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo un administrador crea invitaciones: un teléfono administrador aquí, o cbb invite en un ordenador administrador."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "רק מנהל יוצר הזמנה: טלפון מנהל כאן, או cbb invite במחשב מנהל."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "निमंत्रण केवल एडमिन बनाता है: यहाँ एक एडमिन फ़ोन, या एडमिन कंप्यूटर पर cbb invite।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приглашение делает только админ: телефон-админ здесь или cbb invite на компьютере-админе."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ni msimamizi pekee anayeunda mwaliko: simu ya msimamizi hapa, au cbb invite kwenye kompyuta ya msimamizi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有管理员可以创建邀请：这里的管理员手机，或管理员电脑上的 cbb invite。"
          }
        }
      }
    },
    "Only an admin phone can add or remove devices.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هاتف المشرف وحده يمكنه إضافة الأجهزة أو إزالتها."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo un teléfono administrador puede añadir o quitar dispositivos."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "רק טלפון מנהל יכול להוסיף או להסיר מכשירים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल एडमिन फ़ोन ही डिवाइस जोड़ या हटा सकता है।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавлять и удалять устройства может только телефон-админ."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Simu ya msimamizi pekee inaweza kuongeza au kuondoa vifaa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有管理员手机可以添加或移除设备。"
          }
        }
      }
    },
    "Only an admin phone can do this.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هاتف المشرف وحده يمكنه فعل هذا."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo un teléfono administrador puede hacer esto."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "רק טלפון מנהל יכול לעשות זאת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल एडमिन फ़ोन ही यह कर सकता है।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это может только телефон-админ."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Simu ya msimamizi pekee inaweza kufanya hivi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有管理员手机可以执行此操作。"
          }
        }
      }
    },
    "Oops, something broke": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عذرًا، حدث عطل ما"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaya, algo se rompió"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אופס, משהו נשבר"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उफ़, कुछ टूट गया"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ой, что-то сломалось"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo, kuna kitu kimeharibika"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "哎呀，出问题了"
          }
        }
      }
    },
    "Open CBB on the watch, then try again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح CBB على الساعة، ثم حاول مرة أخرى."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre CBB en el reloj y vuelve a intentarlo."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פתחו את CBB בשעון ונסו שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "घड़ी पर CBB खोलें, फिर दोबारा कोशिश करें।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте CBB на часах и попробуйте снова."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Fungua CBB kwenye saa, kisha ujaribu tena."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在手表上打开 CBB，然后重试。"
          }
        }
      }
    },
    "Open a file": {
      "localizations": {
        "ar": {
          "stringUnit": {
