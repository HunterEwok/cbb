          }
        }
      }
    },
    "Waiting for the hub: open the app at home once, near a computer of the group.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في انتظار المحور: افتح التطبيق في المنزل مرة واحدة، قرب حاسوب من المجموعة."
          }
        },
        "es": {
          "stringUnit": {
