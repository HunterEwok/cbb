          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Imehifadhiwa. Kila kifaa cha kikundi kinafuata hili."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保存。群组的每台设备都会遵循它。"
          }
        }
      }
    },
    "Scan a code": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مسح رمز"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escanear un código"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סריקת קוד"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोड स्कैन करें"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отсканировать код"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Changanua msimbo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扫描代码"
          }
        }
      }
    },
    "Scan the QR code of the recovery sheet: on a new phone the typed key is not enough. A computer of the group takes the typed key with cbb recovery.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "امسح رمز QR في ورقة الاسترداد: على هاتف جديد لا يكفي المفتاح المكتوب. يقبل حاسوب من المجموعة المفتاح المكتوب باستخدام cbb recovery."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escanea el código QR de la hoja de recuperación: en un teléfono nuevo no basta con la clave escrita. Un ordenador del grupo acepta la clave escrita con cbb recovery."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סרקו את קוד ה-QR בדף השחזור: בטלפון חדש המפתח המוקלד לא מספיק. מחשב של הקבוצה מקבל את המפתח המוקלד עם cbb recovery."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिकवरी शीट का QR कोड स्कैन करें: नए फ़ोन पर टाइप की गई कुंजी काफ़ी नहीं है। समूह का कोई कंप्यूटर cbb recovery से टाइप की गई कुंजी लेता है।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отсканируйте QR-код листа восстановления: на новом телефоне введённого ключа недостаточно. Введённый ключ принимает компьютер группы через cbb recovery."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Changanua msimbo wa QR wa karatasi ya urejeshaji: kwenye simu mpya ufunguo ulioandikwa hautoshi. Kompyuta ya kikundi hupokea ufunguo ulioandikwa kwa cbb recovery."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扫描恢复单上的二维码：在新手机上，仅输入密钥是不够的。群组中的电脑可以用 cbb recovery 接受输入的密钥。"
          }
        }
      }
    },
