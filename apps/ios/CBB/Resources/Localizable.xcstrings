          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "घर से बाहर: हब"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вне дома: хаб"
          }
        },
        "sw": {
          "stringUnit": {
