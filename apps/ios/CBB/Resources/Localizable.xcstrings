    "Make a second phone an admin: on it, tap Join a group, then scan its code here with +.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اجعل هاتفًا ثانيًا مشرفًا: عليه، اضغط الانضمام إلى مجموعة، ثم امسح رمزه هنا باستخدام +."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz administrador a un segundo teléfono: en él, toca Unirse a un grupo y escanea aquí su código con +."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפכו טלפון שני למנהל: בו, הקישו על ״הצטרפות לקבוצה״, ואז סרקו כאן את הקוד שלו עם +."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दूसरे फ़ोन को एडमिन बनाएँ: उस पर, समूह से जुड़ें टैप करें, फिर यहाँ + से उसका कोड स्कैन करें।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сделайте второй телефон админом: на нём нажмите «Войти в группу», затем отсканируйте его код здесь кнопкой +."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Fanya simu ya pili kuwa msimamizi: kwenye simu hiyo, gusa Jiunge na kikundi, kisha uchanganue msimbo wake hapa kwa +."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让第二部手机成为管理员：在那部手机上点按“加入群组”，然后在这里用 + 扫描它的代码。"
          }
        }
      }
    },
