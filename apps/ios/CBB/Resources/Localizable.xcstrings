          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אני כבר משתמש ב-CBB בטלפון אחר"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मैं पहले से दूसरे फ़ोन पर CBB इस्तेमाल करता हूँ"
          }
        },
        "ru": {
          "stringUnit": {
