            "state": "translated",
            "value": "转发器地址，例如 198.51.100.9:8764"
          }
        }
      }
    },
    "Forwarder key, 44 characters": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مفتاح مُعيد التوجيه، 44 حرفًا"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
