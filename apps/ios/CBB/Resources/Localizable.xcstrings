    "Opens CBB and sends what this phone copied to your computers, or fetches what a computer copied a moment ago.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفتح CBB ويرسل ما نسخه هذا الهاتف إلى حواسيبك، أو يجلب ما نسخه حاسوب قبل لحظة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre CBB y envía a tus ordenadores lo que copió este teléfono, o trae lo que un ordenador copió hace un momento."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פותח את CBB ושולח למחשבים שלכם את מה שהטלפון הזה העתיק, או מביא את מה שמחשב העתיק לפני רגע."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "CBB खोलता है और इस फ़ोन की कॉपी आपके कंप्यूटरों पर भेजता है, या किसी कंप्यूटर ने अभी जो कॉपी किया वह लाता है।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открывает CBB и отправляет скопированное на телефоне на ваши компьютеры или забирает то, что компьютер скопировал только что."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hufungua CBB na kutuma kwenye kompyuta zako kile simu hii ilinakili, au huleta kile kompyuta ilinakili muda mfupi uliopita."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 CBB 并将这部手机复制的内容发送到你的电脑，或获取电脑刚刚复制的内容。"
          }
        }
      }
    },
