          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hakuna simu iliyochanganua msimbo ndani ya dakika tano. Jaribu tena."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
