    "Print this sheet or save it as a PDF now. It shows only this once.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اطبع هذه الورقة أو احفظها كـ PDF الآن. لا تظهر إلا هذه المرة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Imprime esta hoja o guárdala como PDF ahora. Solo se muestra esta vez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הדפיסו את הדף הזה או שמרו אותו כ-PDF עכשיו. הוא מוצג רק הפעם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह शीट अभी प्रिंट करें या PDF के रूप में सहेजें। यह केवल इसी बार दिखती है।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Напечатайте этот лист или сохраните его в PDF сейчас. Он показывается только один раз."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Chapisha karatasi hii au uihifadhi kama PDF sasa. Inaonyeshwa mara hii tu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现在打印此单据或存为 PDF。它只显示这一次。"
          }
        }
      }
    },
    "Proven hardware only": {
      "localizations": {
        "ar": {
