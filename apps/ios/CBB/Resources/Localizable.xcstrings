          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Si hiki"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不是这个"
          }
        }
      }
    },
    "Nothing new to send or fetch.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا جديد للإرسال أو الجلب."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada nuevo que enviar ni obtener."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין שום דבר חדש לשלוח או להביא."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "भेजने या लाने के लिए कुछ नया नहीं।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нечего отправить или получить."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hakuna kipya cha kutuma au kuleta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有新的内容需要发送或获取。"
          }
        }
      }
    },
    "Notifications": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
