    "Saved. Every device of the group follows it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم الحفظ. تتبعه كل أجهزة المجموعة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardado. Todos los dispositivos del grupo lo siguen."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נשמר. כל מכשירי הקבוצה פועלים לפיו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सहेजा गया। समूह का हर डिवाइस इसका पालन करता है।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
