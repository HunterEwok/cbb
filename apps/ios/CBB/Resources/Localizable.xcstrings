{
  "sourceLanguage": "en",
  "strings": {
    "%@ %@?": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@؟"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿%@ %@?"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: %2$@?"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@？"
          }
        }
      }
    },
    "%@ claims the group, and the group is stopped until its root decides.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يطالب %@ بالمجموعة، والمجموعة متوقفة حتى يقرر جذرها."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ reclama el grupo, y el grupo está detenido hasta que su raíz decida."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ תובע את הקבוצה, והקבוצה עצורה עד שהשורש שלה יחליט."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ समूह पर दावा करता है, और जब तक रूट निर्णय न ले, समूह रुका हुआ है।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ хочет забрать группу, и группа остановлена, пока корень не решит."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kinadai kikundi, na kikundi kimesimamishwa hadi mzizi wake uamue."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 声明接管群组，群组已停止，直到其根设备做出决定。"
          }
        }
      }
    },
    "%@ claims the group, to take it over from its root.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يطالب %@ بالمجموعة، لتولّيها من جذرها."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ reclama el grupo para tomarlo de su raíz."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ תובע את הקבוצה, כדי להשתלט עליה מהשורש שלה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ समूह पर दावा करता है, ताकि उसे रूट से अपने हाथ में ले।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ хочет забрать группу у корня."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kinadai kikundi, ili kukichukua kutoka kwa mzizi wake."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 声明接管群组，以从根设备手中接管。"
          }
        }
      }
    },
    "%@ claims the group, to take it over from its root: it takes effect in %@.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يطالب %@ بالمجموعة، لتولّيها من جذرها: تسري خلال %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ reclama el grupo para tomarlo de su raíz: surte efecto en %@."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ תובע את הקבוצה, כדי להשתלט עליה מהשורש שלה: זה ייכנס לתוקף בעוד %@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ समूह पर दावा करता है, ताकि उसे रूट से अपने हाथ में ले: यह %@ में लागू होगा।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ хочет забрать группу у корня: это произойдёт через %2$@."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kinadai kikundi, ili kukichukua kutoka kwa mzizi wake: kitaanza kutumika baada ya %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 声明接管群组，以从根设备手中接管：将在 %@ 后生效。"
          }
        }
      }
    },
    "%@ could not be read.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّرت قراءة %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer %@."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן לקרוא את %@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ पढ़ी नहीं जा सकी।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось прочитать %@."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ haikuweza kusomwa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取 %@。"
          }
        }
      }
    },
    "%@ has no quick action turned on. Its user turns them on there, with sudo cbb action enable.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ليس لدى %@ أي إجراء سريع مفعّل. يشغّلها مستخدمه هناك باستخدام sudo cbb action enable."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no tiene ninguna acción rápida activada. Su usuario las activa allí con sudo cbb action enable."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ב-%@ אין פעולה מהירה מופעלת. המשתמש שלו מפעיל אותן שם, עם sudo cbb action enable."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ पर कोई त्वरित क्रिया चालू नहीं है। उसका उपयोगकर्ता वहाँ sudo cbb action enable से इन्हें चालू करता है।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На %@ не включено ни одного быстрого действия. Его пользователь включает их там командой sudo cbb action enable."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hakina kitendo cha haraka kilichowashwa. Mtumiaji wake huviwasha huko, kwa sudo cbb action enable."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 没有开启任何快捷操作。由它的用户在那里用 sudo cbb action enable 开启。"
          }
        }
      }
    },
    "%@ is always on. Make it the hub, so that sync away from home works while this app is closed?": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ يعمل دائمًا. هل تجعله المحور، لتعمل المزامنة بعيدًا عن المنزل ما دام هذا التطبيق مغلقًا؟"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está siempre encendido. ¿Convertirlo en el hub, para que la sincronización fuera de casa funcione mientras esta app está cerrada?"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ תמיד דולק. להפוך אותו לרכזת, כדי שסנכרון מחוץ לבית יעבוד כשהיישום הזה סגור?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ हमेशा चालू रहता है। इसे हब बनाएँ, ताकि यह ऐप बंद होने पर भी घर से दूर सिंक काम करे?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ всегда включён. Сделать его хабом, чтобы синхронизация вне дома работала, пока приложение закрыто?"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kimewashwa daima. Ukifanye kitovu, ili kusawazisha ukiwa mbali na nyumbani kufanye kazi wakati programu hii imefungwa?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 一直开机。要让它成为中心节点，以便此应用关闭时离家同步仍能工作吗？"
          }
        }
      }
    },
    "%@ is an admin now.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أصبح %@ مشرفًا الآن."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ahora es administrador."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ הוא עכשיו מנהל."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ अब एडमिन है।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ теперь админ."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sasa ni msimamizi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 现在是管理员。"
          }
        }
      }
    },
    "%@ joined the group.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انضم %@ إلى المجموعة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ se unió al grupo."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ הצטרף לקבוצה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ समूह में शामिल हो गया।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ теперь в группе."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kimejiunga na kikundi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已加入群组。"
          }
        }
      }
    },
    "%@ signed two histories with one key, as a stolen key or a restore from a backup would.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وقّع %@ سجلين بمفتاح واحد، كما يحدث مع مفتاح مسروق أو استعادة من نسخة احتياطية."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ firmó dos historiales con una misma clave, como haría una clave robada o una restauración desde una copia de seguridad."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ חתם על שתי היסטוריות עם מפתח אחד, כמו שמפתח גנוב או שחזור מגיבוי היו עושים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ने एक ही कुंजी से दो इतिहास हस्ताक्षरित किए, जैसा कोई चोरी हुई कुंजी या बैकअप से बहाली करती है।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: две истории, подписанные одним ключом. Так бывает при краже ключа или после восстановления из резервной копии."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kilitia sahihi historia mbili kwa ufunguo mmoja, kama ufunguo ulioibiwa au urejeshaji kutoka nakala rudufu ungefanya."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 用同一个密钥签署了两份历史，就像被盗密钥或从备份恢复时那样。"
          }
        }
      }
    },
    "%@ took the group over from this device.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استولى %@ على المجموعة من هذا الجهاز."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tomó el grupo de este dispositivo."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ לקח את הקבוצה מהמכשיר הזה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ने इस डिवाइस से समूह ले लिया।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ забрал группу у этого устройства."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kilichukua kikundi kutoka kifaa hiki."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已从此设备接管群组。"
          }
        }
      }
    },
    "%@ took the group over: it holds the group's root now.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تولّى %@ المجموعة: يحمل جذر المجموعة الآن."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tomó el grupo: ahora tiene la raíz del grupo."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ השתלט על הקבוצה: הוא מחזיק עכשיו את השורש של הקבוצה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ने समूह अपने हाथ में ले लिया: अब समूह का रूट उसके पास है।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ забрал группу себе: теперь он создатель группы."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kimechukua kikundi: sasa kinashikilia mzizi wa kikundi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 接管了群组：它现在持有群组的根。"
          }
        }
      }
    },
    "%@ was frozen: the others refuse it until an admin unfreezes it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جُمّد %@: يرفضه الآخرون حتى يلغي مشرف تجميده."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ fue congelado: los demás lo rechazan hasta que un administrador lo descongele."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ הוקפא: האחרים דוחים אותו עד שמנהל יפשיר אותו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ फ़्रीज़ कर दिया गया: जब तक कोई एडमिन उसे अनफ़्रीज़ न करे, बाकी उसे ठुकराते हैं।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ заморожен: остальные его не принимают, пока админ его не разморозит."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kimegandishwa: vingine vinakikataa hadi msimamizi akifungue."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已被冻结：在管理员解冻它之前，其他设备会拒绝它。"
          }
        }
      }
    },
    "%@ was removed from the group.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أُزيل %@ من المجموعة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ se quitó del grupo."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ הוסר מהקבוצה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ को समूह से हटा दिया गया।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ больше не в группе: устройство удалено."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kimeondolewa kwenye kikundi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已从群组中移除。"
          }
        }
      }
    },
    "%@ was unfrozen.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أُلغي تجميد %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ fue descongelado."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ הופשר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ अनफ़्रीज़ कर दिया गया।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ разморожен."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ugandishaji wa %@ umefunguliwa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已解冻。"
          }
        }
      }
    },
    "%lld of %lld online": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld من %lld متصل"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld de %lld en línea"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld מתוך %lld מחוברים"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$lld में से %1$lld ऑनलाइन"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld из %lld в сети"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld kati ya %lld mtandaoni"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$lld 台中 %1$lld 台在线"
          }
        }
      }
    },
    "A computer that is always on keeps sync away from home working while this app is closed. The devices that reach this phone from afar move with it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حاسوب يعمل دائمًا يُبقي المزامنة خارج المنزل تعمل وهذا التطبيق مغلق. الأجهزة التي تصل إلى هذا الهاتف من بعيد تنتقل معه."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un ordenador siempre encendido mantiene la sincronización fuera de casa mientras esta app está cerrada. Los dispositivos que llegan a este teléfono desde lejos se mudan con él."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מחשב שתמיד פועל שומר על סנכרון מחוץ לבית גם כשהאפליקציה הזו סגורה. המכשירים שמגיעים לטלפון הזה מרחוק עוברים איתו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हमेशा चालू रहने वाला कंप्यूटर इस ऐप के बंद रहने पर भी घर से बाहर सिंक चालू रखता है। दूर से इस फ़ोन तक पहुँचने वाले डिवाइस उसके साथ चले जाते हैं।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Компьютер, который всегда включён, держит синхронизацию вне дома, пока приложение закрыто. Устройства, которые подключаются к этому телефону издалека, переходят вместе с хабом."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kompyuta inayowashwa kila wakati huweka usawazishaji ukiwa mbali na nyumbani ukifanya kazi programu hii ikiwa imefungwa. Vifaa vinavyofikia simu hii kutoka mbali huhamia pamoja nayo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一台常开的电脑能在本应用关闭时保持离家同步。从远处连到这部手机的设备会随它一起迁移。"
          }
        }
      }
    },
    "A copy from another device": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نسخة من جهاز آخر"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una copia de otro dispositivo"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "העתקה ממכשיר אחר"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी दूसरे डिवाइस की कॉपी"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Копия с другого устройства"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Nakala kutoka kifaa kingine"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "来自其他设备的副本"
          }
        }
      }
    },
    "A device (%@) used the invitation. Admit it only if the device shows the same fingerprint:\n\n%@": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم جهاز (%@) الدعوة. اقبله فقط إذا عرض الجهاز البصمة نفسها:\n\n%@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un dispositivo (%@) usó la invitación. Admítelo solo si muestra la misma huella:\n\n%@"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מכשיר (%@) השתמש בהזמנה. קבלו אותו רק אם המכשיר מציג את אותה טביעת אצבע:\n\n%@"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक डिवाइस (%@) ने आमंत्रण का उपयोग किया। उसे तभी शामिल करें जब डिवाइस वही फ़िंगरप्रिंट दिखाए:\n\n%@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Устройство (%1$@) воспользовалось приглашением. Принимайте его, только если оно показывает такой же отпечаток:\n\n%2$@"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kifaa (%@) kilitumia mwaliko. Kikubali tu ikiwa kifaa kinaonyesha alama ileile:\n\n%@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有设备（%@）使用了邀请。只有当该设备显示相同的指纹时才接纳它：\n\n%@"
          }
        }
      }
    },
    "A device became an admin": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أصبح جهاز مشرفًا"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un dispositivo pasó a ser administrador"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מכשיר הפך למנהל"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई डिवाइस एडमिन बना"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Устройство стало админом"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kifaa kimekuwa msimamizi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有设备成为管理员"
          }
        }
      }
    },
    "A device joined or was removed": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انضم جهاز أو أُزيل"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un dispositivo se unió o fue eliminado"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מכשיר הצטרף או הוסר"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई डिवाइस जुड़ा या हटाया गया"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Устройство добавлено или удалено"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kifaa kimejiunga au kimeondolewa"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有设备加入或被移除"
          }
        }
      }
    },
    "A device was frozen or unfrozen": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جُمّد جهاز أو أُلغي تجميده"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un dispositivo fue congelado o descongelado"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מכשיר הוקפא או שוחרר מהקפאה"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई डिवाइस फ़्रीज़ या अनफ़्रीज़ हुआ"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Устройство заморожено или разморожено"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kifaa kimegandishwa au kimeachiliwa"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有设备被冻结或解冻"
          }
        }
      }
    },
    "A hub that only passes them on": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "محور يمرّرها فقط"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un hub que solo las reenvía"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "רכזת שרק מעבירה אותן"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल आगे भेजने वाला हब"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хаб, который только пересылает"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kitovu kinachozipitisha tu"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只转发副本的中心节点"
          }
        }
      }
    },
    "A hub that reads the copies": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "محور يقرأ النسخ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un hub que lee las copias"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "רכזת שקוראת את ההעתקות"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कॉपी पढ़ने वाला हब"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хаб, который читает копии"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kitovu kinachosoma nakala"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读取副本的中心节点"
          }
        }
      }
    },
    "A hub that reads the copies is an admin. A hub that only passes them on cannot read them: they are sealed to your other devices only, so its keys need no hardware.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المحور الذي يقرأ النسخ مشرف. والمحور الذي يمرّرها فقط لا يستطيع قراءتها: فهي مختومة لأجهزتك الأخرى وحدها، لذا لا تحتاج مفاتيحه إلى عتاد."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un hub que lee las copias es administrador. Un hub que solo las reenvía no puede leerlas: van selladas solo para tus otros dispositivos, así que sus claves no necesitan hardware."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "רכזת שקוראת את ההעתקות היא מנהל. רכזת שרק מעבירה אותן לא יכולה לקרוא אותן: הן חתומות רק למכשירים האחרים שלכם, ולכן המפתחות שלה לא צריכים חומרה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कॉपी पढ़ने वाला हब एडमिन होता है। केवल आगे भेजने वाला हब उन्हें पढ़ नहीं सकता: वे केवल आपके दूसरे डिवाइसों के लिए सील होती हैं, इसलिए उसकी कुंजियों को हार्डवेयर नहीं चाहिए।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хаб, который читает копии, — это админ. Хаб, который только пересылает, прочитать их не может: они запечатаны только для ваших других устройств, поэтому его ключам не нужно оборудование."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kitovu kinachosoma nakala ni msimamizi. Kitovu kinachozipitisha tu hakiwezi kuzisoma: zimefungwa kwa ajili ya vifaa vyako vingine tu, kwa hiyo funguo zake hazihitaji maunzi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读取副本的中心节点是管理员。只转发副本的中心节点无法读取它们：副本只为你的其他设备密封，所以它的密钥不需要硬件。"
          }
        }
      }
    },
    "A name has 1 to 64 characters.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الاسم من 1 إلى 64 حرفًا."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un nombre tiene de 1 a 64 caracteres."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לשם יש 1 עד 64 תווים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नाम में 1 से 64 अक्षर होते हैं।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В имени от 1 до 64 символов."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Jina lina herufi 1 hadi 64."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "名称为 1 到 64 个字符。"
          }
        }
      }
    },
    "A paste suits most apps; typing suits those that take no paste, and only up to 4 KB. Enter runs a command in a terminal, so the computer takes it only when its user allowed that. A secret leaves no trace in the computer's log or clipboard.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اللصق يناسب معظم التطبيقات؛ والكتابة تناسب التي لا تقبل اللصق، وحتى 4 كيلوبايت فقط. ‏Enter يشغّل أمرًا في الطرفية، لذا لا يقبله الحاسوب إلا إذا سمح مستخدمه بذلك. السرّ لا يترك أثرًا في سجل الحاسوب أو حافظته."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pegar sirve para la mayoría de las apps; escribir sirve para las que no aceptan pegar, y solo hasta 4 KB. Intro ejecuta una orden en una terminal, así que el ordenador lo acepta solo si su usuario lo permitió. Un secreto no deja rastro en el registro ni en el portapapeles del ordenador."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הדבקה מתאימה לרוב האפליקציות; הקלדה מתאימה לאלה שלא מקבלות הדבקה, ורק עד 4 KB. ‏Enter מריץ פקודה במסוף, ולכן המחשב מקבל אותו רק אם המשתמש שלו התיר זאת. סוד לא משאיר עקבות ביומן או בלוח של המחשב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पेस्ट ज़्यादातर ऐप के लिए ठीक है; टाइप करना उन ऐप के लिए जो पेस्ट नहीं लेते, और केवल 4 KB तक। Enter टर्मिनल में कमांड चला देता है, इसलिए कंप्यूटर इसे तभी लेता है जब उसके उपयोगकर्ता ने अनुमति दी हो। गोपनीय टेक्स्ट कंप्यूटर के लॉग या क्लिपबोर्ड में कोई निशान नहीं छोड़ता।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вставка подходит большинству приложений, а набор по клавишам нужен тем, что вставку не принимают, и только до 4 КБ. Enter в терминале запускает команду, поэтому компьютер примет его, только если его пользователь это разрешил. Секрет не остаётся ни в журнале компьютера, ни в его буфере."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kubandika kunafaa programu nyingi; kuandika kunafaa zile zisizokubali kubandika, na hadi KB 4 tu. Enter huendesha amri kwenye kituo, kwa hiyo kompyuta huikubali tu ikiwa mtumiaji wake aliruhusu. Siri haiachi alama kwenye kumbukumbu au ubao wa kunakili wa kompyuta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "粘贴适合大多数应用；输入适合不接受粘贴的应用，且最多 4 KB。回车会在终端中执行命令，所以只有电脑的用户允许时才会接受。机密不会在电脑的日志或剪贴板中留下痕迹。"
          }
        }
      }
    },
    "A picture or files go to the group as a copy, and the computer pastes them where its focus is, as Cmd+V or Ctrl+V would: into a chat, a document or a folder. Enter, if on, sends them in a chat.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تذهب الصورة أو الملفات إلى المجموعة كنسخة، ويلصقها الكمبيوتر حيث يكون التركيز، كما يفعل Cmd+V أو Ctrl+V: في محادثة أو مستند أو مجلد. مفتاح Enter، إن كان مفعّلًا، يرسلها في المحادثة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una imagen o archivos van al grupo como una copia, y el ordenador los pega donde tiene el foco, como lo haría Cmd+V o Ctrl+V: en un chat, un documento o una carpeta. Intro, si está activado, los envía en un chat."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התמונה או הקבצים נשלחים לקבוצה כהעתקה, והמחשב מדביק אותם במקום שבו נמצא המיקוד, כמו Cmd+V או Ctrl+V: בצ׳אט, במסמך או בתיקייה. Enter, אם הוא מופעל, שולח אותם בצ׳אט."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तस्वीर या फ़ाइलें ग्रुप में एक कॉपी के रूप में जाती हैं, और कंप्यूटर उन्हें वहाँ पेस्ट करता है जहाँ उसका फ़ोकस है, जैसे Cmd+V या Ctrl+V करता: किसी चैट, दस्तावेज़ या फ़ोल्डर में। Enter, अगर चालू है, तो उन्हें चैट में भेज देता है।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Картинка или файлы уходят в группу копией, и компьютер вставляет их туда, где фокус, как Cmd+V или Ctrl+V: в чат, документ или папку. Enter, если включён, отправляет их в чате."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Picha au faili huenda kwenye kikundi kama nakala, na kompyuta huzibandika mahali lengo lake lilipo, kama Cmd+V au Ctrl+V ingefanya: kwenye gumzo, hati au folda. Enter, ikiwa imewashwa, huzituma kwenye gumzo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图片或文件作为一份拷贝发送到群组，电脑会像按 Cmd+V 或 Ctrl+V 一样把它们粘贴到焦点所在处：聊天、文档或文件夹中。如果开启了回车，会在聊天中发送它们。"
          }
        }
      }
    },
    "A secret": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سرّ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un secreto"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סוד"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक गोपनीय टेक्स्ट"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Секрет"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "机密"
          }
        }
      }
    },
    "A sheet to print and keep away from your phones. If every phone with this group is lost, a computer of the group or a new phone takes the group back with it, after the group's wait.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ورقة تطبعها وتحفظها بعيدًا عن هواتفك. إذا فُقدت كل الهواتف التي فيها هذه المجموعة، يستعيد بها حاسوب من المجموعة أو هاتف جديد المجموعة، بعد مهلة المجموعة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una hoja para imprimir y guardar lejos de tus teléfonos. Si se pierden todos los teléfonos con este grupo, un ordenador del grupo o un teléfono nuevo recupera el grupo con ella, tras la espera del grupo."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "דף להדפסה ולשמירה הרחק מהטלפונים שלכם. אם כל הטלפונים עם הקבוצה הזו אבדו, מחשב של הקבוצה או טלפון חדש לוקחים איתו את הקבוצה בחזרה, אחרי זמן ההמתנה של הקבוצה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक पन्ना जिसे छापकर अपने फ़ोनों से दूर रखें। अगर इस समूह वाले सभी फ़ोन खो जाएँ, तो समूह का कोई कंप्यूटर या नया फ़ोन इससे, समूह की प्रतीक्षा अवधि के बाद, समूह वापस ले लेता है।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Лист, который печатают и хранят отдельно от телефонов. Если потеряны все телефоны этой группы, с ним компьютер группы или новый телефон вернёт группу после времени ожидания группы."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Karatasi ya kuchapisha na kuweka mbali na simu zako. Simu zote zenye kikundi hiki zikipotea, kompyuta ya kikundi au simu mpya huchukua kikundi tena kwa karatasi hii, baada ya muda wa kusubiri wa kikundi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一张打印出来、存放在远离手机之处的纸。如果此群组的所有手机都丢失，群组中的电脑或一部新手机可以凭它在群组的等待期后收回群组。"
          }
        }
      }
    },
