    "Sync is off on this device until %@.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المزامنة متوقفة على هذا الجهاز حتى %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sincronización está desactivada en este dispositivo hasta %@."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הסנכרון כבוי במכשיר הזה עד %@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस डिवाइस पर सिंक %@ तक बंद है।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На этом устройстве синхронизация выключена до %@."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Usawazishaji umezimwa kwenye kifaa hiki hadi %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备上的同步已关闭，直到 %@。"
          }
        }
      }
    },
