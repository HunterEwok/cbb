    "Turns sync on this phone on or off.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включает и выключает синхронизацию на этом телефоне."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa o desactiva la sincronización en este teléfono."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启或关闭此手机上的同步。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يشغّل المزامنة على هذا الهاتف أو يوقفها."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מפעיל או מכבה את הסנכרון בטלפון הזה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस फ़ोन पर सिंक चालू या बंद करता है।"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Huwasha au kuzima usawazishaji kwenye simu hii."
          }
        }
      }
    }
