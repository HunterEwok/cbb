{
  "sourceLanguage": "en",
  "strings": {
    "%lld of %lld online": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld من %lld متصل"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld de %lld en línea"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld מתוך %lld מחוברים"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$lld में से %1$lld ऑनलाइन"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld из %lld в сети"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld kati ya %lld mtandaoni"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$lld 台中 %1$lld 台在线"
          }
        }
      }
    },
    "As the iPhone last said.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كما قال الـiPhone آخر مرة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Según lo último que dijo el iPhone."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כפי שה־iPhone אמר לאחרונה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जैसा iPhone ने पिछली बार बताया।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По последним данным с iPhone."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kama iPhone ilivyosema mwisho."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以 iPhone 最后报告的为准。"
          }
        }
      }
    },
    "At home: syncing directly.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في المنزل: مزامنة مباشرة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En casa: sincronizando directamente."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בבית: מסנכרן ישירות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "घर पर: सीधे सिंक हो रहा है।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дома: синхронизация напрямую."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyumbani: inasawazisha moja kwa moja."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在家：直接同步。"
          }
        }
      }
    },
    "Away from home": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خارج المنزل"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fuera de casa"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מחוץ לבית"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "घर से बाहर"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вне дома"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Mbali na nyumbani"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "离家"
          }
        }
      }
    },
    "Connecting to the hub…": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جارٍ الاتصال بالمحور…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectando con el hub…"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מתחבר לרכזת…"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हब से जुड़ रहा है…"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключение к хабу…"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Inaunganisha na kitovu…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在连接中心节点…"
          }
        }
      }
    },
    "Devices": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الأجهزة"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dispositivos"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מכשירים"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डिवाइस"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Устройства"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Vifaa"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备"
          }
        }
      }
    },
    "Done.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hecho."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בוצע."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हो गया।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Готово."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Imekamilika."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完成。"
          }
        }
      }
    },
    "Freeze %@? It stays an admin in name, but nothing it signs counts until the root unfreezes it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تجميد %@؟ يبقى مشرفًا بالاسم، لكن لا يُحتسب أي شيء يوقّعه حتى يلغي الجذر تجميده."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Congelar %@? Sigue siendo administrador de nombre, pero nada de lo que firme cuenta hasta que la raíz lo descongele."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "להקפיא את %@? הוא נשאר מנהל בשם, אבל שום דבר שהוא חותם עליו לא נחשב עד שהשורש יפשיר אותו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ को फ़्रीज़ करें? वह नाम के लिए एडमिन रहता है, पर रूट के अनफ़्रीज़ करने तक उसके किसी हस्ताक्षर की गिनती नहीं होती।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заморозить %@? Он останется админом по имени, но ничего из подписанного им не будет действовать, пока корень его не разморозит."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Gandisha %@? Kinabaki msimamizi kwa jina, lakini hakuna kitu kinachotia sahihi kinachohesabika hadi mzizi ukifungue."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "冻结 %@？它名义上仍是管理员，但在根设备解冻它之前，它签署的任何内容都无效。"
          }
        }
      }
    },
    "Freeze this admin": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تجميد هذا المشرف"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Congelar este administrador"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקפאת המנהל הזה"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस एडमिन को फ़्रीज़ करें"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заморозить этого админа"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Gandisha msimamizi huyu"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "冻结此管理员"
          }
        }
      }
    },
    "Latest": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الأحدث"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo último"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "האחרון"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नवीनतम"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Последнее"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Karibuni zaidi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最新"
          }
        }
      }
    },
    "Off": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "متوقف"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivado"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כבוי"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बंद"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выключено"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimezimwa"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关"
          }
        }
      }
    },
    "Open CBB on the iPhone to make or join a group.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح CBB على الـ iPhone لإنشاء مجموعة أو الانضمام إليها."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre CBB en el iPhone para crear un grupo o unirte a uno."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פתחו את CBB ב-iPhone כדי ליצור קבוצה או להצטרף לאחת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समूह बनाने या उससे जुड़ने के लिए iPhone पर CBB खोलें।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте CBB на iPhone, чтобы создать группу или войти в неё."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Fungua CBB kwenye iPhone ili kuunda kikundi au kujiunga nacho."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 iPhone 上打开 CBB 以创建或加入群组。"
          }
        }
      }
    },
    "Open CBB on the iPhone, then try again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح CBB على الـ iPhone، ثم حاول مرة أخرى."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre CBB en el iPhone y vuelve a intentarlo."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פתחו את CBB ב-iPhone ונסו שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone पर CBB खोलें, फिर दोबारा कोशिश करें।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте CBB на iPhone и попробуйте снова."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Fungua CBB kwenye iPhone, kisha ujaribu tena."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 iPhone 上打开 CBB，然后重试。"
          }
        }
      }
    },
    "Remove %@ from the group?": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إزالة %@ من المجموعة؟"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Quitar %@ del grupo?"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "להסיר את %@ מהקבוצה?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ को समूह से हटाएँ?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить %@ из группы?"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Uondoe %@ kwenye kikundi?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从群组中移除 %@？"
          }
        }
      }
    },
    "Remove from the group": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إزالة من المجموعة"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quitar del grupo"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הסרה מהקבוצה"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समूह से हटाएँ"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить из группы"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ondoa kwenye kikundi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从群组中移除"
          }
        }
      }
    },
    "Run %@ on %@?": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تشغيل %@ على %@؟"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Ejecutar %@ en %@?"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "להפעיל את %@ ב-%@?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ पर %1$@ चलाएँ?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запустить %1$@ на %2$@?"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Uendeshe %@ kwenye %@?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 %2$@ 上运行 %1$@？"
          }
        }
      }
    },
    "Sign": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "توقيع"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Firmar"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חתימה"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हस्ताक्षर करें"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подписать"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Tia sahihi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "签名"
          }
        }
      }
    },
    "Sign the action with this watch's key": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "توقيع الإجراء بمفتاح هذه الساعة"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Firmar la acción con la clave de este reloj"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חתימה על הפעולה עם המפתח של השעון הזה"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस घड़ी की कुंजी से क्रिया पर हस्ताक्षर करें"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подписать действие ключом этих часов"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Tia sahihi kitendo kwa ufunguo wa saa hii"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用这块手表的密钥签署该操作"
          }
        }
      }
    },
    "The action was not signed. Keep the watch on your wrist, then try again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُوقَّع الإجراء. أبقِ الساعة على معصمك، ثم حاول مرة أخرى."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La acción no se firmó. Mantén el reloj en la muñeca y vuelve a intentarlo."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפעולה לא נחתמה. השאירו את השעון על פרק היד ונסו שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्रिया पर हस्ताक्षर नहीं हुए। घड़ी को कलाई पर रखें, फिर दोबारा कोशिश करें।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Действие не подписано. Не снимайте часы с руки и попробуйте снова."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kitendo hakikutiwa sahihi. Vaa saa kwenye kifundo cha mkono, kisha ujaribu tena."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "操作未签名。请将手表戴在手腕上，然后重试。"
          }
        }
      }
    },
    "The iPhone did not answer. Try again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُجب الـ iPhone. حاول مرة أخرى."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El iPhone no respondió. Vuelve a intentarlo."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ה-iPhone לא ענה. נסו שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone ने जवाब नहीं दिया। दोबारा कोशिश करें।"
