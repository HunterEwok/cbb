          "stringUnit": {
            "state": "translated",
            "value": "iPhone haikujibu. Jaribu tena."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone 没有响应。请重试。"
          }
        }
