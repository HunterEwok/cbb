{
  "apiType": "stageMode",
  "buildOption": {
    // libcbb_napi.so over the Rust core, which build.sh builds first.
    "externalNativeOptions": {
      "path": "./src/main/cpp/CMakeLists.txt",
      "arguments": "",
      "cppFlags": "",
      "abiFilters": ["arm64-v8a"]
    }
  },
  "buildOptionSet": [
    {
      "name": "release",
      "arkOptions": {
        "obfuscation": { "ruleOptions": { "enable": false } }
      }
    }
  ],
  "targets": [{ "name": "default" }, { "name": "ohosTest" }]
}
