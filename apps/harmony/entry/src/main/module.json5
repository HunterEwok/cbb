{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "EntryAbility",
    "deviceTypes": ["phone", "tablet"],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    "abilities": [
      {
        "name": "EntryAbility",
        "srcEntry": "./ets/entryability/EntryAbility.ets",
        "description": "$string:ability_desc",
        "icon": "$media:icon",
        "label": "$string:app_name",
        "startWindowIcon": "$media:icon",
        "startWindowBackground": "$color:start_window_background",
        "exported": true,
        // The member runs on in the background (EntryAbility, keepRunning).
        "backgroundModes": ["multiDeviceConnection"],
        // The app icon's long-press menu: Sync clipboard (EntryAbility's
        // quick actions).
        "metadata": [{ "name": "ohos.ability.shortcuts", "resource": "$profile:shortcuts_config" }],
        "skills": [
          {
            "entities": ["entity.system.home"],
            "actions": ["action.system.home"]
          }
        ]
      }
    ],
    // The home-screen widget "Sync clipboard" (common/Widgets.ets) and the
    // Share menu.
    "extensionAbilities": [
      {
        "name": "EntryFormAbility",
        "srcEntry": "./ets/entryformability/EntryFormAbility.ets",
        "label": "$string:widget_name",
        "description": "$string:widget_description",
        "type": "form",
        "metadata": [{ "name": "ohos.extension.form", "resource": "$profile:form_config" }]
      },
      // CBB in the Share menu: a text, images or files shared to it go to
      // the group as a copy of this phone, without opening the app
      // (shareextability/ShareExtAbility.ets).
      {
        "name": "ShareExtAbility",
        "srcEntry": "./ets/shareextability/ShareExtAbility.ets",
        "label": "$string:app_name",
        "description": "$string:ability_desc",
        "icon": "$media:icon",
        "type": "share",
        "exported": true,
        "skills": [
          {
            "actions": ["ohos.want.action.sendData"],
            "uris": [
              { "scheme": "file", "utd": "general.text", "maxFileSupported": 1 },
              { "scheme": "file", "utd": "general.image", "maxFileSupported": 20 },
              { "scheme": "file", "utd": "general.file", "maxFileSupported": 20 }
            ]
          }
        ]
      }
    ],
    // The watch's CBB, which Wear Engine lets this app talk to (common/Wear.ets);
    // Wear Engine also wants the app's client_id from AppGallery Connect here,
    // added with the signing config (docs/apps.md, "HarmonyOS watches").
    "metadata": [
      { "name": "wearEngineRemoteAppNameList", "value": "tools.cbb.harmony" }
    ],
    "requestPermissions": [
      // The member's connections on the home network and to the hub.
      { "name": "ohos.permission.INTERNET" },
      { "name": "ohos.permission.GET_NETWORK_INFO" },
      { "name": "ohos.permission.GET_WIFI_INFO" },
      // The member as a continuous task in the background.
      { "name": "ohos.permission.KEEP_BACKGROUND_RUNNING" },
      // The YubiKey with the group's recovery key, over NFC (common/YubiKey.ets).
      { "name": "ohos.permission.NFC_TAG" },
      // The face, fingerprint or PIN before each signature of the admin key.
      {
        "name": "ohos.permission.ACCESS_BIOMETRIC",
        "reason": "$string:reason_biometric",
        "usedScene": { "abilities": ["EntryAbility"], "when": "inuse" }
      },
      // The lab's Bluetooth keyboard, asked for when the user turns it on.
      {
        "name": "ohos.permission.ACCESS_BLUETOOTH",
        "reason": "$string:reason_bluetooth",
        "usedScene": { "abilities": ["EntryAbility"], "when": "always" }
      }
    ]
  }
}
