// The app for HarmonyOS 5 and later (docs/apps.md). Signing configs are the
// developer's own, from AppGallery Connect, and stay out of git: DevEco
// Studio adds them to this file's signingConfigs on the developer's computer.
{
  "app": {
    "signingConfigs": [],
    "products": [
      {
        "name": "default",
        "signingConfig": "default",
        "compatibleSdkVersion": "5.0.0(12)",
        "runtimeOS": "HarmonyOS",
        "buildOption": {
          "strictMode": { "caseSensitiveCheck": true, "useNormalizedOHMUrl": true }
        }
      }
    ],
    "buildModeSet": [{ "name": "debug" }, { "name": "release" }]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [{ "name": "default", "applyToProducts": ["default"] }]
    },
    // The watch's module (docs/apps.md, "HarmonyOS watches").
    {
      "name": "wearable",
      "srcPath": "./wearable",
      "targets": [{ "name": "default", "applyToProducts": ["default"] }]
    }
  ]
}
