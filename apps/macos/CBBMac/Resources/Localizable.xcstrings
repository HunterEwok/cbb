    "Leave the group": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مغادرة المجموعة"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abandonar el grupo"
          }
        },
        "he": {
          "stringUnit": {
