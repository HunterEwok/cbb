    },
    "This device's rights as a trusted device are paused.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صلاحيات هذا الجهاز كجهاز موثوق موقوفة مؤقتًا."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los derechos de este dispositivo como dispositivo de confianza están en pausa."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ההרשאות של המכשיר הזה כמכשיר מהימן מושהות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "भरोसेमंद डिवाइस के रूप में इस डिवाइस के अधिकार रोके गए हैं।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Права доверенного устройства у этого устройства приостановлены."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Haki za kifaa hiki kama kifaa kinachoaminika zimesitishwa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备作为受信任设备的权限已暂停。"
          }
        }
      }
    },
    "This is my home network": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه شبكة منزلي"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es mi red de casa"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "זו הרשת הביתית שלי"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह मेरा घरेलू नेटवर्क है"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это моя домашняя сеть"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Huu ni mtandao wangu wa nyumbani"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是我的家庭网络"
          }
        }
      }
    },
    "This is the group's hub": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا محور المجموعة"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este es el hub del grupo"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "זו הרכזת של הקבוצה"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह समूह का हब है"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это хаб группы"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiki ndicho kitovu cha kikundi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是群组的中心节点"
          }
        }
      }
    },
    "This is the group's only device.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا هو الجهاز الوحيد في المجموعة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este es el único dispositivo del grupo."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "זה המכשיר היחיד בקבוצה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह समूह का अकेला डिवाइस है।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это единственное устройство группы."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiki ndicho kifaa pekee cha kikundi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是群组中唯一的设备。"
          }
        }
      }
    },
    "This network counts as home now.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُعدّ هذه الشبكة الآن شبكة المنزل."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta red cuenta ahora como la de casa."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הרשת הזו נחשבת עכשיו לרשת הבית."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह नेटवर्क अब घरेलू माना जाता है।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Теперь эта сеть считается домашней."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Mtandao huu sasa unahesabiwa kuwa wa nyumbani."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此网络现在算作家庭网络。"
          }
        }
      }
    },
    "This network may block tunnels: turn on Strict networks on the base.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قد تحجب هذه الشبكة الأنفاق: فعّل «الشبكات الصارمة» على القاعدة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta red puede bloquear túneles: activa Redes estrictas en la base."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ייתכן שהרשת הזו חוסמת מנהרות: הפעילו ״רשתות מחמירות״ בבסיס."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह नेटवर्क सुरंगें रोक सकता है: बेस पर सख़्त नेटवर्क चालू करें।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта сеть может резать туннели: включите «Строгие сети» на базе."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Mtandao huu unaweza kuzuia mahandaki: washa Mitandao mikali kwenye kituo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此网络可能会阻止隧道：请在主站上打开“严格网络”。"
          }
        }
      }
    },
    "Tiles": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مربعات"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mosaicos"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אריחים"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टाइलें"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Плитки"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Vigae"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "磁贴"
          }
        }
      }
    },
    "Turn Everywhere on?": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تشغيل «في كل مكان»؟"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Activar En todas partes?"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "להפעיל את ״בכל מקום״?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर जगह चालू करें?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включить «Везде»?"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Uwashe Kila mahali?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启“随处”？"
          }
        }
      }
    },
    "Turn on": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تشغيل"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activar"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפעלה"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चालू करें"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включить"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Washa"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启"
          }
        }
      }
    },
    "Turn on Everywhere to sync away from home.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شغّل «في كل مكان» للمزامنة خارج المنزل."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa En todas partes para sincronizar fuera de casa."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפעילו את ״בכל מקום״ כדי לסנכרן מחוץ לבית."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "घर से बाहर सिंक करने के लिए हर जगह चालू करें।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите «Везде», чтобы синхронизироваться вне дома."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Washa Kila mahali ili kusawazisha ukiwa mbali na nyumbani."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开“随处”，以便在家以外同步。"
          }
        }
      }
    },
    "Turn on another device of the group.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شغّل جهازًا آخر من المجموعة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enciende otro dispositivo del grupo."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפעילו מכשיר אחר של הקבוצה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समूह का कोई दूसरा डिवाइस चालू करें।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите другое устройство группы."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Washa kifaa kingine cha kikundi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开群组中的另一台设备。"
          }
        }
      }
    },
    "Turn sync away from home on?": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تشغيل المزامنة بعيدًا عن المنزل؟"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Activar la sincronización fuera de casa?"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "להפעיל סנכרון מחוץ לבית?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "घर से दूर सिंक चालू करें?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включить синхронизацию вне дома?"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Uwashe kusawazisha ukiwa mbali na nyumbani?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启离家同步？"
          }
        }
      }
    },
    "Turn sync off": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إيقاف المزامنة"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivar la sincronización"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כיבוי הסנכרון"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिंक बंद करें"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выключить синхронизацию"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Zima usawazishaji"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭同步"
          }
        }
      }
    },
    "Turn sync on.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شغّل المزامنة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa la sincronización."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפעילו את הסנכרון."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिंक चालू करें।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите синхронизацию."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Washa usawazishaji."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开同步。"
          }
        }
      }
    },
    "Two claims to take the group over: %@. The root cancels one or both by removing its admin.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مطالبتان بتولّي المجموعة: %@. يلغي الجذر واحدة أو كلتيهما بإزالة مشرفها."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dos reclamaciones para tomar el grupo: %@. La raíz cancela una o ambas quitando a su administrador."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שתי תביעות להשתלט על הקבוצה: %@. השורש מבטל אחת או את שתיהן בהסרת המנהל שלהן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समूह अपने हाथ में लेने के दो दावे: %@। रूट उनके एडमिन को हटाकर एक या दोनों रद्द कर देता है।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Две заявки на передачу группы: %@. Корень отменяет одну или обе, удаляя админа."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Madai mawili ya kuchukua kikundi: %@. Mzizi hughairi moja au yote kwa kumwondoa msimamizi wake."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有两个接管群组的声明：%@。根设备可通过移除其管理员来取消其中一个或两个。"
          }
        }
      }
    },
    "Type": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "النوع"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tipo"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סוג"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रकार"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тип"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Aina"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "类型"
          }
        }
      }
    },
    "Type the key from the sheet, or paste its QR code's text. The claim waits as a takeover does.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اكتب المفتاح من الورقة، أو الصق نص رمز QR الخاص بها. تنتظر المطالبة كما ينتظر التولّي."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe la clave de la hoja, o pega el texto de su código QR. La reclamación espera igual que una toma."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקלידו את המפתח מהדף, או הדביקו את הטקסט של קוד ה-QR שלו. התביעה ממתינה כמו השתלטות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शीट से कुंजी लिखें, या उसके QR कोड का टेक्स्ट पेस्ट करें। दावा टेकओवर की तरह प्रतीक्षा करता है।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите ключ с листа или вставьте текст его QR-кода. Заявка ждёт, как при передаче группы."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Andika ufunguo kutoka kwenye karatasi, au bandika maandishi ya msimbo wake wa QR. Dai husubiri kama uchukuaji unavyosubiri."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入恢复单上的密钥，或粘贴其二维码的文本。声明会像接管一样等待。"
          }
        }
      }
    },
    "Type the six digits the new device shows.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اكتب الأرقام الستة التي يعرضها الجهاز الجديد."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe los seis dígitos que muestra el dispositivo nuevo."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקלידו את שש הספרות שהמכשיר החדש מציג."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नए डिवाइस पर दिखने वाले छह अंक लिखें।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите шесть цифр, которые показывает новое устройство."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Andika tarakimu sita zinazoonyeshwa na kifaa kipya."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入新设备显示的六位数字。"
          }
        }
      }
    },
    "Unfreeze": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إلغاء التجميد"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descongelar"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפשרה"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अनफ़्रीज़ करें"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разморозить"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Fungua ugandishaji"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "解冻"
          }
        }
      }
    },
    "Unfreeze %@?": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إلغاء تجميد %@؟"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Descongelar %@?"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "להפשיר את %@?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ को अनफ़्रीज़ करें?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разморозить %@?"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ufungue ugandishaji wa %@?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "解冻 %@？"
          }
        }
      }
    },
    "Unfreeze it only if it is in safe hands; otherwise remove it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ألغِ تجميده فقط إذا كان في أيدٍ أمينة؛ وإلا فأزله."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descongélalo solo si está en buenas manos; si no, quítalo."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפשירו אותו רק אם הוא בידיים בטוחות; אחרת הסירו אותו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसे केवल तभी अनफ़्रीज़ करें जब यह सुरक्षित हाथों में हो; वरना इसे हटा दें।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Размораживайте, только если он в надёжных руках; иначе удалите его."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kifungue tu ikiwa kiko mikononi salama; vinginevyo kiondoe."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有在它处于安全的人手中时才解冻；否则请移除它。"
          }
        }
      }
    },
    "Unfrozen.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أُلغي التجميد."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descongelado."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הופשר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अनफ़्रीज़ किया गया।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разморожено."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ugandishaji umefunguliwa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已解冻。"
          }
        }
      }
    },
    "Ungroup": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فك التجميع"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desagrupar"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פירוק קבוצה"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समूह से अलग करें"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разгруппировать"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenganisha"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消分组"
          }
        }
      }
    },
    "Unmute": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إلغاء الكتم"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quitar silencio"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ביטול השתקה"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अनम्यूट करें"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включить"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ondoa unyamazishaji"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消静音"
          }
        }
      }
    },
    "Unmute it from a trusted device of the group.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ألغِ كتمه من جهاز موثوق في المجموعة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quítale el silencio desde un dispositivo de confianza del grupo."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בטלו את ההשתקה שלו ממכשיר מהימן של הקבוצה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समूह के किसी भरोसेमंद डिवाइस से इसे अनम्यूट करें।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Снимите заглушение с доверенного устройства группы."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ondoa unyamazishaji wake kutoka kifaa kinachoaminika cha kikundi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在群组的受信任设备上取消它的静音。"
          }
        }
      }
    },
    "Unmuted: its copies reach the group again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أُلغي الكتم: تصل نسخه إلى المجموعة مرة أخرى."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin silencio: sus copias vuelven a llegar al grupo."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ההשתקה בוטלה: ההעתקות שלו מגיעות שוב לקבוצה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अनम्यूट: इसकी कॉपी फिर से समूह तक पहुँचती हैं।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Звук включён: его копии снова доходят до группы."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Unyamazishaji umeondolewa: nakala zake zinafika kwenye kikundi tena."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已取消静音：它的副本重新到达群组。"
          }
        }
      }
    },
    "Until I turn it on": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حتى أشغّلها"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasta que lo active"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עד שאפעיל"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब तक मैं चालू न करूँ"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока не включу"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hadi nitakapowasha"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "直到我开启"
          }
        }
      }
    },
    "Until an admin unmutes it": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حتى يلغي مشرف كتمه"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasta que un administrador le quite el silencio"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עד שמנהל יבטל את ההשתקה"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब तक कोई एडमिन अनम्यूट न करे"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока админ не включит"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hadi msimamizi akiondolee unyamazishaji"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "直到管理员取消静音"
          }
        }
      }
    },
    "Update CBB on a computer of the group.": {
