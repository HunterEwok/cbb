            "state": "translated",
            "value": "На 15 минут"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kwa dakika 15"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "15 分钟"
          }
        }
      }
    },
    "For 8 hours": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لمدة 8 ساعات"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Durante 8 horas"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "למשך 8 שעות"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "8 घंटे के लिए"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На 8 часов"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kwa saa 8"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "8 小时"
          }
        }
      }
    },
    "For a stolen admin computer: it changes nothing more and the others refuse it until the root unfreezes or removes it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لحاسوب مشرف مسروق: لا يغيّر شيئًا بعد ذلك ويرفضه الآخرون حتى يلغي الجذر تجميده أو يزيله."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para un ordenador de administrador robado: ya no cambia nada y los demás lo rechazan hasta que la raíz lo descongele o lo quite."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "למחשב מנהל שנגנב: הוא לא משנה עוד דבר והאחרים דוחים אותו עד שהשורש יפשיר או יסיר אותו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चोरी हुए एडमिन कंप्यूटर के लिए: वह आगे कुछ नहीं बदलता और बाकी उसे तब तक ठुकराते हैं जब तक रूट उसे अनफ़्रीज़ न करे या हटा न दे।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для украденного админского компьютера: он больше ничего не меняет, и остальные отказываются с ним работать, пока создатель группы не разморозит или не удалит его."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kwa kompyuta ya msimamizi iliyoibiwa: haibadilishi chochote tena na vingine huikataa hadi mzizi uifungue au uiondoe."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于被盗的管理员电脑：它不能再更改任何内容，其他设备会拒绝它，直到根设备解冻或移除它。"
          }
        }
      }
    },
    "For an hour": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لمدة ساعة"
          }
        },
