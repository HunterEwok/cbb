    "Connect it at home to a trusted device of the group before then.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قبل ذلك، صِله في المنزل بجهاز موثوق في المجموعة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes de esa fecha, conéctalo en casa a un dispositivo de confianza del grupo."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לפני כן, חברו אותו בבית למכשיר מהימן של הקבוצה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उससे पहले इसे घर पर समूह के किसी भरोसेमंद डिवाइस से जोड़ें।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "До этого подключите его дома к доверенному устройству группы."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kabla ya hapo, kiunganishe nyumbani na kifaa kinachoaminika cha kikundi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在此之前，请在家中将它连接到群组的受信任设备。"
          }
        }
      }
    },
    "Connected, but no other device of the group is online.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "متصل، لكن لا يوجد جهاز آخر من المجموعة متصل."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectado, pero ningún otro dispositivo del grupo está en línea."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש חיבור, אבל אף מכשיר אחר בקבוצה לא מחובר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जुड़ा है, पर समूह का कोई दूसरा डिवाइस ऑनलाइन नहीं है।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Связь есть, но других устройств группы нет в сети."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Imeunganishwa, lakini hakuna kifaa kingine cha kikundi kilicho mtandaoni."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已连接，但群组中没有其他设备在线。"
          }
        }
      }
    },
