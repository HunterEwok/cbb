    "Show a QR code here and scan it with the phone app, or make a group of computers with cbb new.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اعرض رمز QR هنا وامسحه باستخدام تطبيق الهاتف، أو أنشئ مجموعة حواسيب باستخدام cbb new."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra aquí un código QR y escanéalo con la app del teléfono, o crea un grupo de ordenadores con cbb new."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הציגו כאן קוד QR וסרקו אותו עם יישום הטלפון, או צרו קבוצה של מחשבים עם cbb new."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यहाँ QR कोड दिखाएँ और उसे फ़ोन ऐप से स्कैन करें, या cbb new से कंप्यूटरों का समूह बनाएँ।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Покажите здесь QR-код и отсканируйте его приложением на телефоне или создайте группу компьютеров командой cbb new."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Onyesha msimbo wa QR hapa na uuchanganue kwa programu ya simu, au uunde kikundi cha kompyuta kwa cbb new."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在这里显示二维码并用手机应用扫描，或用 cbb new 创建电脑群组。"
          }
        }
      }
    },
    "Show error details": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
