    "Open a picture": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فتح صورة"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir una imagen"
