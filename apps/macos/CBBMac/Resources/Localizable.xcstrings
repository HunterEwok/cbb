          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "निमंत्रण का पाठ"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Текст приглашения"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
