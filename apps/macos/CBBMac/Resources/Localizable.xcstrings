        }
      }
    },
    "Forwarder": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مُعيد التوجيه"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reenviador"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מעביר"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ॉरवर्डर"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Форвардер"
          }
        },
