    "Ask the group's owner to restore its rights.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اطلب من مالك المجموعة إعادة صلاحياته."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pide al propietario del grupo que le devuelva sus derechos."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בקשו מהבעלים של הקבוצה להחזיר לו את ההרשאות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समूह के स्वामी से इसके अधिकार लौटाने को कहें।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Попросите владельца группы вернуть ему права."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Omba mmiliki wa kikundi arejeshe haki zake."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请群组的所有者恢复它的权限。"
          }
        }
      }
    },
    "Away from home": {
      "localizations": {
