    "Make a computer at home the base, in its advanced settings.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اجعل حاسوبًا في المنزل قاعدةً من إعداداته المتقدمة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz que un ordenador de casa sea la base, en su configuración avanzada."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפכו מחשב בבית לבסיס, בהגדרות המתקדמות שלו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "घर के किसी कंप्यूटर को उसकी उन्नत सेटिंग्स में बेस बनाएँ।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сделайте домашний компьютер базой в его расширенных настройках."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Fanya kompyuta ya nyumbani kuwa kituo, kwenye mipangilio yake ya hali ya juu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在家中某台电脑的高级设置中，将它设为主站。"
          }
        }
      }
    },
