        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройки хаба сохранены."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Mipangilio ya kitovu imehifadhiwa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "中心节点的设置已保存。"
          }
        }
      }
    },
    "The invitation is valid until %@.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الدعوة صالحة حتى %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La invitación es válida hasta las %@."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ההזמנה בתוקף עד %@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "निमंत्रण %@ तक मान्य है।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приглашение действует до %@."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Mwaliko ni halali hadi %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "邀请在 %@ 之前有效。"
          }
        }
      }
    },
    "The invitation's QR code": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رمز QR الخاص بالدعوة"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El código QR de la invitación"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קוד ה-QR של ההזמנה"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "निमंत्रण का QR कोड"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "QR-код приглашения"
          }
        },
        "sw": {
          "stringUnit": {
