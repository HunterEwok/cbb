      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Коралл"
          }
        }
      }
    },
    "Dark": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тёмная"
          }
        }
      }
    },
