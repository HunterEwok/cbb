          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "CBB %@ está disponible."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "CBB %@ זמין."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "CBB %@ उपलब्ध है।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступна CBB %@."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "CBB %@ inapatikana."
          }
        },
        "zh-Hans": {
          "stringUnit": {
