        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Rudi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "返回"
          }
        }
      }
    },
    "Back to the group's order": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "العودة إلى ترتيب المجموعة"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Volver al orden del grupo"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חזרה לסדר של הקבוצה"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समूह के क्रम पर वापस"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вернуть порядок группы"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Rudi kwenye mpangilio wa kikundi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复群组的顺序"
          }
        }
      }
    },
    "Board": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لوحة إلكترونية"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Placa"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לוח פיתוח"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बोर्ड"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Плата"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Bodi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开发板"
          }
        }
      }
    },
    "Both histories are void. The device signs its records again by itself.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كلا السجلّين باطل. يوقّع الجهاز سجلاته من جديد بنفسه."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ambos historiales quedan anulados. El dispositivo vuelve a firmar sus registros por sí mismo."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שתי ההיסטוריות בטלות. המכשיר חותם מחדש על הרשומות שלו בעצמו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दोनों इतिहास रद्द हैं। डिवाइस अपने रिकॉर्ड खुद फिर से हस्ताक्षरित करता है।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обе истории отменены. Устройство само подпишет свои записи заново."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Historia zote mbili ni batili. Kifaa hutia sahihi rekodi zake upya chenyewe."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两段历史都作废。设备会自行重新签署它的记录。"
          }
        }
      }
    },
    "Bring it home to a trusted device of the group, which renews the certificate.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صِله في المنزل بجهاز موثوق في المجموعة، فيجدّد الشهادة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conéctalo en casa a un dispositivo de confianza del grupo, que renueva el certificado."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חברו אותו בבית למכשיר מהימן של הקבוצה, והוא יחדש את התעודה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसे घर पर समूह के किसी भरोसेमंद डिवाइस से जोड़ें, वह प्रमाणपत्र नवीनीकृत करेगा।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключите его дома к доверенному устройству группы: оно продлит сертификат."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiunganishe nyumbani na kifaa kinachoaminika cha kikundi, nacho kitafanya upya cheti."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在家中将它连接到群组的受信任设备：该设备会续订证书。"
          }
        }
      }
    },
