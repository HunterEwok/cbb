    "Device far away? Send an invitation": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الجهاز بعيد؟ أرسل دعوة"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿El dispositivo está lejos? Envía una invitación"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המכשיר רחוק? שלחו הזמנה"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डिवाइस दूर है? आमंत्रण भेजें"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Устройство далеко? Отправить приглашение"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kifaa kiko mbali? Tuma mwaliko"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备在远处？发送邀请"
          }
        }
      }
    },
    "Devices at home cannot connect to this one: %@.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تستطيع الأجهزة في المنزل الاتصال بهذا الجهاز: %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los dispositivos de casa no pueden conectarse a este: %@."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מכשירים בבית לא מצליחים להתחבר למכשיר הזה: %@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "घर के डिवाइस इससे नहीं जुड़ पा रहे: %@।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Устройства дома не могут подключиться к этому: %@."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Vifaa vya nyumbani haviwezi kuunganishwa na hiki: %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "家中的设备无法连接到此设备：%@。"
          }
        }
      }
    },
    "Devices away from home may not reach it; CBB tries again by itself.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قد لا تصل إليه الأجهزة خارج المنزل؛ يعيد CBB المحاولة تلقائيًا."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los dispositivos fuera de casa podrían no alcanzarlo; CBB lo intenta de nuevo solo."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ייתכן שמכשירים מחוץ לבית לא יגיעו אליה; CBB ינסה שוב בעצמו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "घर से बाहर के डिवाइस शायद इस तक न पहुँचें; CBB खुद फिर कोशिश करता है।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Устройства вне дома могут до него не дойти; CBB попробует снова сам."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Vifaa vilivyo mbali na nyumbani huenda visikifikie; CBB hujaribu tena yenyewe."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在家以外的设备可能无法连接到它；CBB 会自动重试。"
          }
        }
      }
    },
