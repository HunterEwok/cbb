            "state": "translated",
            "value": "添加设备"
          }
        }
      }
    },
    "Add a phone or a computer.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف هاتفًا أو حاسوبًا."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade un teléfono o un ordenador."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הוסיפו טלפון או מחשב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई फ़ोन या कंप्यूटर जोड़ें।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте телефон или компьютер."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ongeza simu au kompyuta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加一部手机或一台电脑。"
          }
        }
      }
    },
    "Add one with the + button.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف واحدًا بالزر +."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade uno con el botón +."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הוסיפו אחד בכפתור +."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "+ बटन से एक जोड़ें।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте устройство кнопкой +."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ongeza kimoja kwa kitufe cha +."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用 + 按钮添加一个。"
          }
        }
      }
    },
    "Admins removed or froze each other without seeing it: %@. The root removes one of them.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أزال مشرفون بعضهم بعضًا أو جمّدوا بعضهم دون أن يروا ذلك: %@. يزيل الجذر أحدهم."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Unos administradores se eliminaron o congelaron entre sí sin verlo: %@. La raíz elimina a uno de ellos."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מנהלים הסירו או הקפיאו זה את זה בלי לראות: %@. השורש מסיר אחד מהם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एडमिन ने बिना देखे एक-दूसरे को हटाया या फ़्रीज़ किया: %@। रूट उनमें से एक को हटाता है।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Админы удалили или заморозили друг друга, не зная об этом: %@. Корень удаляет одного из них."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Wasimamizi waliondoana au kugandishana bila kuona: %@. Mzizi humwondoa mmoja wao."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有管理员在互不知情的情况下互相移除或冻结：%@。由根设备移除其中一个。"
          }
        }
      }
    },
    "Admit": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قبول"
          }
        },
        "es": {
