    "Muted until an admin unmutes it": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مكتوم حتى يلغي مشرف كتمه"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Silenciado hasta que un administrador le quite el silencio"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מושתק עד שמנהל יבטל את ההשתקה"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी एडमिन के अनम्यूट करने तक म्यूट"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заглушено, пока админ не включит"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimenyamazishwa hadi msimamizi akiondolee"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已静音，直到管理员取消静音"
          }
        }
      }
    },
