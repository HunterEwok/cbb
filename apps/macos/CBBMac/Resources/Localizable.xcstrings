    "This device is never a hub.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الجهاز لا يكون محورًا أبدًا."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo nunca es un hub."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מכשיר זה אף פעם אינו רכזת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह डिवाइस कभी हब नहीं होता।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это устройство не бывает хабом."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kifaa hiki kamwe si kitovu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备从不担任中心节点。"
          }
        }
      }
    },
    "This device is the base, and no device has connected yet.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الجهاز هو القاعدة، ولم يتصل به أي جهاز بعد."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo es la base y aún no se ha conectado ningún dispositivo."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המכשיר הזה הוא הבסיס, ועוד אף מכשיר לא התחבר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह डिवाइस बेस है, और अभी तक कोई डिवाइस नहीं जुड़ा।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это устройство — база, и к нему ещё никто не подключился."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kifaa hiki ndicho kituo, na bado hakuna kifaa kilichounganishwa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备是主站，但尚无设备连接。"
          }
        }
      }
    },
    "This device was removed from the group.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أُزيل هذا الجهاز من المجموعة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo se quitó del grupo."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המכשיר הזה הוסר מהקבוצה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह डिवाइस समूह से हटा दिया गया।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это устройство удалено из группы."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kifaa hiki kiliondolewa kwenye kikundi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备已被移出群组。"
          }
        }
      }
    },
    "This device's certificate ended on %@.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهت شهادة هذا الجهاز في %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El certificado de este dispositivo venció el %@."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התעודה של המכשיר הזה פגה ב־%@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस डिवाइस का प्रमाणपत्र %@ को समाप्त हो गया।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сертификат этого устройства истёк %@."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Cheti cha kifaa hiki kiliisha %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备的证书已于 %@ 到期。"
          }
        }
      }
    },
    "This device's certificate ends on %@.": {
      "localizations": {
