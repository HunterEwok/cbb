    "Muted: its copies do not reach the group.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مكتوم: نسخه لا تصل إلى المجموعة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Silenciado: sus copias no llegan al grupo."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מושתק: ההעתקות שלו לא מגיעות לקבוצה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "म्यूट: इसकी कॉपी समूह तक नहीं पहुँचतीं।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заглушено: его копии не доходят до группы."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimenyamazishwa: nakala zake hazifiki kwenye kikundi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已静音：它的副本不会到达群组。"
          }
        }
      }
    },
