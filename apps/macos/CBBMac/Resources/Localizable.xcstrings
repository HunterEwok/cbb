    "No QR code was found in the picture.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُعثر على رمز QR في الصورة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontró ningún código QR en la imagen."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא נמצא קוד QR בתמונה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चित्र में कोई QR कोड नहीं मिला।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На снимке не найден QR-код."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hakuna msimbo wa QR uliopatikana kwenye picha."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图片中未找到二维码。"
          }
        }
      }
    },
    "No device of the group is on this network.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد أي جهاز من المجموعة على هذه الشبكة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay ningún dispositivo del grupo en esta red."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אף מכשיר של הקבוצה לא נמצא ברשת הזו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस नेटवर्क पर समूह का कोई डिवाइस नहीं है।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В этой сети нет устройств группы."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hakuna kifaa cha kikundi kwenye mtandao huu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此网络中没有群组的设备。"
          }
        }
      }
    },
    "No devices match.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد أجهزة مطابقة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ningún dispositivo coincide."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין מכשירים תואמים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई डिवाइस मेल नहीं खाता।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подходящих устройств нет."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hakuna vifaa vinavyolingana."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有匹配的设备。"
          }
        }
      }
    },
    "No other devices yet": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد أجهزة أخرى بعد"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay otros dispositivos"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עדיין אין מכשירים אחרים"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी कोई दूसरा डिवाइस नहीं"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Других устройств пока нет"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Bado hakuna vifaa vingine"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有其他设备"
          }
        }
      }
    },
    "No permission to use the service: add your user to the _cbb group and log in again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا إذن باستخدام الخدمة: أضف مستخدمك إلى المجموعة _cbb وسجّل الدخول مرة أخرى."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin permiso para usar el servicio: añade tu usuario al grupo _cbb y vuelve a iniciar sesión."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין הרשאה להשתמש בשירות: הוסיפו את המשתמש שלכם לקבוצה ‎_cbb והתחברו מחדש."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सेवा इस्तेमाल करने की अनुमति नहीं: अपने उपयोगकर्ता को _cbb समूह में जोड़ें और फिर से लॉग इन करें।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет прав на работу со службой: добавьте своего пользователя в группу _cbb и войдите заново."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hakuna ruhusa ya kutumia huduma: ongeza mtumiaji wako kwenye kikundi _cbb na uingie tena."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无权使用该服务：将你的用户添加到 _cbb 组并重新登录。"
          }
        }
      }
    },
