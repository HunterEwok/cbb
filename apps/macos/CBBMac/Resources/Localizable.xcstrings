          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Dai kikundi kwa ufunguo wake wa urejeshaji"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用恢复密钥申领群组"
          }
        }
      }
    },
    "Click to turn sync off or on; open the menu for a time": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقر لإيقاف المزامنة أو تشغيلها؛ افتح القائمة لاختيار مدة"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic para desactivar o activar la sincronización; abre el menú para elegir un tiempo"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לחצו כדי לכבות או להפעיל סנכרון; פתחו את התפריט לבחירת זמן"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिंक बंद या चालू करने के लिए क्लिक करें; समय चुनने के लिए मेनू खोलें"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите, чтобы выключить или включить синхронизацию; в меню можно выбрать время"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Bofya kuzima au kuwasha usawazishaji; fungua menyu kwa muda"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按以关闭或打开同步；打开菜单可选择时长"
          }
        }
      }
    },
