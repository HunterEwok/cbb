    "Sync away from home is off.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المزامنة بعيدًا عن المنزل متوقفة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sincronización fuera de casa está desactivada."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הסנכרון מחוץ לבית כבוי."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "घर से दूर सिंक बंद है।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Синхронизация вне дома выключена."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kusawazisha ukiwa mbali na nyumbani kumezimwa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "离家同步已关闭。"
          }
        }
      }
    },
