        }
      }
    },
    "Check that the base is on and online.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تأكد من أن القاعدة تعمل ومتصلة بالشبكة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba que la base está encendida y conectada."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ודאו שהבסיס דולק ומחובר לרשת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जाँचें कि बेस चालू है और ऑनलाइन है।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверьте, что база включена и в сети."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hakikisha kituo kimewashwa na kiko mtandaoni."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请确认主站已开机并联网。"
          }
        }
      }
    },
    "Check that the other devices have Everywhere on.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تأكد من تفعيل «في كل مكان» على الأجهزة الأخرى."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba que los otros dispositivos tienen activado En todas partes."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ודאו שבמכשירים האחרים ״בכל מקום״ מופעל."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जाँचें कि दूसरे डिवाइसों पर हर जगह चालू है।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверьте, что на других устройствах включено «Везде»."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hakikisha vifaa vingine vimewasha Kila mahali."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请确认其他设备已打开“随处”。"
          }
        }
      }
    },
    "Check the internet connection; CBB tries again by itself.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحقق من الاتصال بالإنترنت؛ يعيد CBB المحاولة تلقائيًا."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba la conexión a internet; CBB lo intenta de nuevo solo."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בדקו את החיבור לאינטרנט; CBB ינסה שוב בעצמו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इंटरनेट कनेक्शन जाँचें; CBB खुद फिर कोशिश करता है।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверьте подключение к интернету; CBB попробует снова сам."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Angalia muunganisho wa intaneti; CBB hujaribu tena yenyewe."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请检查网络连接；CBB 会自动重试。"
          }
        }
      }
    },
    "Claim": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مطالبة"
          }
        },
        "es": {
