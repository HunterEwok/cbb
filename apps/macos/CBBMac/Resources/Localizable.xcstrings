          }
        }
      }
    },
    "Admit by QR code": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "القبول برمز QR"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Admitir por código QR"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קבלה בקוד QR"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "QR कोड से शामिल करें"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Принять по QR-коду"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kubali kwa msimbo wa QR"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过二维码接纳"
          }
        }
      }
    },
    "Admit it as an admin: it may then add, remove and renew devices and take the group over after the takeover delay. Only for your own phone.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اقبله مشرفًا: يمكنه حينها إضافة الأجهزة وإزالتها وتجديدها والاستيلاء على المجموعة بعد مهلة الاستيلاء. لهاتفك أنت فقط."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Admitirlo como administrador: podrá añadir, eliminar y renovar dispositivos y tomar el grupo tras el plazo de toma de control. Solo para tu propio teléfono."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קבלה כמנהל: הוא יוכל להוסיף, להסיר ולחדש מכשירים ולהשתלט על הקבוצה אחרי זמן ההשתלטות. רק לטלפון שלכם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसे एडमिन के रूप में शामिल करें: तब यह डिवाइस जोड़, हटा और नवीनीकृत कर सकेगा और टेकओवर की देरी के बाद समूह ले सकेगा। केवल अपने फ़ोन के लिए।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Принять как админа: он сможет добавлять, удалять и продлевать устройства и после задержки забрать группу себе. Только для своего телефона."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kikubali kama msimamizi: kitaweza kuongeza, kuondoa na kusasisha vifaa na kuchukua kikundi baada ya muda wa kuchukua. Kwa simu yako mwenyewe tu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "作为管理员接纳：之后它可以添加、移除和续期设备，并在接管等待期后接管群组。仅限你自己的手机。"
          }
        }
      }
    },
    "Admit it as an admin: only for your own phone.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
