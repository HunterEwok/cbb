          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "邀请文本"
          }
        }
      }
    },
    "The key cbb forward prints": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المفتاح الذي يطبعه cbb forward"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La clave que imprime cbb forward"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המפתח ש-cbb forward מדפיס"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वह कुंजी जो cbb forward छापता है"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключ, который печатает cbb forward"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ufunguo ambao cbb forward huchapisha"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "cbb forward 打印的密钥"
          }
        }
      }
    },
    "The list of the connection servers' entry points is out of date.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قائمة نقاط الدخول لخوادم الاتصال قديمة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La lista de puntos de entrada de los servidores de conexión está desactualizada."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "רשימת נקודות הכניסה של שרתי החיבור לא עדכנית."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कनेक्शन सर्वरों के प्रवेश बिंदुओं की सूची पुरानी है।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Список точек входа серверов связи устарел."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Orodha ya vituo vya kuingia vya seva za muunganisho imepitwa na wakati."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接服务器的入口列表已过期。"
          }
        }
      }
    },
    "The list of the project's entry points is out of date, and the forwarder does not answer on the ways this Mac knows. Update CBB on a computer of the group, or import a new list there with cbb global entries import; the group passes it on.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قائمة نقاط دخول المشروع قديمة، ولا يُجيب مُعيد التوجيه على الطرق التي يعرفها هذا الـ Mac. حدّث CBB على حاسوب من المجموعة، أو استورد قائمة جديدة هناك باستخدام cbb global entries import؛ وتنقلها المجموعة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La lista de puntos de entrada del proyecto está desactualizada, y el reenviador no responde por las vías que conoce este Mac. Actualiza CBB en un ordenador del grupo, o importa allí una lista nueva con cbb global entries import; el grupo la transmite."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "רשימת נקודות הכניסה של הפרויקט מיושנת, והמעביר לא עונה בדרכים שה-Mac הזה מכיר. עדכנו את CBB במחשב של הקבוצה, או ייבאו שם רשימה חדשה עם cbb global entries import; הקבוצה מעבירה אותה הלאה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रोजेक्ट के प्रवेश बिंदुओं की सूची पुरानी है, और फ़ॉरवर्डर उन तरीकों पर जवाब नहीं देता जिन्हें यह Mac जानता है। समूह के किसी कंप्यूटर पर CBB अपडेट करें, या वहाँ cbb global entries import से नई सूची आयात करें; समूह उसे आगे पहुँचा देता है।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Список точек входа проекта устарел, а форвардер не отвечает ни одним путём, известным этому Mac. Обновите CBB на компьютере группы или импортируйте там новый список командой cbb global entries import: группа передаст его дальше."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Orodha ya milango ya kuingilia ya mradi imepitwa na wakati, na kisambazaji hakijibu kwa njia ambazo Mac hii inazijua. Sasisha CBB kwenye kompyuta ya kikundi, au ingiza orodha mpya huko kwa cbb global entries import; kikundi huipitisha."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "项目的入口列表已过期，转发器在这台 Mac 已知的方式上都没有响应。请在群组的电脑上更新 CBB，或在那里用 cbb global entries import 导入新列表；群组会将其传递下去。"
          }
        }
      }
    },
    "The new language shows once CBB opens again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظهر اللغة الجديدة عند فتح CBB مرة أخرى."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El idioma nuevo se muestra cuando CBB vuelve a abrirse."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השפה החדשה תוצג כש-CBB ייפתח שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "CBB के फिर से खुलने पर नई भाषा दिखती है।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Новый язык появится после перезапуска CBB."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Lugha mpya inaonekana CBB ikifunguliwa tena."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "CBB 重新打开后会显示新语言。"
          }
        }
      }
    },
    "The project's forwarder": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مُعيد توجيه المشروع"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El reenviador del proyecto"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המעביר של הפרויקט"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रोजेक्ट का फ़ॉरवर्डर"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Форвардер проекта"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kisambazaji cha mradi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "项目的转发器"
          }
        }
      }
    },
    "The recovery key claims a group whose phones are all lost. Join that group first, then claim it in Settings.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يطالب مفتاح الاسترداد بمجموعة فُقدت كل هواتفها. انضم إلى تلك المجموعة أولًا، ثم طالب بها في الإعدادات."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La clave de recuperación reclama un grupo cuyos teléfonos se han perdido todos. Únete antes a ese grupo y luego reclámalo en Ajustes."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מפתח השחזור תובע קבוצה שכל הטלפונים שלה אבדו. הצטרפו קודם לקבוצה הזו, ואז תבעו אותה בהגדרות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिकवरी कुंजी ऐसे समूह पर दावा करती है जिसके सभी फ़ोन खो गए हैं। पहले उस समूह से जुड़ें, फिर सेटिंग्स में उस पर दावा करें।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключ восстановления забирает группу, все телефоны которой потеряны. Сначала войдите в эту группу, затем заберите её в настройках."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ufunguo wa urejeshaji unadai kikundi ambacho simu zake zote zimepotea. Jiunge na kikundi hicho kwanza, kisha ukidai katika Mipangilio."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该恢复密钥声明的群组，其手机已全部丢失。请先加入该群组，然后在“设置”中声明。"
          }
        }
      }
    },
    "The service answered something unexpected.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ردّت الخدمة بشيء غير متوقع."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servicio respondió algo inesperado."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השירות ענה משהו לא צפוי."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सेवा ने कुछ अप्रत्याशित जवाब दिया।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Служба ответила что-то неожиданное."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Huduma ilijibu kitu kisichotarajiwa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务返回了意外的内容。"
          }
        }
      }
    },
    "The service does not answer": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الخدمة لا تُجيب"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servicio no responde"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השירות לא עונה"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सेवा जवाब नहीं देती"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Служба не отвечает"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Huduma haijibu"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务没有响应"
          }
        }
      }
    },
    "The six digits the new device shows": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الأرقام الستة التي يعرضها الجهاز الجديد"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los seis dígitos que muestra el dispositivo nuevo"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שש הספרות שהמכשיר החדש מציג"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नए डिवाइस पर दिखने वाले छह अंक"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Шесть цифр, которые показывает новое устройство"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarakimu sita zinazoonyeshwa na kifaa kipya"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新设备显示的六位数字"
          }
        }
      }
    },
    "The six digits: %@": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الأرقام الستة: %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los seis dígitos: %@"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שש הספרות: %@"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "छह अंक: %@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Шесть цифр: %@"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarakimu sita: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "六位数字：%@"
          }
        }
      }
    },
    "The tiles stay as they were: that change does not fit.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى المربعات كما كانت: ذلك التغيير غير مناسب."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los mosaicos se quedan como estaban: ese cambio no encaja."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "האריחים נשארים כמו שהיו: השינוי הזה לא מתאים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टाइलें जैसी थीं वैसी ही रहती हैं: वह बदलाव फ़िट नहीं होता।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Плитки остались как были: такое изменение не подходит."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Vigae vinabaki kama vilivyokuwa: badiliko hilo halifai."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "磁贴保持原样：该更改不适用。"
          }
        }
      }
    },
    "The tunnel to the base %@ does not get through.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "النفق إلى القاعدة %@ لا يمر."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El túnel a la base %@ no pasa."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המנהרה לבסיס %@ לא עוברת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बेस %@ तक सुरंग नहीं पहुँच रही।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Туннель к базе %@ не проходит."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Handaki kwenda kituo %@ halipiti."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通往主站 %@ 的隧道无法连通。"
          }
        }
      }
    },
    "This Mac": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الـ Mac"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este Mac"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ה-Mac הזה"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह Mac"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот Mac"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac hii"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 Mac"
          }
        }
      }
    },
    "This Mac is in no group yet": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الـ Mac ليس في أي مجموعة بعد"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este Mac aún no está en ningún grupo"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ה-Mac הזה עדיין לא בשום קבוצה"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह Mac अभी किसी समूह में नहीं है"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот Mac ещё не в группе"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac hii bado haiko kwenye kikundi chochote"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 Mac 还不在任何群组中"
          }
        }
      }
    },
    "This Mac is no admin of the group: add the device on the phone or on an admin computer.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الـ Mac ليس مشرفًا في المجموعة: أضف الجهاز على الهاتف أو على حاسوب مشرف."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este Mac no es administrador del grupo: añade el dispositivo en el teléfono o en un ordenador administrador."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ה-Mac הזה אינו מנהל בקבוצה: הוסיפו את המכשיר בטלפון או במחשב מנהל."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह Mac समूह का एडमिन नहीं है: डिवाइस को फ़ोन या किसी एडमिन कंप्यूटर पर जोड़ें।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот Mac не админ группы: добавьте устройство на телефоне или на компьютере-админе."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac hii si msimamizi wa kikundi: ongeza kifaa kwenye simu au kwenye kompyuta ya msimamizi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 Mac 不是群组的管理员：请在手机或管理员电脑上添加设备。"
          }
        }
      }
    },
    "This Mac is no admin of the group: the phone or an admin computer adds and removes devices.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الـ Mac ليس مشرفًا في المجموعة: يضيف الهاتف أو حاسوب مشرف الأجهزة ويزيلها."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este Mac no es administrador del grupo: el teléfono o un ordenador administrador añade y quita dispositivos."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ה-Mac הזה אינו מנהל בקבוצה: הטלפון או מחשב מנהל מוסיפים ומסירים מכשירים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह Mac समूह का एडमिन नहीं है: फ़ोन या कोई एडमिन कंप्यूटर डिवाइस जोड़ता और हटाता है।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот Mac не админ группы: устройства добавляет и удаляет телефон или админский компьютер."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac hii si msimamizi wa kikundi: simu au kompyuta ya msimamizi huongeza na kuondoa vifaa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 Mac 不是群组的管理员：由手机或管理员电脑添加和移除设备。"
          }
        }
      }
    },
    "This Mac then reaches the group's hub from the internet through the group's own WireGuard tunnel, the clipboard encrypted end to end. Its keys are files: keep FileVault on, keep the service's folder out of unencrypted backups, and remove the Mac at once if it is lost.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عندها يصل هذا الـ Mac إلى محور المجموعة من الإنترنت عبر نفق WireGuard الخاص بالمجموعة، والحافظة مشفّرة من طرف إلى طرف. مفاتيحه ملفات: أبقِ FileVault مفعّلًا، وأبقِ مجلد الخدمة خارج النسخ الاحتياطية غير المشفّرة، وأزل الـ Mac فورًا إذا فُقد."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Entonces este Mac llega al hub del grupo desde internet por el propio túnel WireGuard del grupo, con el portapapeles cifrado de extremo a extremo. Sus claves son archivos: mantén FileVault activado, deja la carpeta del servicio fuera de las copias de seguridad sin cifrar y quita el Mac enseguida si se pierde."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אז ה-Mac הזה מגיע לרכזת של הקבוצה מהאינטרנט דרך מנהרת ה-WireGuard של הקבוצה עצמה, והלוח מוצפן מקצה לקצה. המפתחות שלו הם קבצים: השאירו את FileVault מופעל, השאירו את תיקיית השירות מחוץ לגיבויים לא מוצפנים, והסירו את ה-Mac מיד אם הוא אובד."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तब यह Mac समूह की अपनी WireGuard टनल के ज़रिए इंटरनेट से समूह के हब तक पहुँचता है, और क्लिपबोर्ड एंड-टू-एंड एन्क्रिप्टेड रहता है। इसकी कुंजियाँ फ़ाइलें हैं: FileVault चालू रखें, सेवा के फ़ोल्डर को बिना एन्क्रिप्शन वाले बैकअप से बाहर रखें, और Mac खो जाने पर उसे तुरंत हटाएँ।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тогда этот Mac связывается с хабом группы через интернет по собственному туннелю WireGuard группы, а буфер обмена шифруется от начала до конца. Его ключи хранятся в файлах: держите FileVault включённым, не кладите папку службы в незашифрованные резервные копии и сразу удалите Mac из группы, если он потерян."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kisha Mac hii hufikia kitovu cha kikundi kutoka intaneti kupitia handaki la WireGuard la kikundi chenyewe, ubao wa kunakili ukiwa umesimbwa mwisho hadi mwisho. Funguo zake ni faili: acha FileVault ikiwa imewashwa, weka folda ya huduma nje ya nakala rudufu zisizosimbwa, na uondoe Mac mara moja ikipotea."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "之后这台 Mac 会通过群组自己的 WireGuard 隧道从互联网连接群组的中心节点，剪贴板端到端加密。它的密钥是文件：请保持 FileVault 开启，不要让服务的文件夹进入未加密的备份，Mac 丢失时立即将其移除。"
          }
        }
      }
    },
    "This Mac was removed from the group": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أُزيل هذا الـ Mac من المجموعة"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este Mac se quitó del grupo"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ה-Mac הזה הוסר מהקבוצה"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह Mac समूह से हटा दिया गया"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот Mac удалён из группы"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac hii imeondolewa kwenye kikundi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 Mac 已从群组中移除"
          }
        }
      }
    },
    "This Mac · admin": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الـ Mac · مشرف"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este Mac · administrador"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ה-Mac הזה · מנהל"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह Mac · एडमिन"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот Mac · админ"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac hii · msimamizi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 Mac · 管理员"
          }
        }
      }
    },
    "This Mac's clipboard": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حافظة هذا الـ Mac"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El portapapeles de este Mac"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הלוח של ה-Mac הזה"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस Mac का क्लिपबोर्ड"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Буфер этого Мака"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ubao wa kunakili wa Mac hii"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 Mac 的剪贴板"
          }
        }
      }
    },
    "This Mac's keys and the group's files here are deleted, and remote paste and the quick actions are turned off; the rest of the settings stay. It can then join this group or another one. The group lists it until an admin removes it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحذف مفاتيح هذا الـ Mac وملفات المجموعة هنا، ويُوقف اللصق عن بُعد والإجراءات السريعة؛ وتبقى بقية الإعدادات. يمكنه بعد ذلك الانضمام إلى هذه المجموعة أو إلى أخرى. تُدرجه المجموعة حتى يزيله مشرف."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se borran las claves de este Mac y los archivos del grupo que hay aquí, y se desactivan el pegado remoto y las acciones rápidas; el resto de los ajustes se mantiene. Después puede unirse a este grupo o a otro. El grupo lo sigue mostrando hasta que un administrador lo quite."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המפתחות של ה-Mac הזה וקבצי הקבוצה כאן נמחקים, והדבקה מרחוק והפעולות המהירות נכבות; שאר ההגדרות נשארות. אז הוא יכול להצטרף לקבוצה הזו או לאחרת. הקבוצה מציגה אותו עד שמנהל יסיר אותו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस Mac की कुंजियाँ और यहाँ की समूह फ़ाइलें मिटा दी जाती हैं, और रिमोट पेस्ट व त्वरित क्रियाएँ बंद कर दी जाती हैं; बाकी सेटिंग्स बनी रहती हैं। फिर यह इस समूह या किसी दूसरे से जुड़ सकता है। जब तक कोई एडमिन इसे न हटाए, समूह इसे सूची में दिखाता है।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключи этого Mac и файлы группы на нём удаляются, удалённая вставка и быстрые действия выключаются, остальные настройки остаются. Потом он может войти в эту группу или в другую. В списке группы он остаётся, пока его не удалит админ."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Funguo za Mac hii na faili za kikundi zilizo hapa zinafutwa, na kubandika kwa mbali na vitendo vya haraka vinazimwa; mipangilio mingine inabaki. Kisha inaweza kujiunga na kikundi hiki au kingine. Kikundi kinaiorodhesha hadi msimamizi aiondoe."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 Mac 的密钥和这里的群组文件会被删除，远程粘贴和快捷操作会被关闭；其余设置保留。之后它可以加入此群组或其他群组。在管理员将它移除之前，群组仍会列出它。"
          }
        }
      }
    },
    "This QR code is not of a device that waits to join.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رمز QR هذا ليس لجهاز ينتظر الانضمام."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este código QR no es de un dispositivo que espera unirse."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קוד ה-QR הזה אינו של מכשיר שממתין להצטרף."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह QR कोड जुड़ने का इंतज़ार कर रहे किसी डिवाइस का नहीं है।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это QR-код не устройства, которое ждёт входа в группу."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Msimbo huu wa QR si wa kifaa kinachosubiri kujiunga."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此二维码不属于等待加入的设备。"
          }
        }
      }
    },
    "This computer has not met its group on this network.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يلتقِ هذا الحاسوب بمجموعته على هذه الشبكة بعد."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este ordenador aún no ha encontrado su grupo en esta red."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המחשב הזה עוד לא פגש את הקבוצה שלו ברשת הזו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह कंप्यूटर इस नेटवर्क पर अभी अपने समूह से नहीं मिला है।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот компьютер ещё не встречал свою группу в этой сети."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kompyuta hii bado haijakutana na kikundi chake kwenye mtandao huu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台电脑尚未在此网络中遇到它的群组。"
          }
        }
      }
    },
    "This device is in no group.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الجهاز ليس في أي مجموعة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo no está en ningún grupo."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המכשיר הזה לא בשום קבוצה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह डिवाइस किसी समूह में नहीं है।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это устройство не в группе."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kifaa hiki hakimo kwenye kikundi chochote."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备不在任何群组中。"
          }
        }
      }
    },
    "This device is muted until %@: its copies do not reach the group.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الجهاز مكتوم حتى %@: لا تصل نُسخه إلى المجموعة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo está silenciado hasta %@: sus copias no llegan al grupo."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המכשיר הזה מושתק עד %@: ההעתקות שלו לא מגיעות לקבוצה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह डिवाइस %@ तक म्यूट है: इसकी कॉपियाँ समूह तक नहीं पहुँचतीं।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это устройство заглушено до %@: его копии не доходят до группы."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kifaa hiki kimenyamazishwa hadi %@: nakala zake hazifiki kwa kikundi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备已静音至 %@：它的复制内容不会到达群组。"
          }
        }
      }
    },
    "This device is muted: its copies do not reach the group.": {
