          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更改转发器"
          }
        }
      }
    },
    "Change the forwarder…": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغيير مُعيد التوجيه…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
