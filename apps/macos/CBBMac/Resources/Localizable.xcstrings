          }
        }
      }
    },
    "Everywhere is on, but the group has no base.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "«في كل مكان» مفعّل، لكن ليس للمجموعة قاعدة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En todas partes está activado, pero el grupo no tiene base."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "״בכל מקום״ מופעל, אבל לקבוצה אין בסיס."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर जगह चालू है, पर समूह में कोई बेस नहीं है।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Везде» включено, но в группе нет базы."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kila mahali kimewashwa, lakini kikundi hakina kituo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“随处”已打开，但群组没有主站。"
          }
        }
      }
    },
    "Everywhere waits while sync is off": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "«في كل مكان» ينتظر ما دامت المزامنة متوقفة"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En todas partes espera mientras la sincronización está desactivada"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "״בכל מקום״ ממתין כל עוד הסנכרון כבוי"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिंक बंद रहने तक हर जगह रुका रहता है"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Везде» ждёт, пока синхронизация выключена"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kila mahali kinasubiri wakati usawazishaji umezimwa"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同步关闭时，“随处”暂停"
          }
        }
      }
    },
    "Fetch": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جلب"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Obtener"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הבאה"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लाएँ"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Получить"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Leta"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "获取"
          }
        }
      }
    },
    "Fetched from the group.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جُلب من المجموعة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Obtenido del grupo."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הובא מהקבוצה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समूह से लाया गया।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Получено из группы."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Imeletwa kutoka kwa kikundi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已从群组获取。"
          }
        }
      }
    },
    "For 15 minutes": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لمدة 15 دقيقة"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Durante 15 minutos"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "למשך 15 דקות"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "15 मिनट के लिए"
          }
        },
        "ru": {
