    "CBB %@ is out.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صدر CBB %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha salido CBB %@."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "CBB %@ יצאה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "CBB %@ जारी हो गया है।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вышла CBB %@."
          }
        },
        "sw": {
