            "state": "translated",
            "value": "Mzizi wa kikundi huamua."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由群组的根设备决定。"
          }
        }
      }
    },
    "The hub's settings are saved.": {
      "localizations": {
