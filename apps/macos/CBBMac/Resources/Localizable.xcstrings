          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "离开群组"
          }
        }
      }
    },
    "Leave the group on this device, then join again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "غادر المجموعة على هذا الجهاز ثم انضم مجددًا."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sal del grupo en este dispositivo y vuelve a unirte."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "צאו מהקבוצה במכשיר הזה והצטרפו שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस डिवाइस पर समूह छोड़ें, फिर दोबारा शामिल हों।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выйдите из группы на этом устройстве и вступите снова."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ondoka kwenye kikundi kwenye kifaa hiki, kisha ujiunge tena."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在此设备上退出群组，然后重新加入。"
          }
        }
      }
    },
    "Leave the group?": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مغادرة المجموعة؟"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Abandonar el grupo?"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לעזוב את הקבוצה?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समूह छोड़ें?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выйти из группы?"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Uondoke kwenye kikundi?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "离开群组？"
          }
        }
      }
    },
    "Left the group. This Mac can join a group again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "غادرت المجموعة. يمكن لهذا الـ Mac الانضمام إلى مجموعة مرة أخرى."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abandonaste el grupo. Este Mac puede volver a unirse a un grupo."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עזבת את הקבוצה. ה-Mac הזה יכול להצטרף שוב לקבוצה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समूह छोड़ दिया। यह Mac फिर से किसी समूह से जुड़ सकता है।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы вышли из группы. Этот Mac может снова войти в группу."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Umeondoka kwenye kikundi. Mac hii inaweza kujiunga na kikundi tena."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已离开群组。这台 Mac 可以再次加入群组。"
          }
        }
      }
    },
    "Let CBB through this computer's firewall.": {
