    "Claim the group with its recovery key": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المطالبة بالمجموعة بمفتاح استردادها"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reclamar el grupo con su clave de recuperación"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תביעת הקבוצה עם מפתח השחזור שלה"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिकवरी कुंजी से समूह पर दावा करें"
          }
        },
        "ru": {
          "stringUnit": {
