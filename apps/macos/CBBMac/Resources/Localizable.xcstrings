    "Allow cbb to run as the administrator; the QR code shows next.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسمح لـcbb بالعمل كمسؤول؛ يظهر رمز QR بعد ذلك."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que cbb se ejecute como administrador; después se muestra el código QR."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התירו ל־cbb לפעול כמנהל המערכת; קוד ה־QR יוצג אחר כך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "cbb को व्यवस्थापक के रूप में चलने दें; उसके बाद QR कोड दिखेगा।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите cbb работать от имени администратора, и следом появится QR-код."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruhusu cbb iendeshwe kama msimamizi wa mfumo; msimbo wa QR utaonekana baadaye."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许 cbb 以管理员身份运行；随后会显示二维码。"
          }
        }
      }
    },
    "Allow cbb to run as the administrator; the code shows next.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسمح لـcbb بالعمل كمسؤول؛ يظهر الرمز بعد ذلك."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que cbb se ejecute como administrador; después se muestra el código."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התירו ל־cbb לפעול כמנהל המערכת; הקוד יוצג אחר כך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "cbb को व्यवस्थापक के रूप में चलने दें; उसके बाद कोड दिखेगा।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите cbb запуск от имени администратора; затем появится код."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruhusu cbb iendeshwe kama msimamizi wa mfumo; msimbo utaonekana baadaye."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许 cbb 以管理员身份运行；随后会显示代码。"
          }
        }
      }
    },
    "Allow cbb to run as the administrator; the invitation opens on the group's hub next.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسمح لـ cbb بالعمل كمسؤول؛ بعدها تُفتح الدعوة على محور المجموعة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que cbb se ejecute como administrador; después la invitación se abre en el hub del grupo."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפשרו ל-cbb לרוץ כמנהל המערכת; לאחר מכן ההזמנה נפתחת ברכזת של הקבוצה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "cbb को व्यवस्थापक के रूप में चलने दें; इसके बाद निमंत्रण समूह के हब पर खुलता है।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите cbb работать от имени администратора; затем приглашение откроется на хабе группы."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruhusu cbb iendeshwe kama msimamizi; kisha mwaliko unafunguliwa kwenye kitovu cha kikundi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请允许 cbb 以管理员身份运行；随后邀请会在群组的中心节点上打开。"
          }
        }
      }
    },
