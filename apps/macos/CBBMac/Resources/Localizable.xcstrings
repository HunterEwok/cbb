          }
        }
      }
    },
    "Change how the hub's tunnel hides?": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغيير طريقة إخفاء نفق المحور؟"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Cambiar cómo se oculta el túnel del hub?"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לשנות את האופן שבו מנהרת הרכזת מוסתרת?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हब की सुरंग के छिपने का तरीका बदलें?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изменить маскировку туннеля хаба?"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kubadilisha jinsi handaki la kitovu linavyojificha?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更改中心节点隧道的隐藏方式？"
          }
        }
      }
    },
    "Change the forwarder": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغيير مُعيد التوجيه"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambiar el reenviador"
          }
        },
        "he": {
