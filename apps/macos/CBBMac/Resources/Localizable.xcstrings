    "The backup server does not answer.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الخادم الاحتياطي لا يستجيب."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor de respaldo no responde."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שרת הגיבוי לא עונה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बैकअप सर्वर जवाब नहीं दे रहा।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запасной сервер не отвечает."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Seva mbadala haijibu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "备用服务器没有响应。"
          }
        }
      }
    },
    "The base %@ does not answer.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "القاعدة %@ لا تستجيب."
          }
        },
        "es": {
          "stringUnit": {
