    "CBB is updated.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم تحديث CBB."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "CBB está actualizado."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "CBB עודכנה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "CBB अपडेट हो गया है।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "CBB обновлена."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "CBB imesasishwa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "CBB 已更新。"
          }
        }
      }
    },
    "CBB lives in the menu bar; its window opens from there.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعيش CBB في شريط القوائم؛ وتُفتح نافذته من هناك."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "CBB vive en la barra de menús; su ventana se abre desde allí."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "CBB נמצאת בשורת התפריטים; החלון שלה נפתח משם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "CBB मेनू बार में रहता है; इसकी विंडो वहीं से खुलती है।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "CBB живёт в строке меню; его окно открывается оттуда."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "CBB hukaa kwenye upau wa menyu; dirisha lake hufunguka kutoka hapo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "CBB 位于菜单栏中；它的窗口从那里打开。"
          }
        }
      }
    },
