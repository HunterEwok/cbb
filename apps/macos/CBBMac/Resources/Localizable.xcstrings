          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ॉरवर्डर बदलें"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сменить форвардер"
          }
        },
        "sw": {
