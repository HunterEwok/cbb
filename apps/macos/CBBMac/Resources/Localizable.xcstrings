    "The app could not make the file for cbb.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر على التطبيق إنشاء الملف لـ cbb."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app no pudo crear el archivo para cbb."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "היישום לא הצליח ליצור את הקובץ עבור cbb."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐप cbb के लिए फ़ाइल नहीं बना सका।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложению не удалось создать файл для cbb."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Programu haikuweza kutengeneza faili la cbb."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用无法为 cbb 创建文件。"
          }
        }
      }
    },
    "The app could not make the file for the QR code.": {
