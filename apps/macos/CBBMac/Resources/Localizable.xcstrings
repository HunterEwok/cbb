    "The claim is made: it takes effect after the group's takeover delay.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قُدّمت المطالبة: تسري بعد مهلة تولّي المجموعة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La reclamación está hecha: surte efecto tras el plazo de toma del grupo."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התביעה הוגשה: היא נכנסת לתוקף אחרי עיכוב ההשתלטות של הקבוצה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दावा कर दिया गया: समूह की टेकओवर देरी के बाद यह लागू होता है।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заявка подана: она вступит в силу после задержки передачи группы."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Dai limewasilishwa: litaanza kutumika baada ya muda wa kuchukua kikundi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "声明已提交：将在群组的接管延迟后生效。"
          }
        }
      }
    },
    "The clipboard holds no text.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تحتوي الحافظة على نص."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El portapapeles no contiene texto."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין טקסט בלוח."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्लिपबोर्ड में कोई टेक्स्ट नहीं है।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В буфере обмена нет текста."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ubao wa kunakili hauna maandishi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "剪贴板中没有文本。"
          }
        }
      }
    },
    "The code is valid for %lld more min.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الرمز صالح لمدة %lld دقيقة أخرى."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El código es válido %lld min más."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקוד בתוקף עוד %lld דק׳."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोड %lld मिनट और मान्य है।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Код действует ещё %lld мин."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Msimbo ni halali kwa dakika %lld zaidi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "代码还剩 %lld 分钟有效。"
          }
        }
      }
    },
    "The connection server does not take this base.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خادم الاتصال لا يقبل هذه القاعدة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor de conexión no acepta esta base."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שרת החיבור לא מקבל את הבסיס הזה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कनेक्शन सर्वर इस बेस को स्वीकार नहीं कर रहा।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер связи не принимает эту базу."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Seva ya muunganisho haikubali kituo hiki."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接服务器未接受此主站。"
          }
        }
      }
    },
    "The device joined the group; it appears in the list once it connects.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انضم الجهاز إلى المجموعة؛ يظهر في القائمة حين يتصل."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El dispositivo se unió al grupo; aparece en la lista cuando se conecta."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המכשיר הצטרף לקבוצה; הוא יופיע ברשימה כשיתחבר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डिवाइस समूह में जुड़ गया; जुड़ने पर यह सूची में दिखेगा।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Устройство вступило в группу; оно появится в списке, когда подключится."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kifaa kimejiunga na kikundi; kitaonekana kwenye orodha kikiunganishwa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备已加入群组；连接后会出现在列表中。"
          }
        }
      }
    },
    "The group has no other hub: your devices away from home stop syncing until a device is a hub again. To keep them syncing, make another computer a hub first.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ليس للمجموعة محور آخر: تتوقف أجهزتك البعيدة عن المنزل عن المزامنة حتى يصبح جهاز ما محورًا مرة أخرى. لإبقائها متزامنة، اجعل حاسوبًا آخر محورًا أولًا."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El grupo no tiene otro hub: tus dispositivos fuera de casa dejan de sincronizar hasta que un dispositivo vuelva a ser hub. Para que sigan sincronizando, convierte antes otro ordenador en hub."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לקבוצה אין רכזת אחרת: המכשירים שלכם מחוץ לבית מפסיקים לסנכרן עד שמכשיר יהפוך שוב לרכזת. כדי שימשיכו לסנכרן, הפכו קודם מחשב אחר לרכזת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समूह में कोई दूसरा हब नहीं है: घर से दूर आपके डिवाइस तब तक सिंक करना बंद कर देते हैं जब तक कोई डिवाइस फिर से हब न बने। उन्हें सिंक करते रहने के लिए, पहले किसी दूसरे कंप्यूटर को हब बनाएँ।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Другого хаба в группе нет: вне дома ваши устройства перестанут синхронизироваться, пока какое-нибудь устройство снова не станет хабом. Чтобы они не теряли связь, сначала сделайте хабом другой компьютер."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kikundi hakina kitovu kingine: vifaa vyako vilivyo mbali na nyumbani vinaacha kusawazisha hadi kifaa kiwe kitovu tena. Ili viendelee kusawazisha, fanya kompyuta nyingine kuwa kitovu kwanza."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "群组没有其他中心节点：你离家的设备会停止同步，直到某台设备再次成为中心节点。要让它们继续同步，请先让另一台电脑成为中心节点。"
          }
        }
      }
    },
    "The group has no text yet.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد نص في المجموعة بعد."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El grupo aún no tiene texto."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לקבוצה עדיין אין טקסט."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समूह में अभी कोई टेक्स्ट नहीं है।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В группе пока нет текста."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kikundi bado hakina maandishi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "群组中还没有文本。"
          }
        }
      }
    },
    "The group has records of a newer version.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لدى المجموعة سجلات من إصدار أحدث."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El grupo tiene registros de una versión más nueva."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בקבוצה יש רשומות של גרסה חדשה יותר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समूह में नए संस्करण के रिकॉर्ड हैं।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В группе есть записи новой версии."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kikundi kina rekodi za toleo jipya zaidi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "群组中有较新版本的记录。"
          }
        }
      }
    },
    "The group holds %lld records of a later version: update CBB to read them.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحتوي المجموعة على %lld من السجلات من إصدار أحدث: حدّث CBB لقراءتها."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El grupo tiene %lld registros de una versión posterior: actualiza CBB para leerlos."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקבוצה מחזיקה %lld רשומות מגרסה מאוחרת יותר: עדכנו את CBB כדי לקרוא אותן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समूह में बाद के संस्करण के %lld रिकॉर्ड हैं: उन्हें पढ़ने के लिए CBB अपडेट करें।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В группе есть записи более новой версии (%lld): обновите CBB, чтобы их прочитать."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kikundi kina rekodi %lld za toleo la baadaye: sasisha CBB ili kuzisoma."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "群组包含 %lld 条更高版本的记录：请更新 CBB 以读取它们。"
          }
        }
      }
    },
    "The group is made: this Mac is its root. Add a device with the + button.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أُنشئت المجموعة: هذا الـ Mac جذرها. أضف جهازًا بالزر +."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El grupo está creado: este Mac es su raíz. Añade un dispositivo con el botón +."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקבוצה נוצרה: ה-Mac הזה הוא השורש שלה. הוסיפו מכשיר עם הכפתור +."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समूह बन गया: यह Mac उसका रूट है। + बटन से कोई डिवाइस जोड़ें।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Группа создана: этот Mac — её корень. Добавьте устройство кнопкой +."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kikundi kimeundwa: Mac hii ndiyo mzizi wake. Ongeza kifaa kwa kitufe cha +."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "群组已创建：这台 Mac 是它的根设备。用 + 按钮添加设备。"
          }
        }
      }
    },
    "The group is stopped: its devices exchange only their records, no clipboard, until the group's root decides.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المجموعة متوقفة: تتبادل أجهزتها سجلاتها فقط، دون حافظة، حتى يقرر جذر المجموعة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El grupo está detenido: sus dispositivos solo intercambian sus registros, sin portapapeles, hasta que la raíz del grupo decida."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקבוצה עצורה: המכשירים שלה מחליפים רק את הרשומות שלהם, בלי לוח, עד שהשורש של הקבוצה יחליט."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समूह रुका हुआ है: जब तक समूह का रूट निर्णय न ले, उसके डिवाइस केवल अपने रिकॉर्ड का आदान-प्रदान करते हैं, क्लिपबोर्ड का नहीं।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Группа остановлена: устройства обмениваются только записями, без буфера обмена, пока корень группы не решит."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kikundi kimesimamishwa: vifaa vyake vinabadilishana rekodi zao tu, bila ubao wa kunakili, hadi mzizi wa kikundi uamue."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "群组已停止：在群组根设备做出决定之前，其设备只交换记录，不交换剪贴板。"
          }
        }
      }
    },
    "The group sends no secrets until its owner decides.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا ترسل المجموعة أي أسرار حتى يقرر مالكها."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El grupo no envía secretos hasta que su propietario decida."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקבוצה לא שולחת סודות עד שהבעלים שלה יחליטו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब तक स्वामी निर्णय न ले, समूह कोई रहस्य नहीं भेजता।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Группа не пересылает секреты, пока её владелец не решит."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kikundi hakitumi siri zozote hadi mmiliki wake aamue."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在所有者做出决定之前，群组不会发送任何秘密。"
          }
        }
      }
    },
    "The group's hub": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "محور المجموعة"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El hub del grupo"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הרכזת של הקבוצה"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समूह का हब"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хаб группы"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kitovu cha kikundi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "群组的中心节点"
          }
        }
      }
    },
    "The group's hub, in use now": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "محور المجموعة، قيد الاستخدام الآن"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El hub del grupo, en uso ahora"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הרכזת של הקבוצה, בשימוש כעת"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समूह का हब, अभी उपयोग में"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хаб группы, используется сейчас"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kitovu cha kikundi, kinatumika sasa"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "群组的中心节点，正在使用"
          }
        }
      }
    },
    "The group's owner decides on its alerts.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقرر مالك المجموعة ذلك في تنبيهاته."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El propietario del grupo decide en sus avisos."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הבעלים של הקבוצה מחליטים בהתראות שלהם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समूह का स्वामी अपनी चेतावनियों में फ़ैसला करता है।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Владелец группы решает это в своих предупреждениях."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Mmiliki wa kikundi huamua kwenye arifa zake."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由群组的所有者在其提醒中决定。"
          }
        }
      }
    },
    "The group's records stop the exchange.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجلات المجموعة أوقفت التبادل."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los registros del grupo detienen el intercambio."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הרשומות של הקבוצה עצרו את ההחלפה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समूह के रिकॉर्ड ने आदान-प्रदान रोक दिया है।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Записи группы остановили обмен."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekodi za kikundi zimesimamisha ubadilishanaji."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "群组的记录已停止交换。"
          }
        }
      }
    },
    "The group's root decides.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقرر جذر المجموعة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Decide la raíz del grupo."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השורש של הקבוצה מחליט."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समूह का रूट निर्णय लेता है।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Решает корень группы."
          }
        },
        "sw": {
