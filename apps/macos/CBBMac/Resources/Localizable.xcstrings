    "The CBB service is not running on this Mac. Install it, or start it with sudo launchctl kickstart system/tools.cbb.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خدمة CBB لا تعمل على هذا الـ Mac. ثبّتها، أو شغّلها باستخدام sudo launchctl kickstart system/tools.cbb."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servicio CBB no se está ejecutando en este Mac. Instálalo, o inícialo con sudo launchctl kickstart system/tools.cbb."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שירות CBB לא פועל ב-Mac הזה. התקינו אותו, או הפעילו אותו עם sudo launchctl kickstart system/tools.cbb."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "CBB सेवा इस Mac पर नहीं चल रही। इसे इंस्टॉल करें, या sudo launchctl kickstart system/tools.cbb से शुरू करें।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Служба CBB не запущена на этом Mac. Установите её или запустите командой sudo launchctl kickstart system/tools.cbb."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Huduma ya CBB haifanyi kazi kwenye Mac hii. Isakinishe, au iwashe kwa sudo launchctl kickstart system/tools.cbb."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "CBB 服务未在这台 Mac 上运行。请安装它，或用 sudo launchctl kickstart system/tools.cbb 启动它。"
          }
        }
      }
    },
    "The QR code's text": {
      "localizations": {
