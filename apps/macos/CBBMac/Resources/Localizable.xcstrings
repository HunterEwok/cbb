{
  "sourceLanguage": "en",
  "strings": {
    "%@ (%@) used the invitation. Admit it only if the device shows the same fingerprint:": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم %1$@ (%2$@) الدعوة. اقبله فقط إن عرض الجهاز البصمة نفسها:"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ (%2$@) usó la invitación. Admítelo solo si el dispositivo muestra la misma huella:"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ (%2$@) השתמש בהזמנה. אשרו רק אם המכשיר מציג את אותה טביעת אצבע:"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ (%2$@) ने निमंत्रण का उपयोग किया। केवल तभी शामिल करें जब डिवाइस वही फ़िंगरप्रिंट दिखाए:"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ (%2$@) воспользовался приглашением. Впускайте, только если устройство показывает тот же отпечаток:"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ (%2$@) ametumia mwaliko. Kikubali tu ikiwa kifaa kinaonyesha alama ileile:"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@（%2$@）使用了邀请。仅当该设备显示相同的指纹时才接纳："
          }
        }
      }
    },
    "%@ claims the group, and the group is stopped until its root decides.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يطالب %@ بالمجموعة، والمجموعة متوقفة حتى يقرر جذرها."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ reclama el grupo, y el grupo está detenido hasta que su raíz decida."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ תובע את הקבוצה, והקבוצה עצורה עד שהשורש שלה יחליט."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ समूह पर दावा करता है, और जब तक रूट निर्णय न ले, समूह रुका हुआ है।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ хочет забрать группу, и группа остановлена, пока корень не решит."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kinadai kikundi, na kikundi kimesimamishwa hadi mzizi wake uamue."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 声明接管群组，群组已停止，直到其根设备做出决定。"
          }
        }
      }
    },
    "%@ claims the group, to take it over from its root, unless the root removes %@.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يطالب %@ بالمجموعة، لتولّيها من جذرها، ما لم يزل الجذر %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ reclama el grupo para tomarlo de su raíz, salvo que la raíz quite a %@."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ תובע את הקבוצה, כדי להשתלט עליה מהשורש שלה, אלא אם השורש מסיר את %@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ समूह पर दावा करता है, ताकि उसे रूट से अपने हाथ में ले, जब तक रूट %@ को न हटा दे।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ хочет забрать группу у корня, если корень не удалит %2$@."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kinadai kikundi, ili kukichukua kutoka kwa mzizi wake, isipokuwa mzizi uondoe %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 声明接管群组，以从根设备手中接管，除非根设备移除 %@。"
          }
        }
      }
    },
    "%@ claims the group, to take it over from its root: it takes effect in %@, unless the root removes %@.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يطالب %@ بالمجموعة، لتولّيها من جذرها: تسري خلال %@، ما لم يزل الجذر %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ reclama el grupo para tomarlo de su raíz: surte efecto en %@, salvo que la raíz quite a %@."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ תובע את הקבוצה, כדי להשתלט עליה מהשורש שלה: זה ייכנס לתוקף בעוד %@, אלא אם השורש מסיר את %@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ समूह पर दावा करता है, ताकि उसे रूट से अपने हाथ में ले: यह %@ में लागू होगा, जब तक रूट %@ को न हटा दे।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ хочет забрать группу у корня: это произойдёт через %2$@, если корень не удалит %3$@."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kinadai kikundi, ili kukichukua kutoka kwa mzizi wake: kitaanza kutumika baada ya %@, isipokuwa mzizi uondoe %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 声明接管群组，以从根设备手中接管：将在 %@ 后生效，除非根设备移除 %@。"
          }
        }
      }
    },
    "%@ signed two histories with one key, as a stolen key or a restore from a backup would.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وقّع %@ سجلين بمفتاح واحد، كما يحدث مع مفتاح مسروق أو استعادة من نسخة احتياطية."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ firmó dos historiales con una misma clave, como haría una clave robada o una restauración desde una copia de seguridad."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ חתם על שתי היסטוריות עם מפתח אחד, כמו שמפתח גנוב או שחזור מגיבוי היו עושים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ने एक ही कुंजी से दो इतिहास हस्ताक्षरित किए, जैसा कोई चोरी हुई कुंजी या बैकअप से बहाली करती है।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: две истории, подписанные одним ключом. Так бывает при краже ключа или после восстановления из резервной копии."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kilitia sahihi historia mbili kwa ufunguo mmoja, kama ufunguo ulioibiwa au urejeshaji kutoka nakala rudufu ungefanya."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 用同一个密钥签署了两份历史，就像被盗密钥或从备份恢复时那样。"
          }
        }
      }
    },
    "%@ took the group over from this device.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استولى %@ على المجموعة من هذا الجهاز."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tomó el grupo de este dispositivo."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ לקח את הקבוצה מהמכשיר הזה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ने इस डिवाइस से समूह ले लिया।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ забрал группу у этого устройства."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kilichukua kikundi kutoka kifaa hiki."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已从此设备接管群组。"
          }
        }
      }
    },
    "%lld of %lld online": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld من %lld متصل"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld de %lld en línea"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld מתוך %lld מחוברים"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$lld में से %1$lld ऑनलाइन"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В сети: %1$lld из %2$lld"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld kati ya %lld mtandaoni"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$lld 台中 %1$lld 台在线"
          }
        }
      }
    },
    "A hub needs sync away from home, which is off on this Mac, so this turns it on first. Your devices then reach the group through this Mac when they are away from home, through the project's forwarder at cbb.tools.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتاج المحور إلى المزامنة خارج المنزل، وهي متوقفة على هذا الـMac، لذا تُشغَّل أولًا. بعدها تصل أجهزتك إلى المجموعة عبر هذا الـMac وهي خارج المنزل، من خلال مُعيد توجيه المشروع في cbb.tools."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un hub necesita la sincronización fuera de casa, que está desactivada en este Mac, así que primero la activa. Tus dispositivos llegan entonces al grupo a través de este Mac cuando están fuera de casa, por el reenviador del proyecto en cbb.tools."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "רכזת צריכה סנכרון מחוץ לבית, שכבוי ב־Mac הזה, ולכן הוא יופעל קודם. המכשירים שלכם יגיעו אז לקבוצה דרך ה־Mac הזה כשהם מחוץ לבית, דרך המעביר של הפרויקט ב־cbb.tools."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हब को घर से बाहर सिंक चाहिए, जो इस Mac पर बंद है, इसलिए पहले उसे चालू किया जाता है। इसके बाद घर से बाहर होने पर आपके डिवाइस इस Mac से होकर, cbb.tools पर प्रोजेक्ट के फ़ॉरवर्डर के ज़रिए समूह तक पहुँचते हैं।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хабу нужна синхронизация вне дома, а на этом Mac она выключена, поэтому сначала она включится. Вне дома ваши устройства будут связываться с группой через этот Mac, через форвардер проекта на cbb.tools."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kitovu kinahitaji usawazishaji ukiwa mbali na nyumbani, ambao umezimwa kwenye Mac hii, kwa hiyo unawashwa kwanza. Kisha vifaa vyako hufikia kikundi kupitia Mac hii vikiwa mbali na nyumbani, kupitia kisambazaji cha mradi kwenye cbb.tools."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "中心节点需要离家同步，而这台 Mac 上它是关闭的，所以会先把它打开。之后你的设备离家时会经由这台 Mac、通过项目在 cbb.tools 的转发器连到群组。"
          }
        }
      }
    },
    "A hub that only passes them on": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "محور يمرّرها فقط"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un hub que solo las reenvía"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "רכזת שרק מעבירה אותן"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल आगे भेजने वाला हब"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хаб, который только пересылает"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kitovu kinachozipitisha tu"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只转发副本的中心节点"
          }
        }
      }
    },
    "A hub that reads the copies": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "محور يقرأ النسخ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un hub que lee las copias"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "רכזת שקוראת את ההעתקות"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कॉपी पढ़ने वाला हब"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хаб, который читает копии"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kitovu kinachosoma nakala"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读取副本的中心节点"
          }
        }
      }
    },
    "A hub that reads the copies is an admin. A hub that only passes them on cannot read them: they are sealed to your other devices only, so its keys need no hardware.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المحور الذي يقرأ النسخ مشرف. والمحور الذي يمرّرها فقط لا يستطيع قراءتها: فهي مختومة لأجهزتك الأخرى وحدها، لذا لا تحتاج مفاتيحه إلى عتاد."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un hub que lee las copias es administrador. Un hub que solo las reenvía no puede leerlas: van selladas solo para tus otros dispositivos, así que sus claves no necesitan hardware."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "רכזת שקוראת את ההעתקות היא מנהל. רכזת שרק מעבירה אותן לא יכולה לקרוא אותן: הן חתומות רק למכשירים האחרים שלכם, ולכן המפתחות שלה לא צריכים חומרה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कॉपी पढ़ने वाला हब एडमिन होता है। केवल आगे भेजने वाला हब उन्हें पढ़ नहीं सकता: वे केवल आपके दूसरे डिवाइसों के लिए सील होती हैं, इसलिए उसकी कुंजियों को हार्डवेयर नहीं चाहिए।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хаб, который читает копии, — это админ. Хаб, который только пересылает, прочитать их не может: они запечатаны только для ваших других устройств, поэтому его ключам не нужно оборудование."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kitovu kinachosoma nakala ni msimamizi. Kitovu kinachozipitisha tu hakiwezi kuzisoma: zimefungwa kwa ajili ya vifaa vyako vingine tu, kwa hiyo funguo zake hazihitaji maunzi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读取副本的中心节点是管理员。只转发副本的中心节点无法读取它们：副本只为你的其他设备密封，所以它的密钥不需要硬件。"
          }
        }
      }
    },
    "A phone is a hub only from its own app's Settings, while the app is open.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يكون الهاتف محورًا إلا من إعدادات تطبيقه، والتطبيق مفتوح."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un teléfono solo es hub desde los Ajustes de su propia app, mientras la app está abierta."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "טלפון הוא רכזת רק מההגדרות של האפליקציה שלו, כשהאפליקציה פתוחה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ोन केवल अपने ऐप की सेटिंग्स से हब बनता है, जब तक ऐप खुला है।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Телефон становится хабом только в настройках своего приложения и только пока приложение открыто."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Simu ni kitovu tu kutoka Mipangilio ya programu yake, programu ikiwa imefunguliwa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手机只能在其应用打开时，从应用自己的设置中成为中心节点。"
          }
        }
      }
    },
    "A phone joins from the start screen of its app.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ينضم الهاتف من شاشة البداية في تطبيقه."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un teléfono se une desde la pantalla de inicio de su app."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "טלפון מצטרף ממסך הפתיחה של האפליקציה שלו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ोन अपने ऐप की शुरुआती स्क्रीन से जुड़ता है।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Телефон присоединяется с начального экрана своего приложения."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Simu hujiunga kutoka skrini ya mwanzo ya programu yake."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手机从其应用的开始屏幕加入。"
          }
        }
      }
    },
    "A phone with Aurora OS or Sailfish OS shows a QR code and waits. Paste the code's text, or open a picture of it:": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعرض هاتف بنظام Aurora OS أو Sailfish OS رمز QR وينتظر. الصق نص الرمز، أو افتح صورة له:"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un teléfono con Aurora OS o Sailfish OS muestra un código QR y espera. Pega el texto del código o abre una imagen de él:"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "טלפון עם Aurora OS או Sailfish OS מציג קוד QR וממתין. הדביקו את הטקסט של הקוד, או פתחו תמונה שלו:"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aurora OS या Sailfish OS वाला फ़ोन QR कोड दिखाकर प्रतीक्षा करता है। कोड का टेक्स्ट पेस्ट करें, या उसकी तस्वीर खोलें:"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Телефон с ОС Аврора или Sailfish OS показывает QR-код и ждёт. Вставьте текст кода или откройте его снимок:"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Simu yenye Aurora OS au Sailfish OS huonyesha msimbo wa QR na kusubiri. Bandika maandishi ya msimbo, au fungua picha yake:"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "装有 Aurora OS 或 Sailfish OS 的手机会显示二维码并等待。粘贴二维码的文本，或打开它的图片："
          }
        }
      }
    },
    "A watch is never a hub.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الساعة لا تكون محورًا أبدًا."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un reloj nunca es un hub."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שעון אף פעם אינו רכזת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "घड़ी कभी हब नहीं होती।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Часы не бывают хабом."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Saa kamwe si kitovu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手表从不担任中心节点。"
          }
        }
      }
    },
