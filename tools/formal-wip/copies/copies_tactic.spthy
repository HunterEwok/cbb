/*
 * CBB 0.6: copies sealed end to end (format-0.6-bytes section 10 and 21,
 * plans/e2e-copies-0.6-ru.md, core/src/copies, core/src/records/statement.rs,
 * core/src/keystore at #530 16b2883).
 *
 * What is modelled
 *   - One group with a root key and one admin key; both sign the records
 *     that admit a device (with rights 'rw' = read and send, or 'fwd' = a
 *     forward-only hub without read) and that remove one. Every member
 *     takes a record signed by either key.
 *   - A device: a member key m (its device ID is pk(m)) and sealing epochs:
 *     each epoch a fresh X-Wing secret e, published in a keys statement
 *     signed by m alone (rule 4: no root or admin signs it). An epoch is
 *     held until erased (Erase), then gone for good.
 *   - A member's view of the records, per device it counts: Counts(M, D, r).
 *     A removal consumes it. A view takes one admission per device and
 *     never one after that device's removal (restrictions).
 *   - A copy: the origin picks K, header hdr = <id, origin, time, readers
 *     with epochs, commit(K)>, h = H('cbb copy v2', hdr), payload =
 *     AEAD(H('payload', K, h), content), each wrap = HPKE(K, h) to the
 *     reader's statement key of that epoch, sig = ES256 over
 *     <h, H(H(w1), H(w2)), H(payload)> by the origin's member key.
 *     Readers are devices the origin's view counts with 'rw' and a statement
 *     it saw; here a copy has two readers (wraps are independent, so one
 *     reader's case is every reader's case), a resealed copy has one.
 *   - A reader checks: the origin counted in its own view with send, the
 *     signature, its wrap opens with its epoch secret and binds h, commit
 *     against K, the payload under h, and the signed time after the newest
 *     it wrote from that origin (A-61; `fresh.rs`).
 *   - Sealing again (`reseal`): the origin seals a kept copy to an asker
 *     that was one of its readers and that its view still counts, at a
 *     statement it saw; same id and time, new K.
 *
 * Abstractions (what is left out)
 *   - HPKE (X-Wing), ChaCha20-Poly1305 and ES256 are ideal: aenc, senc,
 *     sign. A symbolic senc is key-committing; the real AEAD is not, which
 *     is why `commit` exists. The lemma consistent_content is therefore
 *     about the model's AEAD; the real binding rests on `commit`.
 *   - A sender may seal to any statement of a device that it saw, not only
 *     the newest (a network that holds back the newest statement can make
 *     a sender use an older one; the code bounds this by 35 days,
 *     STATEMENT_MAX_AGE_MS). This gives the attacker more, not less.
 *   - Rules of incoming copies other than A-61 (lifetime, clock allowance,
 *     secrets' seen list, too-old rules, halted groups), content types,
 *     reduced copies for a leaf, blobs, age_ms: out of scope (tests).
 *   - The records' evaluation (rule order, checkpoints, takeovers) is
 *     abstracted to "a record signed by root or admin counts at once".
 *   - One group. Assumption: a device's member and sealing keys belong to
 *     one group (the header carries no group ID).
 *
 * Attacker: Dolev-Yao network = the relay, the hub's link and the
 * forwarder; any device's member key (RevealMember) and any epoch secret
 * still held (RevealEpoch), at any time, so a removed device with all it
 * ever held is a device whose keys were revealed; the root key and the
 * admin key (RevealRoot, RevealAdmin).
 */

theory CBB_Copies_v2
begin

builtins: hashing, signing, asymmetric-encryption, symmetric-encryption, natural-numbers

restriction Equality: "All x y #i. Eq(x, y) @ #i ==> x = y"
restriction Inequality: "All x #i. Neq(x, x) @ #i ==> F"
restriction OnlyOnce: "All x #i #j. Once(x) @ #i & Once(x) @ #j ==> #i = #j"
// A view takes one admission per device, and none after its removal.
restriction AdmitOnce:
  "All M D #i #j. LearnAdmit(M, D) @ #i & LearnAdmit(M, D) @ #j ==> #i = #j"
restriction NoAdmitAfterRemoval:
  "All M D #i #j. RemovedAt(M, D) @ #i & LearnAdmit(M, D) @ #j ==> #j < #i"
// Removal ends a view's use of a device; erasure ends an epoch's use.
restriction UseBeforeRemoval:
  "All M D #i #j. Uses(M, D) @ #i & RemovedAt(M, D) @ #j ==> #i < #j"
restriction UseBeforeErase:
  "All D n #i #j. UsesEpoch(D, n) @ #i & Erased(D, n) @ #j ==> #i < #j"
restriction EraseOnce:
  "All D n #i #j. Erased(D, n) @ #i & Erased(D, n) @ #j ==> #i = #j"
restriction RemoveOnce:
  "All M D #i #j. RemovedAt(M, D) @ #i & RemovedAt(M, D) @ #j ==> #i = #j"
// A-61: a reader writes a copy of an origin only when its signed time is
// after the newest it wrote from that origin.
restriction NewestWritten:
  "All R O id id2 t t2 m m2 #i #j. Accept(R, O, id, t, m) @ #i & Accept(R, O, id2, t2, m2) @ #j & #i < #j
     ==> t << t2"
// The origin's clock: each copy it seals is signed later than the last.
restriction OriginClock:
  "All O id id2 t t2 m m2 #i #j. Sealed(O, id, t, m) @ #i & Sealed(O, id2, t2, m2) @ #j & #i < #j
     ==> t << t2"
restriction Either:
  "All a x y #i. OneOf(a, x, y) @ #i ==> a = x | a = y"

/* ---------------- The group ---------------- */

rule Group:
    [ Fr(~rk), Fr(~ad) ]
  --[ Once('group') ]->
    [ !Root(~rk), !Admin(~ad), !Auth(pk(~rk)), !Auth(pk(~ad)), Out(pk(~rk)), Out(pk(~ad)) ]

rule Reveal_Root:  [ !Root(rk) ]  --[ RevealRoot() ]->  [ Out(rk) ]
rule Reveal_Admin: [ !Admin(ad) ] --[ RevealAdmin() ]-> [ Out(ad) ]

/* ---------------- Devices ---------------- */

// A device admitted by the root (an admin's admission is the same record
// under the admin key). Its clock starts at 1.
rule Device_RW:
  let rec = <'admit', pk(~m), 'rw'>
  in
    [ Fr(~m), !Root(rk) ]
  --[ HonestDev(pk(~m)), HonestRights(pk(~m), 'rw') ]->
    [ !Dev(~m, 'rw'), Out(pk(~m)), Out(<rec, sign(rec, rk)>) ]

// A forward-only hub: an ordinary member without read (no wraps for it).
rule Device_Fwd:
  let rec = <'admit', pk(~m), 'fwd'>
  in
    [ Fr(~m), !Root(rk) ]
  --[ HonestDev(pk(~m)), HonestRights(pk(~m), 'fwd') ]->
    [ !Dev(~m, 'fwd'), Out(pk(~m)), Out(<rec, sign(rec, rk)>) ]

rule Reveal_Member:
    [ !Dev(~m, r) ] --[ RevealMember(pk(~m)) ]-> [ Out(~m) ]

// A new epoch: a fresh sealing secret and its statement signed by the
// member key alone.
rule New_Epoch:
  let st = <'keys', pk(~m), ~n, pk(~e)>
  in
    [ !Dev(~m, r), Fr(~n), Fr(~e) ]
  --[ HonestEpoch(pk(~m), ~n, pk(~e)) ]->
    [ !Epoch(pk(~m), ~n, ~e), Out(<st, sign(st, ~m)>) ]

rule Erase_Epoch:
    [ !Epoch(D, n, e) ] --[ Erased(D, n) ]-> [ ]

rule Reveal_Epoch:
    [ !Epoch(D, n, e) ] --[ RevealEpoch(D, n), UsesEpoch(D, n) ]-> [ Out(e) ]

/* ---------------- A member's view of the records ---------------- */

// Every honest device keeps a view; the newest copy written from a device
// starts below 1.
rule Learn_Admit:
  let rec = <'admit', D, r>
  in
    [ !Dev(~mM, rM), !Auth(pk(ska)), In(<rec, sign(rec, ska)>) ]
  --[ LearnAdmit(pk(~mM), D), Rights(pk(~mM), D, r) ]->
    [ !Counts(pk(~mM), D, r) ]

rule Learn_Remove:
  let rec = <'remove', D>
  in
    [ !Counts(M, D, r), !Auth(pk(ska)), In(<rec, sign(rec, ska)>) ]
  --[ RemovedAt(M, D) ]->
    [ ]

// The root removes a device.
rule Remove:
  let rec = <'remove', pk(~m)>
  in
    [ !Root(rk), !Dev(~m, r) ]
  --[ Removing(pk(~m)) ]->
    [ Out(<rec, sign(rec, rk)>) ]

// A statement counts in a view for a device the view counts, when it
// verifies with that device's member key.
rule Learn_Statement:
  let st = <'keys', pk(mD), n, pke>
  in
    [ !Counts(M, pk(mD), r), In(<st, sign(st, mD)>) ]
  --[ Uses(M, pk(mD)) ]->
    [ !SealView(M, pk(mD), n, pke) ]

/* ---------------- Sealing a copy ---------------- */

rule Seal:
  let O = pk(~mO)
      hdr = <~id, O, t:nat, D1, n1, D2, n2, h(<'commit', ~k>)>
      hh = h(<'cbb copy v2', hdr>)
      pay = senc(~msg, h(<'payload', ~k, hh>))
      w1 = aenc(<~k, hh>, pk1)
      w2 = aenc(<~k, hh>, pk2)
      sg = sign(<'copysig', hh, h(<h(w1), h(w2)>), h(pay)>, ~mO)
  in
    [ !Dev(~mO, 'rw'), In(t:nat),
      !Counts(O, D1, 'rw'), !Counts(O, D2, 'rw'),
      !SealView(O, D1, n1, pk1), !SealView(O, D2, n2, pk2),
      Fr(~id), Fr(~k), Fr(~msg) ]
  --[ Neq(D1, D2), Uses(O, D1), Uses(O, D2), CopyKey(~id, ~k), Sealed(O, ~id, t:nat, ~msg), SealedTo(O, ~id, D1), SealedTo(O, ~id, D2),
      ReaderOf(~id, D1, n1, pk1), ReaderOf(~id, D2, n2, pk2) ]->
    [       !Kept(O, ~mO, ~id, t:nat, ~msg, D1, D2),
      Out(<'copy2', hdr, w1, w2, pay, sg>) ]

// Sealing again for an asker that was a reader and is still counted, at a
// statement the origin saw; same id and time, a new K, one reader.
rule Reseal:
  let hdr = <id, O, t, A, n, h(<'commit', ~k>)>
      hh = h(<'cbb copy v2', hdr>)
      pay = senc(msg, h(<'payload', ~k, hh>))
      w = aenc(<~k, hh>, pkA)
      sg = sign(<'copysig', hh, h(w), h(pay)>, mO)
  in
    [ !Kept(O, mO, id, t, msg, D1, D2), !Counts(O, A, 'rw'), !SealView(O, A, n, pkA),
      In(<'reseal', id, A, n>), Fr(~k) ]
  --[ OneOf(A, D1, D2), Uses(O, A), CopyKey(id, ~k), Resealed(O, id, A), ReaderOf(id, A, n, pkA) ]->
    [ Out(<'copy1', hdr, w, pay, sg>) ]

/* ---------------- Opening a copy ---------------- */

rule Open_First:
  let R = pk(~mR)
      O = pk(mO)
      hdr = <id, O, t, R, n, D2, n2, cm>
      hh = h(<'cbb copy v2', hdr>)
      w1 = aenc(<k, hh>, pk(e))
      pay = senc(msg, h(<'payload', k, hh>))
  in
    [ !Dev(~mR, 'rw'), !Epoch(R, n, e), !Counts(R, O, 'rw'),
      In(<'copy2', hdr, w1, w2, pay, sign(<'copysig', hh, h(<h(w1), h(w2)>), h(pay)>, mO)>) ]
  --[ Eq(cm, h(<'commit', k>)), Uses(R, O), UsesEpoch(R, n),
      Accept(R, O, id, t, msg), AcceptCopy(R, O, hh, h(pay), msg) ]->
    [ ]

rule Open_Second:
  let R = pk(~mR)
      O = pk(mO)
      hdr = <id, O, t, D1, n1, R, n, cm>
      hh = h(<'cbb copy v2', hdr>)
      w2 = aenc(<k, hh>, pk(e))
      pay = senc(msg, h(<'payload', k, hh>))
  in
    [ !Dev(~mR, 'rw'), !Epoch(R, n, e), !Counts(R, O, 'rw'),
      In(<'copy2', hdr, w1, w2, pay, sign(<'copysig', hh, h(<h(w1), h(w2)>), h(pay)>, mO)>) ]
  --[ Eq(cm, h(<'commit', k>)), Uses(R, O), UsesEpoch(R, n),
      Accept(R, O, id, t, msg), AcceptCopy(R, O, hh, h(pay), msg) ]->
    [ ]

rule Open_Resealed:
  let R = pk(~mR)
      O = pk(mO)
      hdr = <id, O, t, R, n, cm>
      hh = h(<'cbb copy v2', hdr>)
      w = aenc(<k, hh>, pk(e))
      pay = senc(msg, h(<'payload', k, hh>))
  in
    [ !Dev(~mR, 'rw'), !Epoch(R, n, e), !Counts(R, O, 'rw'),
      In(<'copy1', hdr, w, pay, sign(<'copysig', hh, h(w), h(pay)>, mO)>) ]
  --[ Eq(cm, h(<'commit', k>)), Uses(R, O), UsesEpoch(R, n),
      Accept(R, O, id, t, msg), AcceptCopy(R, O, hh, h(pay), msg) ]->
    [ ]

// A reader asks for a copy sealed to an epoch it no longer holds.
rule Ask_Reseal:
    [ !Dev(~mR, 'rw'), !Epoch(pk(~mR), n, e) ]
  --[ UsesEpoch(pk(~mR), n) ]->
    [ Out(<'reseal', $id, pk(~mR), n>) ]

tactic: copies
presort: s
prio:
  regex ".*KU\( h\(<'payload'.*"
  regex ".*KU\( ~msg.*"
  regex ".*!Kept\(.*"
deprio:
  regex ".*!Counts\(.*"
  regex ".*!SealView\(.*"
  regex ".*!Epoch\(.*"
  regex ".*!Dev\(.*"
  regex ".*!Auth\(.*"

/* ---------------- Lemmas ---------------- */

// Reachability: a copy sealed and opened by both readers, no key revealed.
lemma exec_both_open:
  exists-trace
  "Ex O id t m R1 R2 #s #a #b. Sealed(O, id, t, m) @ #s & Accept(R1, O, id, t, m) @ #a
     & Accept(R2, O, id, t, m) @ #b & not (R1 = R2)
     & not (Ex D #r. RevealMember(D) @ #r) & not (Ex D n #r. RevealEpoch(D, n) @ #r)
     & not (Ex #r. RevealRoot() @ #r) & not (Ex #r. RevealAdmin() @ #r)"

lemma exec_reseal:
  exists-trace
  "Ex O id t m R #s #a #b. Sealed(O, id, t, m) @ #s & Resealed(O, id, R) @ #a
     & Accept(R, O, id, t, m) @ #b
     & not (Ex D #r. RevealMember(D) @ #r) & not (Ex D n #r. RevealEpoch(D, n) @ #r)"

// Helper: a reader whose statement key is not one an honest device made
// is the attacker's device or a device whose member key was taken.
lemma foreign_reader [reuse]:
  "All id D n pke #i. ReaderOf(id, D, n, pke) @ #i & not (Ex #h. HonestEpoch(D, n, pke) @ #h)
     ==> (Ex #r. RevealMember(D) @ #r & #r < #i)
       | ((not (Ex #h. HonestDev(D) @ #h)) & ((Ex #r. RevealRoot() @ #r & #r < #i) | (Ex #r. RevealAdmin() @ #r & #r < #i)))"

// Helper: a copy key K is known only through a reader of that copy.
lemma key_secret [reuse]:
  "All id k #s #k. CopyKey(id, k) @ #s & K(k) @ #k
     ==> Ex D n pke #r. ReaderOf(id, D, n, pke) @ #r
           & ((Ex #l. RevealEpoch(D, n) @ #l) | not (Ex #h. HonestEpoch(D, n, pke) @ #h))"

// Helper: a copy's content is known only through one of its copy keys
// (the seal's or a reseal's).
lemma content_via_key [reuse, heuristic={copies}]:
  "All O id t m #s #k. Sealed(O, id, t, m) @ #s & KU(m) @ #k
     ==> Ex k2 #c #j. CopyKey(id, k2) @ #c & KU(k2) @ #j & #j < #k"

// Helper: key_secret said with KU, for the content lemmas.
lemma key_secret_ku [reuse, heuristic={copies}]:
  "All id k #s #k. CopyKey(id, k) @ #s & KU(k) @ #k
     ==> Ex D n pke #r. ReaderOf(id, D, n, pke) @ #r
           & ((Ex #l. RevealEpoch(D, n) @ #l) | not (Ex #h. HonestEpoch(D, n, pke) @ #h))"

// 1. Secrecy: a copy's content is known only through one of its readers:
//    that reader's epoch secret was taken while held, or the reader's
//    statement key was not an honest device's.
lemma content_secret [reuse, heuristic={copies}]:
  "All O id t m #s #k. Sealed(O, id, t, m) @ #s & KU(m) @ #k
     ==> Ex D n pke #r. ReaderOf(id, D, n, pke) @ #r
           & ((Ex #l. RevealEpoch(D, n) @ #l) | not (Ex #h. HonestEpoch(D, n, pke) @ #h))"

// 2. The same, said without readers: with no epoch secret and no member key
//    taken, the content stays secret even with the root and admin keys
//    taken, unless one of them admitted the attacker's own device and the
//    origin sealed to it.
lemma root_admin_open_nothing [heuristic={copies}]:
  "All O id t m #s #k. Sealed(O, id, t, m) @ #s & KU(m) @ #k
     & not (Ex D n #l. RevealEpoch(D, n) @ #l) & not (Ex D #l. RevealMember(D) @ #l)
     ==> Ex D n pke #r. ReaderOf(id, D, n, pke) @ #r & not (Ex #h. HonestDev(D) @ #h)
           & ((Ex #l. RevealRoot() @ #l & #l < #r) | (Ex #l. RevealAdmin() @ #l & #l < #r))"

// 3. A device the origin holds removed is never a reader, so it cannot read
//    the copy with everything it ever held; the content is known only
//    through another reader.
lemma removed_not_reader:
  "All O id D #i #j. SealedTo(O, id, D) @ #i & RemovedAt(O, D) @ #j ==> #i < #j"

lemma removed_cannot_read [heuristic={copies}]:
  "All O id t m D #s #j #k. Sealed(O, id, t, m) @ #s & RemovedAt(O, D) @ #j & #j < #s & KU(m) @ #k
     ==> Ex D2 n pke #r. ReaderOf(id, D2, n, pke) @ #r & not (D2 = D)
           & ((Ex #l. RevealEpoch(D2, n) @ #l) | not (Ex #h. HonestEpoch(D2, n, pke) @ #h))"

// 4. A forward-only hub is never a reader (unless the root or admin key
//    signed another admission for it first), so the relay, the hub and
//    the forwarder learn the content only as content_secret allows.
lemma forward_only_not_reader:
  "All id D n pke #i #h. ReaderOf(id, D, n, pke) @ #i & HonestRights(D, 'fwd') @ #h
     ==> (Ex #r. RevealRoot() @ #r) | (Ex #r. RevealAdmin() @ #r)"

// 5. Origin: a reader accepts a copy as the origin's only when the origin
//    sealed it, unless the origin's member key was taken, or the origin is
//    the attacker's device admitted with the root or admin key.
lemma origin:
  "All R O id t m #i. Accept(R, O, id, t, m) @ #i
     ==> (Ex #j. Sealed(O, id, t, m) @ #j & #j < #i)
       | (Ex #r. RevealMember(O) @ #r & #r < #i)
       | ((not (Ex #h. HonestDev(O) @ #h)) & ((Ex #r. RevealRoot() @ #r) | (Ex #r. RevealAdmin() @ #r)))"

// A reader that holds the origin's removal accepts nothing from it.
lemma origin_counted:
  "All R O id t m #i #j. Accept(R, O, id, t, m) @ #i & RemovedAt(R, O) @ #j ==> #i < #j"

// 6. Replay: no reader accepts two copies of one origin at one signed time,
//    so no copy is accepted twice as new, resealed or not.
lemma no_replay:
  "All R O id id2 t m m2 #i #j. Accept(R, O, id, t, m) @ #i & Accept(R, O, id2, t, m2) @ #j ==> #i = #j"

// Two readers of one signed copy get one content (in the model's AEAD).
lemma consistent_content:
  "All R1 R2 O hh sg m1 m2 #i #j. AcceptCopy(R1, O, hh, sg, m1) @ #i & AcceptCopy(R2, O, hh, sg, m2) @ #j
     ==> m1 = m2"

// 7. A newcomer: a device that opens a copy from an honest origin was one
//    of the readers the origin sealed it to at first; a device the origin
//    counted only after it sealed the copy never opens it, resealed or not.
lemma reader_was_sealed_to:
  "All R O id t m #i. Accept(R, O, id, t, m) @ #i
     ==> (Ex #j. SealedTo(O, id, R) @ #j & #j < #i) | (Ex #r. RevealMember(O) @ #r)
       | (not (Ex #h. HonestDev(O) @ #h))"

lemma newcomer_reads_nothing_older:
  "All R O id t m #s #a #i. Sealed(O, id, t, m) @ #s & LearnAdmit(O, R) @ #a & #s < #a
     & Accept(R, O, id, t, m) @ #i
     ==> (Ex #r. RevealMember(O) @ #r)"

// 8. Epochs: an epoch secret, once erased, can never be taken again.
lemma erased_stays_erased:
  "All D n #e #r. Erased(D, n) @ #e & RevealEpoch(D, n) @ #r ==> #r < #e"

// Illustration of the price of a stolen admin key: the attacker's own
// device admitted with it reads later copies (expected to be found).
lemma admin_key_admits_reader:
  exists-trace
  "Ex O id t m #s #k #a. Sealed(O, id, t, m) @ #s & K(m) @ #k & RevealAdmin() @ #a
     & not (Ex D #l. RevealMember(D) @ #l) & not (Ex D n #l. RevealEpoch(D, n) @ #l)
     & not (Ex #l. RevealRoot() @ #l)"

end
